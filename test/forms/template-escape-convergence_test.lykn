(import-macros "testing" (test includes ok))
(import "testing/helpers.js" (compile-both))

;; D-2: both compilers encode the decoded backslash for JavaScript source.
;; Runtime preservation across all six shared fixtures is covered by
;; test/forms/template-string-boundary.test.js.

(test
  "D-2: template backslash content converges across compilers"
  (bind r (compile-both "(template \"\\\\n\")"))
  (includes r "`\\\\n`"))
