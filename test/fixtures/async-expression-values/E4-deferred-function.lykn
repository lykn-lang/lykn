(bind calls (cell 0))

(func
  make-callback
  :args
  ()
  :returns
  :any
  :body
  (do
    (async
      (fn
        ()
        (swap! calls (fn (:number count) (+ count 1)))
        (await (Promise:resolve 0))
        9))))

(bind callback (make-callback))

(bind constructionCalls (express calls))

(bind immediateType (js:typeof callback))

(bind result (await (callback)))

(bind invocationCalls (express calls))

(console:log
  (JSON:stringify
    (obj
      :constructionCalls
      constructionCalls
      :immediateType
      immediateType
      :invocationCalls
      invocationCalls
      :result
      result)))
