;; Independent CDC comparison; argv[0] is the extracted CC confirmation directory.
;; Run in the fresh replay trial. No package imports or normalization of facts.
(bind checks (cell 0))
(func equal :args (:any a :any b :string label) :body
  (swap! checks (fn (:number n) (+ n 1)))
  (if (not (= (JSON:stringify a) (JSON:stringify b))) (throw (new Error label))))
(func rows :args (:string path) :body
  (-> (Deno:read-text-file-sync path) (:trim) (:split "\n") (:map (fn (:string line) (JSON:parse line)))))
(func events :args (:object row) :body
  (-> row:stdout (:trim) (:split "\n") (:map (fn (:string line) (JSON:parse line)))))
(func fact :args (:object row :string label) :body
  (bind matches (-> (events row) (:filter (fn (:array event) (= (get event 0) label)))))
  (equal matches:length 1 (template "unique fact " label))
  (get (get matches 0) 1))
(func entry :args (:object node :string key) :body
  (bind matches (node:entries:filter (fn (:array pair) (= (get (get pair 0) "value") key))))
  (equal matches:length 1 (template "unique key " key))
  (get (get matches 0) 1))
(bind original (rows (template (get Deno:args 0) "/matrix.stdout")))
(bind current (rows "matrix.stdout"))
(equal original:length 518 "CC count")
(equal current:length 518 "CDC count")
(bind counts (obj))
(bind warnings (cell 0))
(for-of pair (current:entries)
  (bind row (get pair 1))
  (bind prior (get original (get pair 0)))
  (for-of field #a("id" "attempt" "exit" "stopReason" "sourceSha256" "compiledSha256" "stdout" "configText" "lockText")
    (equal (get row field) (get prior field) (template row:id " " field)))
  (for-of field #a("inputState" "inputAfter" "outputBefore" "outputAfter")
    (equal (get row field) (get prior field) (template row:id " file state " field)))
  (equal row:survivors #a() "cleanup")
  (bind status (fact row "status"))
  (Object:define-property counts status (obj :value (+ (?? (get counts status) 0) 1) :enumerable true :configurable true))
  (for-of event (events row)
    (if (= (get event 0) "warning") (swap! warnings (fn (:number n) (+ n 1)))))
  (for-of file row:outputAfter
    (equal (-> (Deno:read-file-sync (template row:cwd "/" file:path))
      (Array:from) (:map (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")) file:hex "actual destination bytes")))
(equal (Object:keys counts) #a("complete" "stringify-rejected" "parse-rejected") "outcome categories")
(equal (get counts "complete") 428 "complete total")
(equal (get counts "stringify-rejected") 6 "stringify rejection total")
(equal (get counts "parse-rejected") 84 "parse rejection total")
(equal (express warnings) 4 "ordered warning count")
(func selected :args (:string id) :body
  (bind matches (current:filter (fn (:object row) (and (= row:id id) (= row:attempt 1)))))
  (equal matches:length 1 "selected unique case")
  (get matches 0))
(for-of id #a("Y-15-Map-skipfalse" "Y-15-Map-skiptrue" "Y-15-Set-skipfalse" "Y-15-Set-skiptrue")
  (equal (get (fact (selected id) "output") "text") "{}\n" "Map/Set contents lost"))
(equal (fact (selected "Y-05-alias") "reparsedAlias") true "serialized alias identity")
(equal (fact (selected "Y-06-cycle") "reparsedCycle") true "serialized cycle identity")
(for-of pair #a(#a("9007199254740993" "9007199254740992") #a("1e400" "Infinity") #a("1e-400" "0") #a("-0" "0"))
  (equal (get (entry (fact (selected (template "Y-12-number-" (get pair 0) "-default")) "parsed") "x") "value") (get pair 1) "original numeric loss"))
(for-of id #a("Y-09-malformed" "Y-09-indent")
  (equal (get (get (selected id) "outputAfter") 0)
    (get (get (selected id) "outputBefore") 0) "rejected parse preserves destination"))
(bind tab (fact (selected "Y-09-tab") "parsed"))
(equal (get (entry tab "a") "kind") "null" "tab case a becomes null")
(equal (get (entry tab "b") "value") "1" "tab case b is sibling")
(console:log (JSON:stringify (obj :result "pass" :checks (express checks) :attempts 518 :warnings (express warnings) :outcomes counts)))
