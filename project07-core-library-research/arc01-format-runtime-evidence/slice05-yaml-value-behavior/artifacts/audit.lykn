;; Lykn owns fixture generation and evidence audit. No package import here.
(bind encoder (new TextEncoder))
(bind checks (cell 0))
(func ensure :args (:boolean ok :string label) :body
  (swap! checks (fn (:number n) (+ n 1)))
  (if (not ok) (throw (new Error label))))
(func hex :args (:any bytes) :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(func unhex :args (:string text) :body
  (Uint8Array:from (?? (text:match (regex ".." "g")) #a()) (fn (:string p) (Number:parse-int p 16))))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func append-item :args (:array values :any item) :body (conj values item))
(bind schemas #a("failsafe" "json" "core" "default" "extended"))
(func put! :args (:object target :string key :any value) :body
  (Object:define-property target key (obj :value value :enumerable true :writable true :configurable true)))
(bind owner "slice05-yaml-value-behavior")
(bind constructor-text (obj :Date "(new Date \"2026-09-12T00:00:00.000Z\")"
  :Map "(new Map #a(#a(\"1\" \"string-key\") #a(1 \"number-key\")))"
  :Set "(new Set #a(1 \"1\"))" :undefined "undefined" :function "(fn () 1)"
  :cycle "(bind value (obj)) (define-value! value \"self\" value) value"))
(async (func freeze :args () :body
  (bind original-text (Deno:read-text-file-sync "yp-inputs.json"))
  (bind original (JSON:parse original-text))
  (ensure (= (await (digest (encoder:encode original-text))) "012be588e360a46b4458cc2be8ea99448b3314783bc794509df83eeb17e627db") "original YP-M01 hash")
  (bind rows (cell #a()))
  (bind pairs (cell #a()))
  (for-of prior original:variants
    (if (prior:id:starts-with "Y-")
      (do
        (bind row (structured-clone prior))
        (put! row "original" prior)
        (put! row "phase" (? (= row:owner owner) "matrix" "future"))
        (if (= row:phase "matrix")
          (do
            (bind spec row:case)
            (put! spec "fileFlow" (or (= row:family "Y-01") (= row:family "Y-09")))
            (put! spec "originalLexeme" row:text)
            (bind domains (cell #a("Original key spelling and tag domain retained verbatim in originalLexeme")))
            (if (row:id:starts-with "Y-04-key0") (reset! domains #a("boolean true" "number 1" "string 1")))
            (if (row:id:starts-with "Y-04-key1") (reset! domains #a("sequence [a,b]")))
            (if (row:id:starts-with "Y-04-key2") (reset! domains #a("mapping {a: b}")))
            (put! spec "originalKeyDomain" (express domains))
            (put! spec "constructor" (? (= spec:op "runtime") (get constructor-text spec:runtimeKind)
              (? (= spec:op "runtime-presence") "(define-value! value \"x\" undefined), enumerable own x after absent control" null)))
            (put! row "args" #a((JSON:stringify spec)))
            (put! row "operationalAdditions" "Exact dispatch contract; inspect original; serialize no-op; edit only declared n/alias/keys; serialize output; reparse; preserve every warning in sequence. File families read first and replace an existing destination only after validation.")
            (if spec:fileFlow
              (do (put! row "files" #a((obj :path "inputs/source.yaml" :hex spec:hex)
                    (obj :path "outputs/destination.yaml" :hex "4f524947494e414c0a")))
                  (put! row "flags" #a("--allow-read=./inputs,./outputs" "--allow-write=./outputs"))))
            (swap! pairs append-item #a(row:id (JSON:stringify spec)))))
        (swap! rows append-item row))))
  (bind selected (-> (express rows) (:filter (fn (:object row) (= row:phase "matrix")))) )
  (ensure (= selected:length 259) "259 selected variants")
  (ensure (= (get (express rows) "length") 349) "349 owners retained")
  (bind first-case (get selected 0))
  (bind bad-pair (assoc first-case:case :op "runtime"))
  (bind bad-schema (assoc first-case:case :options (obj :schema "unknown-schema")))
  (for-of control #a("inspector-control" "unknown-operation" "unknown-case" "unknown-pair" "unknown-schema")
    (bind spec-text (? (= control "unknown-case") "{\"id\":\"NOT-A-CASE\"}"
      (? (= control "unknown-pair") (JSON:stringify bad-pair) (JSON:stringify bad-schema))))
    (bind needs-probe (-> #a("unknown-case" "unknown-pair" "unknown-schema") (:includes control)))
    (swap! rows append-item (obj :id (template "HP-" control) :family "HP" :owner owner :phase "harness"
      :op (? needs-probe "probe" control) :args (? needs-probe #a(spec-text) #a()) :repeats 2 :flags #a() :files #a()
      :expectedExit (? (= control "inspector-control") 0 1) :expected "Tagged inspector bounds or explicit unknown dispatch rejection")))
  (bind manifest (obj :protocol "RP01/FM01" :revision "YV-M01" :originalSha256 (await (digest (encoder:encode original-text)))
    :constructors constructor-text :normalVariants 259 :normalAttempts 518 :variants (express rows)))
  (Deno:write-text-file-sync "inputs.json" (template (JSON:stringify manifest null 2) "\n"))
  (bind source (Deno:read-text-file-sync "cases.lykn"))
  (bind declaration (template ";; BEGIN CONTRACTS\n(bind contracts (new Map (JSON:parse " (JSON:stringify (JSON:stringify (express pairs))) ")))\n;; END CONTRACTS"))
  (Deno:write-text-file-sync "cases.lykn" (source:replace (regex ";; BEGIN CONTRACTS[\\s\\S]*?;; END CONTRACTS") (fn () declaration)))
  (bind lines (cell #a("# Frozen YAML value matrix — YV-M01" "" "Original YP-M01 rows are retained verbatim in each original field. All 349 YAML IDs and owners survive; 259 run here twice, with 5 harness controls twice and 3 supervisor controls separately. Expected questions are not replaced by observations." "" "Operational additions: complete exact spec dispatch; file-first read and real replacement for Y-01/Y-09; no-op and edited serialization/reparse for all accepted values; declared alias/n/key edits only; ordered warnings; constructor bytes and original key domains in inputs.json. Y-15 constructors use Date at UTC midnight, Map string 1 then numeric 1, Set numeric 1 then string 1, top-level undefined, function returning 1, own self-cycle. Y-12 own undefined is enumerable beside an absent control. No Y-13/Y-14/Y-16 execution." "" "| ID | Phase | Full owner | Original operation | Original question |" "| --- | --- | --- | --- | --- |")))
  (for-of row (express rows)
    (swap! lines append-item (template "| " row:id " | " row:phase " | " row:owner " | "
      (? (= row:family "HP") row:op row:case:op) " | " row:expected " |")))
  (Deno:write-text-file-sync "case-manifest.md" (template (-> (express lines) (:join "\n")) "\n"))
  (console:log "Frozen 349 YAML IDs; 259 variants/518 attempts; 5 harness controls/10 attempts")))
(func graph-check :args () :body
  (bind graph (JSON:parse (Deno:read-text-file-sync "dependency-graph.json")))
  (ensure (= (get (Object:keys (?? graph:npmPackages (obj))) "length") 0) "npm graph")
  (ensure (= graph:modules:length 26) "expected actual 26-module graph")
  (for-of module graph:modules
    (ensure (not (or (module:specifier:starts-with "npm:") (module:specifier:starts-with "node:"))) "Node/npm module")
    (ensure (not (Object:has-own module "error")) "graph resolution error"))
  (bind lock (JSON:parse (Deno:read-text-file-sync "deno.lock")))
  (ensure (= (JSON:stringify (Object:keys lock:jsr)) "[\"@std/yaml@1.2.0\"]") "one pinned package")
  (console:log (JSON:stringify (obj :graph "pass" :modules graph:modules:length))))
(bind mode (get Deno:args 0))
(if (= mode "freeze") (await (freeze)))
(if (= mode "graph") (graph-check))
(if (not (-> #a("freeze" "graph" "audit" "planning" "preflight" "compare" "pack" "extract") (:includes mode))) (throw (new Error "Unknown audit mode")))
(func records :args (:string path) :body
  (-> (Deno:read-text-file-sync path) (:trim) (:split "\n") (:filter (fn (:string line) (> line:length 0)))
    (:map (fn (:string line) (JSON:parse line)))))
(func events :args (:object row) :body
  (-> row:stdout (:trim) (:split "\n") (:filter (fn (:string line) (> line:length 0)))
    (:map (fn (:string line) (JSON:parse line)))))
(func all-facts :args (:array stream :string label) :body
  (-> stream (:filter (fn (:array event) (= (get event 0) label))) (:map (fn (:array event) (get event 1)))))
(func fact :args (:array stream :string label) :body
  (bind items (all-facts stream label))
  (ensure (<= items:length 1) (template "duplicate non-warning label " label))
  (get items 0))
(func entry :args (:object node :string key) :body
  (bind pair (node:entries:find (fn (:array item) (bind name (get item 0)) (= name:value key))))
  (ensure (not (= pair undefined)) (template "missing represented key " key))
  (get pair 1))
(func same :args (:any a :any b) :body (= (JSON:stringify a) (JSON:stringify b)))
(func equal-files :args (:array a :array b) :body
  (same (a:to-sorted (fn (:object x :object y) (x:path:locale-compare y:path)))
    (b:to-sorted (fn (:object x :object y) (x:path:locale-compare y:path)))))
(func no-bounds :args (:any node) :body
  (if (or (= node null) (not (= (typeof node) "object"))) (return))
  (ensure (not (= node:truncated true)) "unexpected incomplete observation")
  (ensure (not (-> #a("visit-bound" "depth-bound" "node-bound") (:includes node:kind))) "unexpected inspector bound")
  (for-of value (Object:values node) (no-bounds value)))
(async (func controls-check :args () :body
  (bind controls (records "controls.stdout"))
  (ensure (= controls:length 3) "three supervisor controls")
  (for-of row controls
    (bind kind (row:id:replace "control-" ""))
    (ensure (= row:stopReason (? (= kind "timeout") "wall" kind)) "exact supervisor stop")
    (ensure (= row:exit 137) "control killed")
    (ensure (> row:maxSampledTreeRssKiB 0) "control process observed")
    (ensure (= row:survivors:length 0) "no control survivor")
    (if (= kind "output") (ensure (<= row:outputBytesRetained 4096) "capped control retention")))
  (bind harness (records "harness.stdout"))
  (ensure (= harness:length 10) "ten harness attempts")
  (for-of row harness
    (ensure (= row:stopReason null) "no unexpected harness cap")
    (ensure (= row:survivors:length 0) "no harness survivor")
    (if (= row:id "HP-inspector-control")
      (do
        (ensure (= row:exit 0) "inspector exit")
        (bind stream (events row))
        (bind entries (fact stream "inspector"))
        (bind kinds (entries:entries:map (fn (:array pair) (bind node (get pair 1)) node:kind)))
        (ensure (same kinds #a("undefined" "null" "boolean" "number" "number" "number" "date" "[object Uint8Array]" "map" "set" "object" "symbol" "function" "array")) "all inspector kinds")
        (ensure (= (get (entry entries "3") "value") "-0") "signed zero inspector")
        (ensure (= (get (entry entries "7") "hex") "00ff") "binary inspector")
        (ensure (= (get (entry entries "6") "iso") "2026-09-12T00:00:00.000Z") "Date inspector")
        (ensure (= (get (fact stream "bounds") "truncated") true) "string bound")
        (ensure (-> (JSON:stringify (fact stream "depthBound")) (:includes "depth-bound")) "depth bound"))
      (do (ensure (= row:exit 1) "unknown dispatch exit")
          (ensure (or (row:stderr:includes "Unknown case ID") (row:stderr:includes "Unknown operation")
            (row:stderr:includes "ID/operation/schema/options contract mismatch")) "explicit unknown dispatch error"))))
  (ensure (= (-> (Deno:read-text-file-sync "meta/permission-scoped.stdout") (:trim)) "CONTROL") "scoped read success")
  (ensure (-> (Deno:read-text-file-sync "meta/permission-denied.stderr") (:includes "NotCapable")) "actual permission denial")
  (bind argv (-> (Deno:read-text-file-sync "meta/argv.bin") (:split "\u0000")))
  (ensure (= (get argv 0) "run") "argv run")
  (ensure (< (argv:index-of "--allow-read=./inputs") (argv:index-of "--")) "read flag before script")
  (ensure (> (argv:index-of "--allow-all") (argv:index-of "--")) "bypass-like token remains script data")
  (console:log (JSON:stringify (obj :controls "pass" :supervisor 3 :harness 10 :checks (express checks))))))
(func ranges :args (:any before :any after) :body
  (bind result (cell #a())) (bind start (cell null)) (bind index (cell 0))
  (while (< (express index) (Math:max before:length after:length))
    (bind i (express index))
    (bind differs (not (= (get before i) (get after i))))
    (? (and differs (= (express start) null)) (reset! start i) undefined)
    (? (and (not differs) (not (= (express start) null)))
      (do (swap! result append-item #a((express start) i)) (reset! start null)) undefined)
    (swap! index (fn (:number n) (+ n 1))))
  (if (not (= (express start) null)) (swap! result append-item #a((express start) (express index))))
  (express result))
(func semantic-check :args (:object spec :array stream) :body
  (bind parsed (fact stream "parsed"))
  (bind status (fact stream "status"))
  (bind reparse (fact stream "reparsed"))
  (bind original spec:case)
  (if (= original:op "runtime")
    (do (ensure (not (= parsed undefined)) "runtime constructor observed")
        (ensure (= (get (fact stream "runtimeOriginal") "constructor") original:constructor) "constructor identity")))
  (if (not (= parsed undefined)) (no-bounds parsed))
  (if (= spec:family "Y-01")
    (do (ensure (= status "complete") "Y01 workflow complete")
        (ensure (= (get (entry parsed "n") "value") "1") "original n=1")
        (ensure (= (get (entry reparse "n") "value") "2") "edited n=2")
        (for-of key #a("name" "flags" "nil") (ensure (same (entry parsed key) (entry reparse key)) "only n changes"))
        (ensure (= (get (entry parsed "name") "value") "Ada") "independent name")
        (ensure (= (get (entry parsed "nil") "kind") "null") "independent null")
        (ensure (= (get (entry (entry parsed "flags") "0") "value") "true") "true flag")
        (ensure (= (get (entry (entry parsed "flags") "1") "value") "false") "false flag")))
  (if (= spec:family "Y-02")
    (do (ensure (not (= parsed undefined)) "all implicit scalars parse")
        (bind scalar (entry parsed "v"))
        (if (= original:style "quoted")
          (do (ensure (= scalar:kind "string") "quoted scalar string")
              (ensure (= scalar:value original:scalar) "quoted spelling preserved")))
        (if (and (= original:style "plain") (= original:options:schema "failsafe") (not (= original:scalar "")))
          (do (ensure (= scalar:kind "string") "failsafe plain nonempty string")
              (ensure (= scalar:value original:scalar) "failsafe original spelling")))))
  (if (= spec:id "Y-04-duplicate-reject") (ensure (= status "parse-rejected") "duplicate rejected"))
  (if (= spec:id "Y-04-duplicate-allow") (ensure (= (get (entry parsed "a") "value") "2") "explicit duplicate last wins"))
  (if (= spec:id "Y-05-alias")
    (do (ensure (= (fact stream "aliasBefore") true) "alias original identity")
        (ensure (same (fact stream "aliasAfter") (obj :same true :bX 9)) "alias mutation visible")
        (if (not (= reparse undefined)) (ensure (= (get (entry (entry reparse "a") "x") "value") "9") "reparsed alias value"))))
  (if (= spec:id "Y-06-cycle") (ensure (= (fact stream "selfCycle") true) "self-cycle observed"))
  (if (= spec:id "Y-06-unresolved") (ensure (= status "parse-rejected") "unresolved alias rejected"))
  (if (= spec:id "Y-08-two-parseAll")
    (do (ensure (= parsed:length 2) "two ordered documents")
        (ensure (= (get (entry (entry parsed "0") "a") "value") "1") "first document")
        (ensure (= (get (entry (entry parsed "1") "b") "value") "2") "second document")))
  (if (= spec:id "Y-08-empty-parseAll")
    (do (ensure (= parsed:length 3) "three documents including empty")
        (ensure (= (get (entry parsed "1") "kind") "null") "empty document retained")))
  (if (or (= spec:id "Y-08-invalid-parseAll") (and (= spec:family "Y-08") (= original:op "parse")))
    (ensure (= status "parse-rejected") "invalid or single-parser multi-doc rejection"))
  ;; YP-M01 characterizes Y-09 outcomes. Tab indentation was accepted in both
  ;; attempts, contrary to the audit author's assumption. Preserve this result;
  ;; the generic file audit still enforces unchanged destination on rejection.
  (if (-> #a("Y-09-malformed" "Y-09-indent") (:includes spec:id)) (ensure (= status "parse-rejected") "malformed file rejection"))
  (if (= spec:id "Y-11-literal") (ensure (= (get (entry parsed "text") "value") "one\n\n") "literal scalar semantic newlines"))
  (if (= spec:id "Y-11-folded") (ensure (= (get (entry parsed "text") "value") "one two") "folded scalar semantic spaces"))
  (if (spec:id:starts-with "Y-12-presence")
    (do (bind presence (fact stream "presence"))
        (ensure (= presence:own (not (= spec:id "Y-12-presence-0"))) "own presence")
        (if (-> #a("Y-12-presence-2" "Y-12-presence-3" "Y-12-presence-4") (:includes spec:id))
          (ensure (same presence:value presence:defaultValue) "defaults preserve falsy"))))
  (if (= spec:id "Y-12-own-undefined")
    (do (ensure (= (get (fact stream "absentControl") "own") false) "absent x control")
        (ensure (= (get (fact stream "presence") "own") true) "own undefined present")
        (ensure (= (get (entry parsed "x") "kind") "undefined") "own undefined kind")))
  (if (= spec:id "Y-12-exact-keys")
    (do (bind keys #a("first-name" "firstName" "" "a:b" "a/b" "~" "__proto__" "constructor" "toString"))
        (ensure (same (fact stream "keysBefore") keys) "exact original keys")
        (ensure (same (fact stream "keysAfter") keys) "exact edited keys")
        (ensure (= (fact stream "prototypeUnchanged") true) "prototype stable")
        (for-of pair (keys:entries)
          (ensure (= (get (entry reparse (get pair 1)) "value") (String (+ 10 (get pair 0)))) "exact key edit survived"))))
  null)
(if (= mode "preflight") (await (controls-check)))
(async (func audit :args () :body
  (graph-check)
  (await (controls-check))
  (ensure (same (ranges #a(1 2 3 4) #a(1 9 3 8 5)) #a(#a(1 2) #a(3 5))) "difference ranges independent control")
  (ensure (same (ranges #a(1) #a(1)) #a()) "identical bytes control")
  (bind manifest (JSON:parse (Deno:read-text-file-sync "inputs.json")))
  (bind prior (JSON:parse (Deno:read-text-file-sync "yp-inputs.json")))
  (bind original-rows (prior:variants:filter (fn (:object row) (row:id:starts-with "Y-"))))
  (bind yaml-rows (manifest:variants:filter (fn (:object row) (row:id:starts-with "Y-"))))
  (ensure (= yaml-rows:length 349) "all YAML IDs")
  (bind ids (new Set))
  (for-of spec yaml-rows
    (ensure (not (ids:has spec:id)) "unique YAML ID") (ids:add spec:id)
    (bind original (original-rows:find (fn (:object row) (= row:id spec:id))))
    (ensure (same spec:original original) "verbatim original question/options/bytes/owner")
    (ensure (= spec:owner original:owner) "original owner unchanged")
    (ensure (= spec:expected original:expected) "original question unchanged")
    (ensure (= spec:case:hex original:case:hex) "original literal bytes unchanged")
    (ensure (same spec:case:options original:case:options) "parse options unchanged")
    (ensure (same spec:case:stringifyOptions original:case:stringifyOptions) "stringify options unchanged"))
  (bind specs (yaml-rows:filter (fn (:object row) (= row:phase "matrix"))))
  (ensure (= specs:length 259) "259 assigned variants")
  (bind runs (records "matrix.stdout"))
  (ensure (= runs:length 518) "518 normal attempts")
  (bind source-hash (await (digest (Deno:read-file-sync "cases.lykn"))))
  (bind compiled-hash (await (digest (Deno:read-file-sync "cases.js"))))
  (bind lock-text (Deno:read-text-file-sync "deno.lock"))
  (bind config-text (Deno:read-text-file-sync "project.json"))
  (bind cli (-> (Deno:read-text-file-sync "compiler-path.txt") (:trim)))
  (bind known-runs (new Set))
  (bind first (new Map))
  (bind totals (new Map))
  (bind lines (cell #a("# YAML value results — YV-R01" "" "Same-author execution and audit; independent CDC pending. All 259 normal variants ran twice in fresh roots (518 attempts). Three supervisor controls and five harness controls twice are separate. Tables classify observed outcomes; a complete transport/workflow status does not imply semantic or document fidelity." "" "Source, runtime, graph and scope are pinned in baseline-and-protocol.md. Every warning event is retained in ordered stdout and the detailed records below. Bound markers mean incomplete observations; no such marker is accepted in the small normal matrix. Y-13/Y-16 and gated Y-14 remain future work." "" "| ID | Attempts | Observed status | Parsed kind | No-op reparse equivalent | Warning events per attempt |" "| --- | --- | --- | --- | --- | --- |")))
  (bind details (cell #a("" "## Per-variant value and error evidence" "" "First-attempt facts below; repeat equality is checked byte-for-byte, including ordered warnings. Full independent second-attempt and process/file evidence is in raw-transcript.txt.")))
  (bind byte-lines (cell #a("# YAML byte audit — YV-BY01" "" "For each accepted serialization, compare original literal bytes with no-op and output bytes. Y-15 has no original YAML document: its empty literal is only a transport placeholder, and the constructed value is retained in results. Ranges are zero-based half-open differing positional spans over max(original length, output length), including absent positions. This is a complete positional comparison, not a minimal insertion/deletion edit script. First difference is the first range start, or null. Original bytes are never inferred from reparsed values.")))
  (for-of spec specs
    (bind pair (runs:filter (fn (:object row) (= row:id spec:id))))
    (ensure (= pair:length 2) (template spec:id " exactly two attempts"))
    (ensure (same (pair:map (fn (:object row) row:attempt)) #a(1 2)) "attempt ordering")
    (ensure (= (get (get pair 0) "stdout") (get (get pair 1) "stdout")) (template spec:id " repeat stdout including all warnings"))
    (first:set spec:id (get pair 0)))
  (for-of row runs
    (bind spec (specs:find (fn (:object candidate) (= row:id candidate:id))))
    (ensure (not (= spec undefined)) "no extra matrix ID")
    (bind run-id (template row:id "-" row:attempt))
    (ensure (not (known-runs:has run-id)) "unique attempt") (known-runs:add run-id)
    (ensure (= row:exit 0) (template row:id " runtime completed"))
    (ensure (= row:stopReason null) "no unexpected cap")
    (ensure (= row:survivors:length 0) "no observed survivor")
    (ensure (> row:maxSampledTreeRssKiB 0) "process sampled")
    (ensure (= row:sourceSha256 source-hash) "retained source identity")
    (ensure (= row:compiledSha256 compiled-hash) "emitted source identity")
    (ensure (= row:configText config-text) "config identity")
    (ensure (= row:lockText lock-text) "per-run lock identity")
    (ensure (= row:effectiveConfig:text config-text) "actual effective config identity")
    (ensure (= row:effectiveConfig:overlay false) "no overlay")
    (ensure (= (await (digest (encoder:encode row:stdout))) row:stdoutSha256) "stdout hash")
    (ensure (= (hex (encoder:encode row:stdout)) row:stdoutHex) "stdout bytes")
    (ensure (= (await (digest (encoder:encode row:stderr))) row:stderrSha256) "stderr hash")
    (ensure (= (hex (encoder:encode row:stderr)) row:stderrHex) "stderr bytes")
    (ensure (equal-files row:inputState row:inputAfter) "source files unchanged")
    (bind expected-command (-> #a("/usr/bin/time" "-l" cli "run" "--no-prompt") (:concat spec:flags)
      (:concat #a("--cached-only" "--frozen=true" "cases.lykn" spec:op)) (:concat spec:args)))
    (ensure (same row:command expected-command) "exact execution argv")
    (ensure (= row:environment:PATH "/opt/homebrew/bin:/usr/bin:/bin") "real PATH")
    (ensure (= row:environment:DENO_DIR (template row:cwd "/cache")) "isolated cache")
    (ensure (= row:preparation:exit 0) "fixture preparation exit")
    (for-of file (-> row:inputState (:concat row:outputBefore row:inputAfter row:outputAfter))
      (ensure (= (await (digest (unhex file:hex))) file:sha256) "file hash")
      (ensure (= (/ file:hex:length 2) file:size) "file byte count"))
    (bind stream (events row))
    (bind status (fact stream "status"))
    (ensure (-> #a("complete" "parse-rejected" "stringify-rejected" "reparse-rejected") (:includes status)) "attributable terminal status")
    (bind input (fact stream "input"))
    (ensure (= input:hex spec:case:hex) "actual input bytes")
    (ensure (= input:sha256 spec:inputSha256) "actual input hash")
    (ensure (= input:originalLexeme spec:text) "exact lexeme retained")
    (ensure (same input:originalKeyDomain spec:case:originalKeyDomain) "original key domains retained")
    (ensure (= input:bytes spec:encodedBytes) "actual input length")
    (bind errors (all-facts stream "error"))
    (bind warnings (all-facts stream "warning"))
    (for-of err errors
      (ensure (-> #a("parse" "stringify-noop" "stringify-edited" "reparse-noop" "reparse-output" "reread") (:includes err:stage)) "package stage attributed")
      (ensure (> err:message:length 0) "actual package diagnostic")
      (ensure (> err:name:length 0) "actual error class")
      (no-bounds err:details))
    (if (not (= status "complete")) (ensure (> errors:length 0) "rejection has structured error"))
    (for-of warning warnings
      (ensure (> warning:stage:length 0) "warning stage recorded")
      (ensure (> warning:name:length 0) "warning class recorded")
      (ensure (> warning:message:length 0) "warning message recorded")
      (no-bounds warning:details))
    (if spec:case:fileFlow
      (do
        (ensure (= input:origin "actual-file-read-before-parse") "file-first parse")
        (ensure (= row:outputBefore:length 1) "existing destination")
        (ensure (= (get (get row:outputBefore 0) "hex") "4f524947494e414c0a") "original destination bytes")
        (ensure (= row:outputAfter:length 1) "no leftover sibling temp")
        (if (= status "parse-rejected")
          (ensure (equal-files row:outputBefore row:outputAfter) "rejected parse preserves destination")
          (do (bind output (fact stream "output"))
              (ensure (= (get (get row:outputAfter 0) "hex") output:hex) "actual replacement bytes")
              (ensure (= (get (fact stream "rereadBytes") "hex") output:hex) "actual reread bytes"))))
      (ensure (equal-files row:outputBefore row:outputAfter) "no parser-only file writes"))
    (for-of label #a("noop" "output" "rereadBytes")
      (bind value (fact stream label))
      (if (not (= value undefined))
        (do (ensure (= (hex (encoder:encode value:text)) value:hex) "serialized text/bytes agree")
            (ensure (= (await (digest (unhex value:hex))) value:sha256) "serialized bytes/hash agree")
            (ensure (= (/ value:hex:length 2) value:bytes) "serialized length"))))
    (semantic-check spec stream)
    (if (= row:attempt 1)
      (do
        (bind parsed (fact stream "parsed"))
        (bind noop-value (fact stream "noopReparsed"))
        (bind counts (?? (totals:get spec:family) (obj :variants 0 :complete 0 :parseRejected 0 :stringifyRejected 0 :reparseRejected 0 :warnings 0)))
        (put! counts "variants" (+ counts:variants 1))
        (bind count-key (? (= status "complete") "complete" (? (= status "parse-rejected") "parseRejected" (? (= status "stringify-rejected") "stringifyRejected" "reparseRejected"))))
        (put! counts count-key (+ (get counts count-key) 1))
        (put! counts "warnings" (+ counts:warnings warnings:length))
        (totals:set spec:family counts)
        (swap! lines append-item (template "| " spec:id " | 2 | " status " | " (? (= parsed undefined) "not produced" parsed:kind)
          " | " (? (or (= parsed undefined) (= noop-value undefined)) "unavailable" (String (same parsed noop-value))) " | " warnings:length " |"))
        (swap! details append-item (template "\n### " spec:id "\n\n```json\n" (JSON:stringify stream null 2) "\n```"))
        (bind original-bytes (unhex spec:case:hex))
        (swap! byte-lines append-item (template "\n## " spec:id "\n\nOriginal " spec:encodedBytes " bytes; SHA-256 " spec:inputSha256 "; hex `" spec:case:hex "`."))
        (for-of label #a("noop" "output")
          (bind value (fact stream label))
          (if (not (= value undefined))
            (do (bind changed-ranges (ranges original-bytes (unhex value:hex)))
                (swap! byte-lines append-item (template "\n" label " " value:bytes " bytes; SHA-256 " value:sha256 "; hex `" value:hex "`.\n\nFirst difference: "
                  (? (= changed-ranges:length 0) "null" (String (get (get changed-ranges 0) 0)))
                  "; complete ranges: `" (JSON:stringify changed-ranges) "`.")))
            (swap! byte-lines append-item (template "\n" label ": unavailable; status " status ".")))))))
  (swap! lines append-item "\n## Family totals\n\nCounts below are variants; normal attempts are twice each count. Warning counts are first-attempt event counts, not unique labels.\n\n```json")
  (swap! lines append-item (JSON:stringify (Object:from-entries totals) null 2))
  (swap! lines append-item "```")
  (Deno:write-text-file-sync "results.md" (template (-> (express lines) (:concat (express details)) (:join "\n")) "\n"))
  (Deno:write-text-file-sync "byte-audit.md" (template (-> (express byte-lines) (:join "\n")) "\n"))
  (console:log (JSON:stringify (obj :audit "pass" :checks (express checks) :normalAttempts runs:length :variants specs:length
    :controls 13 :families (Object:from-entries totals))))))
(if (= mode "audit") (await (audit)))
(func planning-check :args (:string root) :body
  (bind scope (-> (Deno:read-text-file-sync (template root "/project07-core-library-research/arc01-format-runtime-evidence/slice05-yaml-value-behavior/cc-prompt.md"))
    (:split "\n") (:filter (fn (:string line) (or (line:starts-with "project07-core-library-research/") (line:starts-with "backlog/"))))))
  (bind allowed (new Set scope))
  (bind paths (-> (Deno:read-text-file-sync "changed-paths.txt") (:trim) (:split "\n")))
  (bind links (cell 0))
  (for-of path paths
    (ensure (allowed:has path) (template "outside explicit scope: " path))
    (if (path:ends-with ".md")
      (do (bind text (Deno:read-text-file-sync (template root "/" path)))
          (bind prose (text:replace (regex "```[\\s\\S]*?```" "g") ""))
          (bind base (new URL (template "file://" root "/" path)))
          (for-of match (prose:match-all (regex "\\]\\(([^\\s)]+)\\)" "g"))
            (bind target (get match 1))
            (if (not (or (target:starts-with "https:") (target:starts-with "http:") (target:starts-with "#")))
              (do (bind url (new URL target base)) (Deno:stat-sync url)
                  (swap! links (fn (:number n) (+ n 1)))))))))
  (console:log (JSON:stringify (obj :planning "pass" :paths paths:length :links (express links)))))
(if (= mode "planning") (planning-check (get Deno:args 1)))
(func compare-confirmation :args (:string previous) :body
  (bind old (records (template previous "/matrix.stdout")))
  (bind current (records "matrix.stdout"))
  (ensure (= old:length 518) "original 518 attempts retained")
  (ensure (= current:length 518) "confirmation 518 attempts")
  (for-of pair (current:entries)
    (bind row (get pair 1))
    (bind before (get old (get pair 0)))
    (ensure (= row:id before:id) "same comparison ID")
    (ensure (= row:attempt before:attempt) "same comparison attempt")
    (bind normalized (-> (events row) (:map (fn (:array event)
      (if (= (get event 0) "warning")
        (do (bind value (get event 1))
            (return #a("warning" (obj :stage value:stage :details value:details)))))
      event))))
    (ensure (same normalized (events before)) "all observations unchanged except added warning name/message")
    (ensure (equal-files row:inputAfter before:inputAfter) "source states agree across correction")
    (ensure (equal-files row:outputAfter before:outputAfter) "destination states agree across correction"))
  (console:log (JSON:stringify (obj :comparison "pass" :attempts 518 :checks (express checks)
    :difference "Warning name/message added; all prior value, error, byte and file facts unchanged"))))
(if (= mode "compare") (compare-confirmation (get Deno:args 1)))
(async (func packet :args (:string operation :string root) :body
  (if (= operation "pack")
    (do
      (bind paths (-> (Deno:read-text-file-sync "packet-paths.txt") (:trim) (:split "\n")))
      (bind output (cell #a()))
      (for-of path paths
        (ensure (not (or (path:starts-with "/") (path:includes ".."))) "relative packet path")
        (bind bytes (Deno:read-file-sync (template root "/" path)))
        (bind text (-> (new TextDecoder "utf-8" (obj :fatal true)) (:decode bytes)))
        (swap! output append-item (JSON:stringify (obj :file path :bytes bytes:length :sha256 (await (digest bytes)) :text text))))
      (Deno:write-text-file-sync "raw-transcript.txt" (template (-> (express output) (:join "\n")) "\n"))
      (console:log (JSON:stringify (obj :packet "pass" :files paths:length)))
      (return)))
  (bind input (records (get Deno:args 2)))
  (for-of record input
    (ensure (not (or (record:file:starts-with "/") (record:file:includes ".."))) "relative extraction path")
    (bind bytes (encoder:encode record:text))
    (ensure (= bytes:length record:bytes) "packet byte count")
    (ensure (= (await (digest bytes)) record:sha256) "packet hash")
    (bind destination (template root "/" record:file))
    (Deno:mkdir-sync (destination:slice 0 (destination:last-index-of "/")) (obj :recursive true))
    (Deno:write-file-sync destination bytes (obj :create-new true)))
  (console:log (JSON:stringify (obj :extraction "pass" :files input:length :checks (express checks))))))
(if (= mode "pack") (await (packet "pack" (get Deno:args 1))))
(if (= mode "extract") (await (packet "extract" (get Deno:args 1))))
