ned verbatim in originalLexeme\\\"],\\\"constructor\\\":\\\"(bind value (obj)) (define-value! value \\\\\\\"self\\\\\\\" value) value\\\"}\"]]")))
;; END CONTRACTS
(func define-value! :args (:object target :string key :any value) :body
  (Object:define-property target key (obj :value value :enumerable true :writable true :configurable true)))
(func construct :args (:string kind) :body
  (if (= kind "Date") (return (new Date "2026-09-12T00:00:00.000Z")))
  (if (= kind "Map") (return (new Map #a(#a("1" "string-key") #a(1 "number-key")))))
  (if (= kind "Set") (return (new Set #a(1 "1"))))
  (if (= kind "undefined") (return undefined))
  (if (= kind "function") (return (fn () 1)))
  (if (= kind "cycle") (do (bind value (obj)) (define-value! value "self" value) (return value)))
  (throw (new Error (template "Unknown runtime kind " kind))))
(func package-call :args (:string stage :function action) :body
  (try (return (obj :ok true :value (action)))
    (catch err (error-fact stage err) (return (obj :ok false)))))
(async (func byte-fact :args (:string label :string text) :body
  (bind bytes (encoder:encode text))
  (emit label (obj :text text :hex (hex bytes) :bytes bytes:length :sha256 (await (digest bytes))))))
(func replace-file! :args (:string output) :body
  (bind bytes (encoder:encode output))
  (bind file (Deno:open-sync "outputs/replacement.tmp" (obj :create-new true :write true)))
  (try
    (bind offset (cell 0))
    (while (< (express offset) bytes:length)
      (bind written (file:write-sync (bytes:subarray (express offset))))
      (ensure (> written 0) "write made no progress")
      (swap! offset + written))
    (file:sync-sync)
    (finally (file:close)))
  (Deno:rename-sync "outputs/replacement.tmp" "outputs/destination.yaml")
  (Deno:read-text-file-sync "outputs/destination.yaml"))
(async (func probe :args (:object spec) :body
  (ensure (contracts:has spec:id) (template "Unknown case ID: " spec:id))
  (ensure (= (contracts:get spec:id) (JSON:stringify spec)) "ID/operation/schema/options contract mismatch")
  (bind file-flow spec:fileFlow)
  (bind bytes (? file-flow (Deno:read-file-sync "inputs/source.yaml") (unhex spec:hex)))
  (ensure (= (hex bytes) spec:hex) "actual input bytes match frozen contract")
  (ensure (<= bytes:length 9437184) "encoded input limit")
  (emit "input" (obj :origin (? file-flow "actual-file-read-before-parse" "frozen-literal")
    :hex (hex bytes) :bytes bytes:length :sha256 (await (digest bytes))
    :originalLexeme spec:originalLexeme :originalKeyDomain spec:originalKeyDomain))
  (bind yaml (await (dynamic-import "@std/yaml")))
  (emit "exports" (-> (Object:keys yaml) (:sort)))
  (bind warning-stage (cell "parse"))
  (bind options (assoc spec:options :onWarning (fn (:any err)
    (emit "warning" (obj :stage (express warning-stage) :name err:name :message err:message :details (tree err))))))
  (bind input (-> (new TextDecoder) (:decode bytes)))
  (bind parsed (? (= spec:op "runtime") (obj :ok true :value (construct spec:runtimeKind))
    (package-call "parse" (fn ()
      (? (= spec:op "parseAll") (yaml:parse-all input options) (yaml:parse input options))))))
  (if (not parsed:ok) (do (emit "status" "parse-rejected") (return)))
  (bind value parsed:value)
  (if (= spec:op "runtime-presence")
    (do (emit "absentControl" (obj :own (Object:has-own value "x") :value (tree value:x)))
        (define-value! value "x" undefined)))
  (emit "parsed" (tree value))
  (if (spec:id:starts-with "Y-12-presence")
    (emit "presence" (obj :own (Object:has-own value "x") :value (tree value:x) :defaultValue (tree (?? value:x "DEFAULT")))))
  (if (= spec:op "runtime-presence")
    (emit "presence" (obj :own (Object:has-own value "x") :value (tree value:x) :defaultValue (tree (?? value:x "DEFAULT")))))
  (if (= spec:op "alias") (emit "aliasBefore" (= value:a value:b)))
  (if (= spec:op "cycle") (emit "selfCycle" (= value:a (get value:a 0))))
  (if (= spec:op "runtime") (emit "runtimeOriginal" (obj :constructor spec:constructor :tree (tree value))))
  (bind noop (package-call "stringify-noop" (fn () (yaml:stringify value spec:stringifyOptions))))
  (if (not noop:ok) (do (emit "status" "stringify-rejected") (return)))
  (ensure (= (typeof noop:value) "string") "serializer return must be text")
  (await (byte-fact "noop" noop:value))
  (reset! warning-stage "reparse-noop")
  (bind no-reparse (package-call "reparse-noop" (fn () (yaml:parse noop:value options))))
  (if no-reparse:ok (emit "noopReparsed" (tree no-reparse:value)))
  (if (= spec:op "alias")
    (do (define-value! value:a "x" 9)
        (emit "aliasAfter" (obj :same (= value:a value:b) :bX value:b:x))))
  (if (= spec:edit "n=2") (define-value! value "n" 2))
  (if (= spec:op "keys")
    (do (bind keys (Object:keys value))
        (bind prototype (Object:get-prototype-of value))
        (emit "keysBefore" keys)
        (for-of key keys (define-value! value key (+ (get value key) 10)))
        (emit "keysAfter" (Object:keys value))
        (emit "prototypeUnchanged" (= prototype (Object:get-prototype-of value)))
        (emit "prototypeWasObject" (= prototype Object:prototype))))
  (emit "edited" (tree value))
  (bind changed (or (= spec:op "alias") (= spec:op "keys") (= spec:edit "n=2")))
  (bind output (? changed (package-call "stringify-edited" (fn () (yaml:stringify value spec:stringifyOptions))) noop))
  (if (not output:ok) (do (emit "status" "stringify-rejected") (return)))
  (await (byte-fact "output" output:value))
  (reset! warning-stage "reparse-output")
  (bind reparsed (package-call "reparse-output" (fn () (yaml:parse output:value options))))
  (if reparsed:ok
    (do (emit "reparsed" (tree reparsed:value))
        (if (= spec:op "alias") (emit "reparsedAlias" (= reparsed:value:a reparsed:value:b)))
        (if (= spec:op "cycle") (emit "reparsedCycle" (= reparsed:value:a (get reparsed:value:a 0))))))
  (if file-flow
    (do (ensure reparsed:ok "replacement requires successful validation")
        (bind reread (replace-file! output:value))
        (ensure (= reread output:value) "destination bytes match full serialized output")
        (await (byte-fact "rereadBytes" reread))
        (reset! warning-stage "reread")
        (bind reread-value (package-call "reread" (fn () (yaml:parse reread options))))
        (ensure reread-value:ok "reread parse succeeds")
        (emit "reread" (tree reread-value:value))))
  (emit "status" (? reparsed:ok "complete" "reparse-rejected"))))
(async (func dispatch :args () :body
  (bind op (get Deno:args 0))
  (bind arg (get Deno:args 1))
  (if (= op "materialize") (do (materialize arg) (return)))
  (if (= op "control-read") (do (console:log (Deno:read-text-file-sync "inputs/control.txt")) (return)))
  (if (= op "control-timeout") (do (emit "checkpoint" "busy-loop") (while true)))
  (if (= op "control-output") (while true (console:log "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")))
  (if (= op "control-rss") (do (await (new Promise (fn (:function resolve) (set-timeout resolve 3000)))) (return)))
  (if (= op "probe") (do (await (probe (JSON:parse arg))) (return)))
  (if (= op "inspector-control")
    (do (bind cycle (obj)) (Object:define-property cycle "self" (obj :value cycle :enumerable true))
        (emit "inspector" (tree #a(undefined null false (Number "-0") NaN Infinity
          (new Date "2026-09-12T00:00:00Z") (Uint8Array:of 0 255)
          (new Map #a(#a(true "boolean-key") #a(1 "number-key")))
          (new Set #a(1 2)) cycle (Symbol "s") (fn () 1) (new Array 2))))
        (emit "bounds" (tree (String:prototype:repeat:call "x" 4097)))
        (bind nested (cell 0))
        (for-of i (Array:from (obj :length 258) (fn (:any ignored :number i) i))
          (reset! nested #a((express nested))))
        (emit "depthBound" (tree (express nested)))
        (return)))
  (throw (new Error (template "Unknown operation: " op)))))
(await (dispatch))
