;; DD static byte/source/graph census. Candidate modules are never evaluated.
(bind checks (cell 0))
(func ensure :args (:boolean ok :string label) :body
  (swap! checks + 1)
  (if (not ok) (throw (new Error label)))
  null)
(func read-json :args (:string path) :body (JSON:parse (Deno:read-text-file-sync path)))
(func write-json :args (:string path :any value) :body
  (Deno:write-text-file-sync path (template (JSON:stringify value null 2) "\n")))
(async (func digest :args (:any bytes) :body
  (bind data (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))
  (-> (Array:from data (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join ""))))
(func exists :args (:string path) :body
  (bind found (cell false))
  (try (do (Deno:stat-sync path) (reset! found true))
    (catch error (if (not (instanceof error Deno:errors:NotFound)) (throw error) null)))
  (express found))
(func walk :args (:string dir) :body
  (bind result #a())
  (for-of entry (Deno:read-dir-sync dir)
    (bind path (template dir "/" entry:name))
    (ensure (not entry:is-symlink) "source census has no symlink")
    (if entry:is-directory (for-of child (walk path) (result:push child)) (result:push path)))
  (result:sort (fn (:string a :string b) (a:locale-compare b "en"))))
(func category :args (:string path) :body
  (cond
    ((-> (regex "test|bench|spec|fixture|testdata") (:test path)) "test-development")
    ((-> (regex "example|playground|docs") (:test path)) "example-documentation")
    ((-> (regex "config|lock|package\\.json|deno\\.json|_tools|workflow") (:test path)) "build-transport")
    ((-> (regex "types\\.ts$|\\.d\\.ts$") (:test path)) "type")
    (:else "runtime-or-support")))
(async (func prepare :args () :body
  (bind packages #a())
  (for-of pkg #a("std/json/1.1.0" "std/jsonc/1.0.2" "std/yaml/1.2.0" "std/streams/1.1.2" "eemeli/yaml/2.9.1")
    (bind meta (read-json (template "prior/published/" pkg "/meta.json")))
    (bind files #a())
    (bind edges #a())
    (for-of path (Object:keys meta:manifest)
      (bind bytes (Deno:read-file-sync (template "prior/published/" pkg path)))
      (bind sha (await (digest bytes)))
      (bind expected (get meta:manifest path))
      (ensure (= bytes:length expected:size) "published length")
      (ensure (= (template "sha256-" sha) expected:checksum) "published hash")
      (bind base (cond
        ((pkg:starts-with "std/json/") "upstream/std-json/json")
        ((pkg:starts-with "std/jsonc/") "upstream/std-jsonc/jsonc")
        ((pkg:starts-with "std/") (template "upstream/std/" (get (pkg:split "/") 1)))
        (:else "prior/upstream/eemeli")))
      (bind upstream (template base path))
      (bind present (exists upstream))
      (bind upstream-sha (? present (await (digest (Deno:read-file-sync upstream))) null))
      (files:push (obj :path path :url (template "https://jsr.io/@" pkg path) :bytes bytes:length :sha256 sha :category (category path)
        :upstream upstream :upstreamSha256 upstream-sha :correspondence (? present (? (= sha upstream-sha) "identical" "different") "absent"))))
    (for-of path (Object:keys meta:moduleGraph2)
      (bind node (get meta:moduleGraph2 path))
      (for-of edge (?? node:dependencies #a())
        (edges:push (obj :from path :category (category path) :specifier edge:specifier :kind edge:kind :type edge:type :range edge:specifierRange
          :resolved (? (edge:specifier:starts-with ".") (get (new URL edge:specifier (template "https://jsr.io/@" pkg path)) "href") edge:specifier)))))
    (packages:push (obj :package pkg :exports meta:exports :files files :edges edges)))
  (bind roots #a())
  (for-of name #a("json" "jsonc" "yaml" "streams")
    (for-of path (walk (template "upstream/std/" name))
      (if (path:ends-with ".ts") (roots:push (obj :path path :category (category path))))))
  (Deno:write-text-file-sync "upstream-root.lykn"
    (-> roots (:map (fn (:object row) (template "(import " (JSON:stringify (template "./" row:path)) " ())\n"))) (:join "")))
  (bind eemeli-roots (-> (walk "prior/upstream/eemeli") (:filter (fn (:string path) (-> (regex "\\.(ts|js|mjs)$") (:test path))))))
  (Deno:write-text-file-sync "eemeli-root.lykn"
    (-> eemeli-roots (:map (fn (:string path) (template "(import " (JSON:stringify (template "./" path)) " ())\n"))) (:join "")))
  (write-json "source-inventory.json" (obj :packages packages :upstreamRoots roots :checks (express checks)))
  (console:log (JSON:stringify (obj :packages packages:length :upstreamRoots roots:length :checks (express checks))))))
(async (func graphs :args () :body
  (bind inventory (read-json "source-inventory.json"))
  (bind rows #a())
  (for-of pair #a(#a("runtime" "prior/transport/resolved-all-exports-graph.json") #a("published-development" "prior/dev-transport/graph.json") #a("upstream-development" "transport/upstream-graph.json") #a("eemeli-static" "transport/eemeli-graph.json") #a("compiler-static" "transport/compiler-graph.json"))
    (bind graph (read-json (get pair 1)))
    (bind edges #a())
    (bind missing #a())
    (bind edge-errors #a())
    (for-of row graph:modules
      (if row:error (missing:push (obj :specifier row:specifier :error row:error)))
      (for-of edge (?? row:dependencies #a())
        (edges:push (obj :from row:specifier :category (category row:specifier) :dependency edge))
        (for-of kind #a("code" "type")
          (bind resolution (get edge kind))
          (if (and resolution resolution:error)
            (edge-errors:push (obj :from row:specifier :specifier edge:specifier :kind kind :resolution resolution))))))
    (rows:push (obj :id (get pair 0) :roots graph:roots :modules graph:modules :edges edges :missing missing :edgeErrors edge-errors)))
  (bind runtime-row (get rows 0))
  (bind development-row (get rows 1))
  (ensure (= runtime-row:modules:length 67) "67 original runtime modules")
  (ensure (= development-row:missing:length 3) "three original unresolved development modules")
  (bind source-rows #a())
  (bind references #a())
  (for-of dir #a("upstream/std" "upstream/std-json" "upstream/std-jsonc" "upstream/js-yaml" "prior/upstream/eemeli" "source/export")
    (for-of path (walk dir)
      (bind bytes (Deno:read-file-sync path))
      (source-rows:push (obj :path path :bytes bytes:length :sha256 (await (digest bytes)) :category (category path)))
      (if (-> (regex "\\.(ts|js|mjs|json|rs|toml|yml|md)$|LICENSE$|NOTICE$") (:test path))
        (do
          (bind lines (-> (new TextDecoder) (:decode bytes) (:split "\n")))
          (for-of pair (Array:from (lines:entries))
            (if (-> (regex "import|require\\(|from |npm:|node:|license|copyright|Copyright|js-yaml|https:|dependencies|include_dir!|deno_args") (:test (get pair 1)))
              (references:push (obj :path path :line (+ (get pair 0) 1) :text (get pair 1) :category (category path)))))))))
  (bind changed (-> (Deno:read-text-file-sync "source/changed-paths.txt") (:trim) (:split "\n")))
  (ensure (= changed:length 30) "30 changed source paths")
  (bind interval #a())
  (for-of path changed
    (bind sha (await (digest (Deno:read-file-sync (template "source/export/" path)))))
    (bind origin (path:replace "crates/lykn-lang/embedded/" ""))
    (bind embedded (and (path:starts-with "crates/lykn-lang/embedded/") (exists (template "source/export/" origin))))
    (bind same (and embedded (= sha (await (digest (Deno:read-file-sync (template "source/export/" origin)))))))
    (interval:push (obj :path path :sha256 sha :category (category path) :embeddedSource (? embedded origin null) :embeddedIdentical same)))
  (bind cargo (read-json "source/cargo-metadata.json"))
  (bind npm (read-json "prior/upstream/eemeli/package-lock.json"))
  (bind inherited (read-json "inherited/db-inputs.json"))
  (bind yaml (read-json "inherited/yaml-inputs.json"))
  (bind document (yaml:variants:filter (fn (:object row) (= row:family "Y-14"))))
  (ensure (= inherited:originalCandidates:length 47) "47 original candidates")
  (ensure (= inherited:originalFm01:length 9) "nine verbatim R rows")
  (ensure (= inherited:expectedAttempts 103) "103 intended original attempts")
  (ensure (= document:length 28) "28 original gated document variants")
  (bind input-files #a())
  (for-of path (walk "inherited")
    (bind bytes (Deno:read-file-sync path))
    (input-files:push (obj :path path :bytes bytes:length :sha256 (await (digest bytes)))))
  (write-json "inputs.json" (obj :inputFiles input-files :originalCandidates inherited:originalCandidates :originalFm01 inherited:originalFm01
    :originalVariants inherited:variants :originalDispositions inherited:dispositions :originalResourceInputs inherited:inherited :documentVariants document
    :expectedOriginalAttempts inherited:expectedAttempts :auditSha256 (await (digest (Deno:read-file-sync "audit.lykn")))
    :packageRoots inventory:packages :graphRoots (rows:map (fn (:object row) (obj :id row:id :roots row:roots)))
    :nativeConfig (Deno:read-text-file-sync "project.json") :nativeLock (Deno:read-text-file-sync "deno.lock")))
  (write-json "dependency-graphs.json" (obj :packages inventory:packages :graphs rows :sourceFiles source-rows :references references :interval interval
    :upstreamRoots inventory:upstreamRoots :cargo cargo :eemeliNpmLock npm :checks (express checks)))
  (console:log (JSON:stringify (obj :checks (express checks) :sourceFiles source-rows:length :references references:length :interval interval:length
    :graphs (rows:map (fn (:object row) (obj :id row:id :modules row:modules:length :edges row:edges:length :missing row:missing :edgeErrors row:edgeErrors:length)))
    :packages (inventory:packages:map (fn (:object pkg) (obj :package pkg:package :exports (get (Object:keys pkg:exports) "length") :files pkg:files:length :edges pkg:edges:length
      :identical (get (pkg:files:filter (fn (:object file) (= file:correspondence "identical"))) "length")
      :different (get (pkg:files:filter (fn (:object file) (= file:correspondence "different"))) "length")
      :absent (get (pkg:files:filter (fn (:object file) (= file:correspondence "absent"))) "length")))))))))
(bind mode (get Deno:args 0))
(if (= mode "prepare") (await (prepare)))
(if (= mode "graphs") (await (graphs)))
