;; J2-M01 research harness. All runtime program logic is retained Lykn.
;; :any is intentional at the JSON/JS observation boundary, not an ADT claim.
(bind encoder (new TextEncoder))
(func emit :args (:string label :any value) :body
  (console:log (JSON:stringify #a(label value))))
(func hex :args (:any bytes) :returns :string :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(func unhex :args (:string text) :body
  (Uint8Array:from (?? (text:match (regex ".." "g")) #a())
    (fn (:string part) (Number:parse-int part 16))))
(func append-item :args (:array values :any item) :body (conj values item))
(func ensure :args (:boolean condition :string message) :body
  (if (not condition) (throw (new Error (template "INVARIANT: " message)))))
(func number-text :args (:any value) :returns :string :body
  (? (Object:is value (Number "-0")) "-0" (String value)))
(func inspect :args (:any value :object seen :number depth) :returns :object :body
  (if (> depth 260) (return (obj :kind "depth-bound")))
  (if (= value null) (return (obj :kind "null")))
  (bind kind (typeof value))
  (if (= kind "number") (return (obj :kind kind :value (number-text value) :finite (Number:is-finite value))))
  (if (not (= kind "object")) (return (obj :kind kind :value (String value))))
  (if (seen:has value) (return (obj :kind "reference" :id (seen:get value))))
  (bind id seen:size)
  (seen:set value id)
  (bind entries (-> (Object:keys value)
    (:map (fn (:string key) #a(key (inspect (get value key) seen (+ depth 1)))))))
  (obj :kind (Object:prototype:to-string:call value) :id id
    :length (? (Array:is-array value) value:length null) :entries entries))
(func tree :args (:any value) :body (inspect value (new Map) 0))
(func error-fact :args (:string stage :any err) :body
  (emit "error" (obj :stage stage :name err:name :message err:message)))
(func serialize :args (:any value) :body
  (emit "before" (tree value))
  (try
    (bind result (JSON:stringify value))
    (emit "serialized" (tree result))
    (if (= (typeof result) "string")
      (do (emit "outputHex" (hex (encoder:encode result)))
          (emit "reparsed" (tree (JSON:parse result)))))
    (catch err (error-fact "stringify" err))))
(func runtime-value :args (:string kind) :returns :any :body
  (cond
    ((= kind "undefined") undefined)
    ((= kind "function") (fn () 7))
    ((= kind "symbol") (Symbol "fixture"))
    ((= kind "nan") NaN)
    ((= kind "infinity") Infinity)
    ((= kind "minus-infinity") (- Infinity))
    ((= kind "bigint") (BigInt "1"))
    ((= kind "date") (new Date "2026-09-12T00:00:00.000Z"))
    ((= kind "map") (new Map #a(#a("x" 1))))
    ((= kind "set") (new Set #a(1 2)))
    ((= kind "sparse") (new Array 3))
    ((= kind "cycle")
      (do (bind value (obj))
          (Object:define-property value "self" (obj :value value :enumerable true))
          value))
    (:else (throw (new Error (template "Unknown runtime value " kind))))))
(func chunks :args (:string text :number size) :body
  (bind bytes (encoder:encode text))
  (bind width (? (= size 0) (Math:max 1 bytes:length) size))
  (Array:from (obj :length (Math:ceil (/ bytes:length width)))
    (fn (:any unused :number index) (bytes:slice (* index width) (* (+ index 1) width)))))
(func byte-stream :args (:any parts) :body
  (new ReadableStream (obj :start (fn (:any controller)
    (for-of part parts (controller:enqueue part))
    (controller:close)))))
(async (func drain :args (:any stream :boolean verbose) :body
  (bind reader (stream:get-reader))
  (bind count (cell 0))
  (try
    (bind item (cell (await (reader:read))))
    (while (not (get (express item) "done"))
      (bind current (express item))
      (? verbose (emit "record" (tree current:value)) undefined)
      (swap! count (fn (:number n) (+ n 1)))
      (reset! item (await (reader:read))))
    (emit "stream" (obj :status "complete" :count (express count)))
    (catch err
      (emit "stream" (obj :status "error" :count (express count)))
      (error-fact "stream" err))
    (finally (reader:release-lock)))
  (express count)))
(async (func package-stream :args (:string op :string text :number size :string framing :boolean verbose) :body
  (bind module (await (dynamic-import "@std/json")))
  (bind decoded (-> (byte-stream (chunks text size)) (:pipe-through (new TextDecoderStream))))
  (if (= op "concat")
    (return (await (drain (decoded:pipe-through (new module:ConcatenatedJsonParseStream)) verbose))))
  (bind lines-module (await (dynamic-import "@std/streams/text-line-stream")))
  (bind stream (? (= framing "lines")
    (decoded:pipe-through (new lines-module:TextLineStream))
    decoded))
  (await (drain (stream:pipe-through (new module:JsonParseStream)) verbose))))
(func materialize :args (:string data) :body
  (for-of item (JSON:parse data)
    (if item:directory
      (Deno:mkdir-sync item:path (obj :recursive true))
      (do
        (bind slash (item:path:last-index-of "/"))
        (Deno:mkdir-sync (item:path:slice 0 slash) (obj :recursive true))
        (Deno:write-file-sync item:path (unhex item:hex))))
    (if (Object:has-own item "mode") (Deno:chmod-sync item:path item:mode))))
(func file-case :args (:string mode) :body
  (bind destination "outputs/destination.json")
  (bind temporary "outputs/replacement.tmp")
  (bind stage (cell "read"))
  (try
    (bind source (Deno:read-text-file-sync (? (= mode "missing") "inputs/missing.json" "inputs/source.json")))
    (reset! stage "parse")
    (bind original (JSON:parse source))
    (emit "original" (tree original))
    (bind edited (assoc original :n 2))
    (ensure (and (= edited:name "Ada") (= edited:n 2) (= edited:nil null)
      (= (JSON:stringify edited:flags) "[true,false]")) "J-01 independent expected fields")
    (bind text (JSON:stringify edited))
    (reset! stage "write")
    (if (= mode "raw-interrupt")
      (do (bind raw (Deno:open-sync destination (obj :write true :truncate true)))
          (raw:write-sync (encoder:encode "{"))
          (raw:sync-sync)
          (emit "checkpoint" "raw-truncated")
          (while true)))
    (bind temp-path (cond
      ((= mode "missing-parent") "outputs/absent/replacement.tmp")
      ((= mode "unwritable") "outputs/locked/replacement.tmp")
      (:else temporary)))
    (bind file (Deno:open-sync temp-path (obj :write true :create-new true)))
    (try
      (bind bytes (encoder:encode text))
      (bind offset (cell 0))
      (while (< (express offset) bytes:length)
        (swap! offset + (file:write-sync (bytes:subarray (express offset)))))
      (file:sync-sync)
      (finally (file:close)))
    (if (= mode "safe-interrupt")
      (do (emit "checkpoint" "sibling-complete") (while true)))
    (reset! stage "rename")
    (if (= mode "rename-injected") (throw (new Error "injected-before-rename")))
    (Deno:rename-sync temp-path (? (= mode "rename-directory") "outputs/target-dir" destination))
    (emit "written" (tree (JSON:parse (Deno:read-text-file-sync destination))))
    (emit "inputUnchanged" (= source (Deno:read-text-file-sync "inputs/source.json")))
    (catch err
      (error-fact (express stage) err)
      (try (Deno:remove-sync temporary)
        (catch cleanup (emit "cleanup" (obj :name cleanup:name :message cleanup:message)))))))

(bind op (get Deno:args 0))
(bind a (?? (get Deno:args 1) ""))
(bind b (?? (get Deno:args 2) ""))
(bind c (?? (get Deno:args 3) ""))
(async (func dispatch :args () :body
  (if (= op "materialize") (materialize a))
  (if (= op "control-read") (console:log (Deno:read-text-file-sync "inputs/control.txt")))
  (if (= op "control-timeout") (do (emit "checkpoint" "busy-loop") (while true)))
  (if (= op "control-output") (while true (console:log (String:prototype:repeat:call "x" 1024))))
  (if (= op "control-rss") (await (new Promise (fn (:function resolve) (set-timeout resolve 3000)))))
  (if (= op "parse") (try (serialize (JSON:parse a)) (catch err (error-fact "parse" err))))
  (if (= op "reject-file")
    (try (bind value (JSON:parse a))
         (Deno:write-text-file-sync "outputs/destination.json" (JSON:stringify value))
         (throw (new Error "INVARIANT: malformed input accepted"))
         (catch err (error-fact "parse" err))))
  (if (= op "number")
    (do (bind value (JSON:parse a))
        (emit "token" a)
        (ensure (= (number-text value) b) "number representation")
        (emit "safeInteger" (Number:is-safe-integer value))
        (serialize value)))
  (if (= op "exact")
    (do
      (emit "tokenString" a)
      (if (-> (regex "^-?[0-9]+$") (:test a)) (emit "bigintFromToken" (tree (BigInt a))))
      (bind contexts (cell #a()))
      (JSON:parse a (fn (:string key :any value :any context)
        (swap! contexts append-item (obj :key key :source (? context (?? context:source "unavailable") "unavailable"))) value))
      (emit "reviverContexts" (express contexts))
      (emit "rawJSONType" (typeof JSON:rawJSON))
      (if (= (typeof JSON:rawJSON) "function")
        (try (emit "rawSerialized" (JSON:stringify (JSON:rawJSON a)))
          (catch err (error-fact "rawJSON" err))))))
  (if (= op "duplicates")
    (do (bind visits (cell #a()))
        (bind value (JSON:parse a (fn (:string key :any val)
          (swap! visits append-item key) val)))
        (emit "reviverKeys" (express visits))
        (serialize value)))
  (if (= op "presence")
    (do (bind value (JSON:parse a))
        (if (= b "undefined") (Object:define-property value "x" (obj :value undefined :enumerable true)))
        (emit "hasOwnX" (Object:has-own value "x"))
        (emit "x" (tree (get value "x")))
        (emit "nullishDefault" (tree (?? (get value "x") "DEFAULT")))
        (serialize value)))
  (if (= op "keys")
    (do (bind value (JSON:parse a))
        (bind edited (Object:from-entries (-> (Object:entries value)
          (:map (fn (:any entry) #a((get entry 0) (+ (get entry 1) 10)))))))
        (emit "keys" (Object:keys edited))
        (emit "inputPrototypeUnchanged" (= (Object:get-prototype-of value) Object:prototype))
        (emit "editedPrototypeUnchanged" (= (Object:get-prototype-of edited) Object:prototype))
        (for-of key (Object:keys value) (ensure (Object:has-own edited key) (template "missing key " key)))
        (serialize edited)))
  (if (= op "unsupported")
    (do (bind value (runtime-value a))
        (serialize (cond ((= b "object") (obj :x value)) ((= b "array") #a(value)) (:else value)))))
  (if (= op "order")
    (do (bind value (JSON:parse a))
        (bind first (JSON:stringify value null (Number c)))
        (bind second (JSON:stringify (JSON:parse b) null (Number c)))
        (ensure (= first (JSON:stringify value null (Number c))) "same object determinism")
        (emit "first" first) (emit "second" second)
        (emit "equal" (= first second))
        (emit "firstHex" (hex (encoder:encode first)))
        (emit "secondHex" (hex (encoder:encode second)))))
  (if (= op "decode")
    (do (bind bytes (unhex a))
        (emit "inputHex" a)
        (try
          (bind decoder (new TextDecoder "utf-8" (obj :fatal (= b "fatal"))))
          (bind text (? (= b "stream-1")
            (do (bind parts (cell #a()))
                (for-of byte bytes (swap! parts append-item (decoder:decode (Uint8Array:of byte) (obj :stream true))))
                (swap! parts append-item (decoder:decode))
                (-> (express parts) (:join "")))
            (decoder:decode bytes)))
          (emit "decoded" (tree text))
          (try (serialize (JSON:parse text)) (catch err (error-fact "parse" err)))
          (catch err (error-fact "decode" err)))))
  (if (= op "jsonc")
    (do (bind module (await (dynamic-import "@std/jsonc")))
        (bind value (module:parse a))
        (serialize (? (= b "edit") (assoc value :n 2) value))))
  (if (= op "canonical")
    (do (bind module (await (dynamic-import "@std/json")))
        (bind first (module:canonicalize (JSON:parse a)))
        (bind second (module:canonicalize (JSON:parse b)))
        (bind bytes (module:canonicalize-to-bytes (JSON:parse a)))
        (ensure (= first second) "canonical order invariance")
        (ensure (= (hex bytes) (hex (encoder:encode first))) "canonical bytes agree")
        (emit "canonical" first) (emit "canonicalHex" (hex bytes))))
  (if (= op "canonical-reject")
    (do (bind module (await (dynamic-import "@std/json")))
        (try (emit "unexpectedCanonical" (module:canonicalize (runtime-value a)))
             (catch err (error-fact "canonicalize" err)))))
  (if (or (= op "ndjson") (= op "concat")) (await (package-stream op a (Number b) c true)))
  (if (= op "stringify")
    (do (bind module (await (dynamic-import "@std/json")))
        (bind source (new ReadableStream (obj :start (fn (:any controller)
          (controller:enqueue (obj :n 1)) (controller:enqueue (obj :n 2)) (controller:close)))))
        (bind framed (source:pipe-through (new module:JsonStringifyStream
          (? (= a "rs") (obj :prefix (String:from-char-code 30) :suffix "\n") (obj)))))
        (bind response (new Response (framed:pipe-through (new TextEncoderStream))))
        (bind text (await (response:text)))
        (emit "framed" text) (emit "framedHex" (hex (encoder:encode text)))
        (bind parts (-> (text:split "\n") (:filter (fn (:string line) (> line:length 0)))))
        (bind records (parts:map (fn (:string line)
          (if (= b "valid")
            (return (? (= a "rs") (line:slice 1) line)))
          (? (= a "rs") (template "BAD" line) (template "BAD" line)))))
        (bind stream (new ReadableStream (obj :start (fn (:any controller)
          (for-of record records (controller:enqueue record)) (controller:close)))))
        (await (drain (stream:pipe-through (new module:JsonParseStream)) true))))
  (if (= op "stress")
    (do (bind size (Number b))
        (bind start (performance:now))
        (if (= a "records")
          (do (bind text (String:prototype:repeat:call "{\"n\":1}\n" size))
              (bind count (await (package-stream "ndjson" text 7 "lines" false)))
              (ensure (= count size) "stress record count"))
          (do (bind text (? (= a "depth")
                (template (String:prototype:repeat:call "[" size) "0" (String:prototype:repeat:call "]" size))
                (template "\"" (String:prototype:repeat:call "x" size) "\"")))
              (bind encoded (encoder:encode text))
              (ensure (<= encoded:length 9437184) "encoded input cap")
              (bind value (JSON:parse text))
              (if (= a "string") (ensure (= value:length size) "stress string length")
                (do (bind current (cell value)) (bind depth (cell 0))
                    (while (Array:is-array (express current))
                      (reset! current (get (express current) 0)) (swap! depth (fn (:number n) (+ n 1))))
                    (ensure (= (express depth) size) "stress depth")))
              (emit "inputBytes" encoded:length)))
        (emit "operationMs" (- (performance:now) start))
        (emit "stress" (obj :kind a :size size))))
  (if (= op "file") (file-case a))
  null))
(await (dispatch))
