;; CDC evidence audit, separate from the format implementation.
(bind checks (cell 0))
(func ensure :args (:boolean ok :string label) :body
  (swap! checks (fn (:number n) (+ n 1)))
  (if (not ok) (throw (new Error label))))
(func records :args (:string path) :body
  (-> (Deno:read-text-file-sync path) (:trim) (:split "\n")
    (:filter (fn (:string line) (> line:length 0)))
    (:map (fn (:string line) (JSON:parse line)))))
(func key :args (:object row) :body (template row:id "/" row:attempt))
(func hex :args (:any bytes) :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(func unhex :args (:string text) :body
  (Uint8Array:from (?? (text:match (regex ".." "g")) #a())
    (fn (:string part) (Number:parse-int part 16))))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func facts :args (:object row) :body
  (new Map (-> row:stdout (:trim) (:split "\n")
    (:filter (fn (:string line) (> line:length 0)))
    (:map (fn (:string line) (JSON:parse line))))))
(func canonical-files :args (:array rows) :body
  (JSON:stringify (rows:to-sorted (fn (:object a :object b) (a:path:locale-compare b:path)))))
(bind manifest (JSON:parse (Deno:read-text-file-sync "inputs.json")))
(bind variants (new Map (manifest:variants:map (fn (:object spec) #a(spec:id spec)))))
(bind all (cell #a()))
(for-of group #a("native" "package" "stress")
  (bind original (new Map (-> (records (template "cc-" group ".jsonl"))
    (:map (fn (:object row) #a((key row) row))))))
  (bind current (records (template group ".jsonl")))
  (ensure (= current:length original:size) (template group " count"))
  (for-of row current
    (bind id (key row))
    (bind old (original:get id))
    (ensure (not (= old undefined)) (template id " unexpected ID"))
    (ensure (= row:exit old:exit) (template id " exit"))
    (ensure (= row:stopReason old:stopReason) (template id " termination"))
    (ensure (= row:survivors:length 0) (template id " survivors"))
    (ensure (= row:sourceSha256 "5c024493b3bdab99a04e5844ed001cdd20825d6fd06d1cd3b24e322cdf1aca25") (template id " source"))
    (ensure (= row:compiledSha256 "a528ce3038f0e1989f66ddaf49b6154e4e226e2a25866dc30d2166176de446f2") (template id " compiled"))
    (ensure (= row:stdoutSha256 (await (digest (unhex row:stdoutHex)))) (template id " stdout digest"))
    (ensure (= row:stderrSha256 (await (digest (unhex row:stderrHex)))) (template id " stderr digest"))
    (ensure (= (canonical-files row:inputState) (canonical-files row:inputAfter)) (template id " input mutation"))
    (ensure (= (canonical-files row:outputAfter) (canonical-files old:outputAfter)) (template id " output effects"))
    (if (not (= group "stress"))
      (ensure (= row:stdout old:stdout) (template id " observation drift")))
    (for-of state row:outputAfter
      (if (Object:has-own state "hex")
        (ensure (= state:sha256 (await (digest (unhex state:hex)))) (template id " file digest"))))
    (bind spec (variants:get row:id))
    (ensure (= spec:phase group) (template id " phase"))
    (ensure (<= row:attempt spec:repeats) (template id " repeat range")))
  (swap! all (fn (:array old) (old:concat current))))
(bind first (new Map (-> (express all) (:filter (fn (:object row) (= row:attempt 1)))
  (:map (fn (:object row) #a(row:id row))))))
(func fact :args (:string id :string field) :body (bind data (facts (first:get id))) (data:get field))
(ensure (= first:size 161) "unique variants")
(for-of spec manifest:variants
  (ensure (= (-> (express all) (:filter (fn (:object row) (= row:id spec:id))) (get "length")) spec:repeats) (template spec:id " complete repeats")))
(ensure (= (get (fact "J-04-3" "before") "value") "9007199254740992") "rounded integer")
(ensure (= (get (fact "J-04-9" "before") "value") "-0") "negative zero retained before serialization")
(ensure (= (get (fact "J-04-9" "serialized") "value") "0") "negative zero serialization loss")
(for-of id #a("J-06-top" "J-06-nested" "J-06-escaped")
  (ensure (not (= (fact id "serialized") undefined)) (template id " duplicate observation")))
(for-of pos #a("top" "object" "array")
  (for-of kind #a("bigint" "cycle")
    (ensure (= (get (fact (template "J-09-" kind "-" pos) "error") "name") "TypeError") "unsupported throws")))
(ensure (= (fact "J-07-absent" "hasOwnX") false) "absent")
(ensure (= (fact "J-07-undefined" "hasOwnX") true) "own undefined")
(ensure (= (get (fact "J-07-null" "x") "kind") "null") "null")
(for-of id #a("J-03-1" "J-03-2" "J-03-3" "J-03-4" "J-03-5" "J-03-6")
  (ensure (= (get (fact id "error") "name") "SyntaxError") "strict rejection"))
(ensure (= (get (fact "J-14-mixed-1" "stream") "count") 7) "mixed scalar framing")
(ensure (= (get (fact "J-14-truncated-1" "stream") "count") 1) "retained prefix")
(ensure (= (get (fact "J-15-rs-wrong-framing" "stream") "status") "error") "bad frame")
(for-of row (records "controls.jsonl")
  (ensure (= row:exit 137) "control exit")
  (ensure (= row:survivors:length 0) "control survivors")
  (ensure (> row:maxSampledTreeRssKiB 0) "control observation"))
(for-of row (records "stress.jsonl")
  (bind data (facts row))
  (bind observed (data:get "stress"))
  (bind spec (variants:get row:id))
  (ensure (= observed:kind (get spec:args 0)) "stress kind")
  (ensure (= observed:size (Number (get spec:args 1))) "stress size"))
(bind byte-lines (-> (Deno:read-text-file-sync "byte-evidence.md") (:split "\n")))
(bind byte-count (cell 0))
(for-of line byte-lines
  (bind matched (line:match (regex "^(?:Original|Observed): ([0-9]+) bytes; SHA-256 `([0-9a-f]+)`; hex `([0-9a-f]*)`")))
  (if matched
    (do
      (bind bytes (unhex (get matched 3)))
      (ensure (= bytes:length (Number (get matched 1))) "byte table length")
      (ensure (= (await (digest bytes)) (get matched 2)) "byte table hash")
      (swap! byte-count (fn (:number n) (+ n 1))))))
(console:log (JSON:stringify (obj :checks (express checks) :attempts (get (express all) "length") :variants first:size :byteRecords (express byte-count) :result "pass")))
