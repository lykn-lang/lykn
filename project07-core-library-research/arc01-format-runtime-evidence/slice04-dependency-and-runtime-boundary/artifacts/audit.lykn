;; SH native manifest, semantic verification and lossless evidence tools.
(bind encoder (new TextEncoder))
(bind decoder (new TextDecoder "utf-8" (obj :fatal true)))
(bind checks (cell 0))
(func ensure :args (:boolean ok :string label) :body
  (swap! checks + 1)
  (if (not ok) (throw (new Error label)))
  null)
(func read-json :args (:string path) :body (JSON:parse (Deno:read-text-file-sync path)))
(func write-json :args (:string path :any value) :body (Deno:write-text-file-sync path (template (JSON:stringify value null 2) "\n")))
(func hex :args (:any bytes) :body (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(async (func digest :args (:any bytes) :body (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func unhex :args (:string text) :body
  (ensure (and (= (% text:length 2) 0) (-> (regex "^[0-9a-f]*$") (:test text))) "valid hex")
  (Uint8Array:from (?? (text:match (regex ".." "g")) #a()) (fn (:string p) (Number:parse-int p 16))))
(func safe-path :args (:string path) :body
  (and (> path:length 0) (not (path:starts-with "/")) (not (path:includes "\\")) (not (-> (path:split "/") (:includes "..")))))
(func lines :args (:string text) :body
  (-> text (:split "\n") (:filter (fn (:string line) (> line:length 0))) (:map (fn (:string line) (JSON:parse line)))))
(bind native-config "{}\n")
(bind native-lock "{\"version\":\"5\"}\n")
(async (func freeze :args () :body
  (bind cli (-> (Deno:read-text-file-sync "compiler-path.txt") (:trim)))
  (bind rows #a())
  (func add :args (:string id :string group :string op :object options) :body
    (rows:push (Object:assign (obj :id id :group group :op op :condition "none" :flags #a() :repeats 2 :expectedExit 0 :expectedStop null
      :wallMs 9000 :deadlineMs 10000 :outputBytes 16777216 :rssKiB 524288 :sampleCap 512 :processCap 32 :errorCap 16
      :owner "Arc03/Slice07" :stopFamily group :reentry "Retain failed condition; named correction, gated sources, fresh roots and controls before retry") options))
    null)
  (add "SH-CAP-wall" "controls" "control-timeout" (obj :repeats 1 :wallMs 500 :expectedStop "wall"))
  (add "SH-CAP-output" "controls" "control-output" (obj :repeats 1 :outputBytes 65536 :expectedStop "output"))
  (add "SH-CAP-rss" "controls" "control-rss" (obj :repeats 1 :rssKiB 1 :sourcePaddingForms 25000 :expectedStop "rss"))
  (add "SH-CAP-parent-exit" "controls" "pipe-parent" (obj :repeats 1 :wallMs 1500 :expectedStop "wall"
    :flags #a("--allow-read=./outputs" "--allow-write=./outputs" (template "--allow-run=" cli))))
  (add "SH-CAP-observation" "controls" "control-timeout" (obj :repeats 1 :injectObservation true :expectedStop "observation"))
  (for-of op #a("minimal" "parser") (add (template "SH-NATIVE-" op) "native" op (obj)))
  (for-of op #a("read" "write")
    (add (template "SH-NATIVE-" op "-allowed") "native" op (obj :flags #a((template "--allow-" op "=./" (? (= op "read") "inputs/input.txt" "outputs/write.txt")))))
    (add (template "SH-NATIVE-" op "-denied") "native" op (obj :expectedExit 1 :denied true)))
  (for-of op #a("env" "net" "run") (add (template "SH-NATIVE-" op "-denied") "native" op (obj :expectedExit 1 :denied true)))
  (for-of pair #a(#a("SH-OBSERVER-partial" "raw-reader") #a("SH-CONCURRENT-reader" "reader") #a("SH-CONCURRENT-two-writers" "two-writers"))
    (add (get pair 0) "observers" "replace" (obj :condition (get pair 1) :flags #a("--allow-read=./outputs" "--allow-write=./outputs" (template "--allow-run=" cli)))))
  (for-of point #a("before" "after")
    (add (template "SH-CANCEL-" point) "cancellation" "replace" (obj :condition (template "cancel-" point) :expectedStop "checkpoint"
      :flags #a("--allow-read=./outputs" "--allow-write=./outputs"))))
  (bind sources (obj))
  (for-of name #a("cases.lykn" "supervisor.lykn" "audit.lykn")
    (Object:define-property sources name (obj :value (await (digest (Deno:read-file-sync name))) :enumerable true)))
  (ensure (= rows:length 19) "19 exact variants")
  (write-json "inputs.json" (obj :protocol "SH01/RP01" :utc (-> (new Date) (:toISOString)) :sources sources :variants rows
    :config native-config :lock native-lock :cache "empty private native cache per attempt" :stdin "null" :environment "cleared; exact overrides recorded per child"
    :expectedAttempts 33 :negativeAudit #a("missing-observation" "checkpoint-bytes" "denial-class" "survivor" "lock-mismatch")
    :fixtures (obj :input "INPUT\n" :old "ORIGINAL\n" :write "WRITTEN\n" :candidateUnits 65536 :candidateSuffix "LF" :partialBytes 32768 :maxWorkers 3 :readerSamples 512 :internalMs 5000 :pollMs 10)
    :inspection (obj :depth 256 :visits 4096 :nodes 2048 :members 2048 :strings 4096 :binary 4096 :inputBytes 8388608 :encodedInputBytes 9437184)
    :scope "native tooling only; all DB/R, 36 unsupported Y-13 and 28 gated Y-14 remain owned by Slice04 and its downstream owners"))
  (console:log (JSON:stringify (obj :result "frozen" :variants rows:length :attempts 33 :checks (express checks))))))
(async (func verify :args (:object record :boolean live) :body
  (bind spec record:spec)
  (bind manifest (read-json "inputs.json"))
  (bind frozen (manifest:variants:find (fn (:object row) (= row:id spec:id))))
  (ensure (= (JSON:stringify frozen) (JSON:stringify spec)) "frozen variant")
  (ensure (= record:stopReason spec:expectedStop) "expected stop")
  (ensure (= record:survivors:length 0) "no survivors")
  (ensure (and record:streamsClosed record:rootExited (< record:wallMs spec:deadlineMs)) "bounded complete drain")
  (ensure (not record:drainCancelled) "natural stream drain after stop")
  (ensure (and (> record:samples:length 0) (<= record:samples:length spec:sampleCap) (> record:maxRssKiB 0)) "observations present and bounded")
  (ensure (<= record:errors:length spec:errorCap) "bounded errors")
  (ensure (not record:errorsCapped) "error evidence not truncated")
  (ensure (<= record:retainedBytes spec:outputBytes) "bounded retained output")
  (ensure (and (= record:configBefore spec:config) (= record:configAfter spec:config)) "exact variant config")
  (ensure (and (= record:lockBefore spec:lock) (= record:lockAfter spec:lock)) "matching unchanged lock")
  (ensure (= (await (digest (unhex record:stdoutHex))) record:stdoutSha256) "stdout bytes")
  (ensure (= (await (digest (unhex record:stderrHex))) record:stderrSha256) "stderr bytes")
  (for-of kill record:kills
    (ensure (> kill:targets:length 0) "nonempty kill targets")
    (for-of target kill:targets (ensure (> target:birth:length 0) "identity checked before kill")))
  (for-of file record:files
    (ensure (safe-path file:path) "safe fixture path")
    (ensure (= (await (digest (unhex file:hex))) file:sha256) "retained fixture hash")
    (if live
      (do (bind path (template record:cwd "/" file:path))
        (if (not (= file:kind "directory"))
          (ensure (= (await (digest (Deno:read-file-sync path))) file:sha256) "live fixture bytes"))
        (ensure (= (get (Deno:lstat-sync path) "mode") file:mode) "live fixture mode")
        (if (= file:kind "symlink") (ensure (= (Deno:read-link-sync path) file:linkTarget) "live link target")))))
  (bind events (? (or (= spec:op "control-output") spec:transport (= spec:resolution "cold")) #a() (lines (decoder:decode (unhex record:stdoutHex)))))
  (func event :args (:string name) :body
    (bind found (events:find (fn (:object row) (= row:event name))))
    (ensure (not (= found undefined)) (template "event " name))
    found)
  (func file :args (:string path) :body
    (bind found (record:files:find (fn (:object row) (= row:path path))))
    (ensure (not (= found undefined)) (template "file " path))
    found)
  (bind old-hash (await (digest (encoder:encode "ORIGINAL\n"))))
  (bind a-hash (await (digest (encoder:encode (template (String:prototype:repeat:call "A" 65536) "\n")))))
  (bind b-hash (await (digest (encoder:encode (template (String:prototype:repeat:call "B" 65536) "\n")))))
  (ensure (= (get (file "inputs/input.txt") "sha256") (await (digest (encoder:encode "INPUT\n")))) "input unchanged")
  (if (= spec:condition "new") (ensure (= record:before:length 0) "new destination absent")
    (if (= spec:condition "directory")
      (ensure (= (get (get record:before 1) "hex") (hex (encoder:encode "SENTINEL\n"))) "directory sentinel before")
      (ensure (= (get (get record:before 0) "sha256") old-hash) "original destination")))
  (if (= spec:group "native") (ensure (= (get (file "outputs/destination.txt") "sha256") old-hash) "native destination unchanged"))
  (if live
    (ensure (= record:sourceSha256 (await (digest (Deno:read-file-sync (template record:cwd "/cases.lykn"))))) "live source hash"))
  (if (and (= spec:expectedStop null) (not (= spec:expectedExit null))) (ensure (= record:exit spec:expectedExit) "expected exit"))
  (if spec:denied
    (do (ensure (= (get (event "uncaught-operation") "name") "NotCapable") "actual denial")
      (ensure (not (record:files:some (fn (:object f) (= f:path "outputs/write.txt")))) "denied write absent")))
  (if (and (= spec:group "native") (not spec:denied))
    (do
      (bind row (event spec:op))
      (if (= spec:op "minimal") (ensure (= row:value 42) "minimal value"))
      (if (= spec:op "parser")
        (do (ensure (= row:value:n 1) "parsed value")
          (if (= spec:entry "package.lykn")
            (do (ensure (= row:packages:jsonc:n 1) "JSONC package smoke")
              (ensure (= (JSON:stringify row:packages:streams) "[\"object\",\"object\"]") "stream constructors")))))
      (if (= spec:op "read") (ensure (= row:text "INPUT\n") "read bytes"))
      (if (= spec:op "write") (ensure (= (get (file "outputs/write.txt") "hex") (hex (encoder:encode "WRITTEN\n"))) "write bytes"))))
  (if (= spec:group "observers")
    (do
      (bind workers (events:filter (fn (:object e) (= e:event "worker-result"))))
      (ensure (= workers:length (? (= spec:condition "two-writers") 3 2)) "worker count")
      (for-of worker workers (ensure (= worker:exit 0) "worker exit"))
      (bind reader (workers:find (fn (:object w) (= w:role "reader"))))
      (bind observed (-> (lines reader:stdout) (:find (fn (:object r) (= r:event "reader-complete"))) (get "samples")))
      (ensure (and (> observed:length 1) (<= observed:length 512)) "in-window observations")
      (for-of kind (? (= spec:condition "two-writers") #a("old" "a" "b") #a("old" "a"))
        (ensure (observed:some (fn (:object r) (= r:kind kind))) (template "seen " kind)))
      (if (= spec:condition "raw-reader")
        (ensure (observed:some (fn (:object r) (and (= r:kind "partial") (= r:bytes 32768)))) "partial detection")
        (ensure (observed:every (fn (:object r) (not (= r:kind "partial")))) "no observed partial replacement"))
      (ensure (= (get (file "outputs/destination.txt") "sha256") (? (= spec:condition "two-writers") b-hash a-hash)) "final candidate")
      (event "concurrent-complete")))
  (if (= spec:group "files")
    (do
      (bind destination (file "outputs/destination.txt"))
      (if (spec:condition:starts-with "inject-")
        (do (bind fault (event "operation-error"))
          (ensure (= fault:stage (spec:condition:slice 7)) "exact injected stage")
          (ensure (and fault:injected (= fault:name "Error")) "injected error identity")
          (ensure (= destination:sha256 old-hash) "injection preserves destination")
          (if (= spec:condition "inject-open")
            (ensure (not (record:files:some (fn (:object f) (= f:path "outputs/replacement.tmp")))) "open injection leaves no orphan")
            (ensure (= (get (file "outputs/replacement.tmp") "bytes") (? (= spec:condition "inject-write") 0 65537)) "injection orphan stage"))))
      (if (-> #a("new" "existing" "symlink" "mode") (:includes spec:condition))
        (do (event "replaced")
          (bind prepared (event "prepared"))
          (ensure (= (prepared:writes:reduce (fn (:number n :number value) (+ n value)) 0) 65537) "complete write loop")
          (ensure (prepared:writes:every (fn (:number n) (and (> n 0) (<= n 4096)))) "bounded writes")
          (ensure (= destination:sha256 a-hash) "replacement bytes")
          (ensure (= destination:kind "file") "replacement regular file")
          (ensure (= (% destination:mode 512) 384) "replacement mode 0600")
          (if (= spec:condition "mode") (ensure (= (% (get (get record:before 0) "mode") 512) 416) "original mode 0640"))
          (if (= spec:condition "symlink")
            (do (ensure (record:before:some (fn (:object f) (and (= f:kind "symlink") (= f:linkTarget "target.txt")))) "original isolated symlink")
              (ensure (= (get (file "outputs/target.txt") "sha256") old-hash) "link target unchanged")))))
      (if (= spec:condition "directory")
        (do (bind fault (event "operation-error"))
          (ensure (and (= fault:stage "rename") (not fault:injected)) "real rename OS error")
          (ensure (= destination:kind "directory") "directory retained")
          (ensure (= (get (file "outputs/destination.txt/sentinel.txt") "hex") (hex (encoder:encode "SENTINEL\n"))) "directory sentinel retained")
          (ensure (= (get (file "outputs/replacement.tmp") "sha256") a-hash) "complete OS-error orphan")))
      (if (= spec:condition "cross-filesystem")
        (do (bind fault (event "operation-error"))
          (ensure (and (= fault:stage "rename") (not fault:injected)) "real cross-filesystem error")
          (ensure (-> (regex "cross.device|cross-device|Cross-device" "i") (:test fault:message)) "cross-device diagnosis")
          (ensure (= destination:sha256 old-hash) "cross-device original retained")
          (ensure (= record:crossFile:sha256 a-hash) "cross-device complete orphan")
          (if live (ensure (= (await (digest (Deno:read-file-sync record:crossFile:path))) a-hash) "live cross-device orphan"))
          (ensure (not (= record:crossFile:stat:dev destination:device)) "distinct filesystem devices")))))
  (if (= spec:group "resources")
    (do (bind row (event "resource"))
      (bind expected (template (? (= spec:resource "yaml-stringify") ">-\n  " "") (String:prototype:repeat:call "x" 1048576) (? (= spec:resource "yaml-stringify") "\n" "")))
      (ensure (= row:units expected:length) "resource units")
      (ensure (= row:sha256 (await (digest (encoder:encode expected)))) "resource complete hash")
      (ensure (and (>= row:stageMs 0) (>= row:setupMs 0)) "separate measured stages")
      (ensure (= row:inputSha256 (get (file "inputs/resource.txt") "sha256")) "resource input hash")))
  (if (= spec:resolution "cold")
    (do (ensure (= record:exit 1) "cold-cache exit")
      (ensure (-> (decoder:decode (unhex record:stderrHex)) (:includes "cached")) "actual empty cached-only failure")
      (ensure (= record:stdoutHex "") "no cold package evaluation")))
  (if spec:transport
    (do
      (bind output (decoder:decode (unhex record:stdoutHex)))
      (bind diagnostic (template output (decoder:decode (unhex record:stderrHex))))
      (if (= spec:resolution "prefetch")
        (do (ensure (= record:exit 0) "prefetch exit")
          (bind graph (JSON:parse output))
          (ensure (= graph:modules:length 67) "all-export prefetch graph")
          (for-of module graph:modules
            (ensure (and (not module:error) (not (= module:kind "node")) (not (= module:kind "npm"))) "permitted prefetch module")))
        (do
          (bind pattern (cond ((= spec:resolution "alias") "not a dependency|not prefixed|not in import map")
            ((= spec:resolution "missing-subpath") "no-such-db-subpath")
            ((= spec:resolution "missing-package") "no-such-db-package")
            (:else "integrity|checksum")))
          (ensure (-> (new RegExp pattern "i") (:test diagnostic)) "intended resolution fault")
          (ensure (or (not (= record:exit 0)) (diagnostic:includes "\"error\"")) "actual resolution rejection")))))
  (if (= spec:expectedStop "checkpoint")
    (do
      (ensure (not (= record:checkpoint null)) "checkpoint observed")
      (ensure (= record:checkpoint:sha256 a-hash) "checkpoint bytes")
      (ensure (= record:checkpoint:bytes 65537) "checkpoint length")
      (ensure (= (get (file "outputs/destination.txt") "sha256") (? (= spec:condition "cancel-before") old-hash a-hash)) "cancellation destination")
      (if (= spec:condition "cancel-before") (ensure (= (get (file "outputs/replacement.tmp") "sha256") a-hash) "orphan retained"))))
  (if (= spec:id "SH-CAP-rss") (ensure (= record:compiled null) "early stop before compiled output"))
  (if (= spec:id "SH-CAP-output")
    (do (ensure (> record:observedBytes spec:outputBytes) "actual output cap")
      (ensure (-> (decoder:decode (unhex record:stdoutHex)) (:includes (String:prototype:repeat:call "x" 1024))) "actual output loop bytes")))
  (if (= spec:id "SH-CAP-observation")
    (ensure (record:errors:some (fn (:object e) (= e:message "SH_INJECTED_OBSERVATION_FAILURE"))) "injected observation error"))
  (if (= spec:id "SH-CAP-parent-exit")
    (do (event "parent-exit") (ensure record:pipeHeldAfterExit "pipe retained after root exit")
      (ensure (> record:nestedPid 0) "registered nested PID")))
  (console:log (JSON:stringify (obj :result "verified" :id spec:id :attempt record:attempt :live live :checks (express checks))))))
(async (func negative-controls :args () :body
  (for-of group #a("controls" "native" "observers" "cancellation" "files" "resources" "resolution" "prefetch")
    (ensure (get (read-json (template group ".verified")) "semanticAudit") "positive groups verified first"))
  (Deno:mkdir-sync "negative")
  (bind results #a())
  (for-of name (get (read-json "inputs.json") "negativeAudit")
    (bind id (cond ((= name "missing-observation") "HP-partial-observer") ((= name "checkpoint-bytes") "R-07-cancel-before") ((= name "denial-class") "R-05-read-denied") (:else "R-01-minimal")))
    (bind record (read-json (template "runs/" id "-1/record.json")))
    (bind expected (cell ""))
    (if (= name "missing-observation")
      (do (Object:assign record (obj :samples #a())) (reset! expected "observations present and bounded")))
    (if (= name "checkpoint-bytes")
      (do (Object:assign record:checkpoint (obj :sha256 "deliberately wrong")) (reset! expected "checkpoint bytes")))
    (if (= name "denial-class")
      (do
        (bind bytes (encoder:encode (template (JSON:stringify (obj :event "uncaught-operation" :name "NotFound" :message "synthetic negative audit copy")) "\n")))
        (Object:assign record (obj :stdoutHex (hex bytes) :stdoutSha256 (await (digest bytes))))
        (reset! expected "actual denial")))
    (if (= name "survivor")
      (do (Object:assign record (obj :survivors #a((obj :pid 999999 :birth "synthetic; never killed")))) (reset! expected "no survivors")))
    (if (= name "lock-mismatch")
      (do (Object:assign record (obj :lockAfter "{}\n")) (reset! expected "matching unchanged lock")))
    (write-json (template "negative/" name ".json") record)
    (bind caught (cell null))
    (try (await (verify record false)) (catch err (reset! caught err:message)))
    (ensure (= (express caught) (express expected)) (template "negative rejected for intended reason: " name))
    (results:push (obj :name name :synthetic true :expected (express expected) :rejected (express caught))))
  (write-json "negative/results.json" results)
  (console:log (JSON:stringify (obj :result "negative-controls-passed" :count results:length :checks (express checks))))))
(async (func report :args () :body
  (bind manifest (read-json "inputs.json"))
  (bind results #a())
  (for-of spec manifest:variants
    (bind attempt (cell 1))
    (while (<= (express attempt) spec:repeats)
      (bind path (template "runs/" spec:id "-" (express attempt) "/record.json"))
      (bind record (read-json path))
      (await (verify record false))
      (results:push (obj :id spec:id :attempt (express attempt) :group spec:group :exit record:exit :stop record:stopReason :wallMs record:wallMs :maxRssKiB record:maxRssKiB :samples record:samples:length))
      (swap! attempt + 1)))
  (ensure (= results:length manifest:expectedAttempts) "complete attempt set")
  (bind negatives (read-json "negative/results.json"))
  (ensure (= negatives:length 5) "five negative controls")
  (for-of row negatives (ensure (= row:expected row:rejected) "negative rejection"))
  (write-json "summary.json" (obj :attempts results :negativeControls negatives :checks (express checks)))
  (console:log (JSON:stringify (obj :result "complete" :attempts results:length :negativeControls negatives:length :checks (express checks))))))
(async (func gzip-bytes :args (:any bytes :boolean encode) :body
  (bind blob (new Blob #a(bytes)))
  (bind stream (blob:stream))
  (bind transform (? encode (new CompressionStream "gzip") (new DecompressionStream "gzip")))
  (bind output (stream:pipe-through transform))
  (bind response (new Response output))
  (new Uint8Array (await (response:array-buffer)))))
(async (func capture :args (:string mode :string path :string dest) :body
  (if (= mode "extract")
    (do
      (bind seen (new Set))
      (for-of row (lines (Deno:read-text-file-sync path))
        (ensure (and (safe-path row:file) (not (seen:has row:file))) "unique safe path")
        (seen:add row:file)
        (bind stored (unhex row:hex))
        (bind bytes (? (= row:encoding "gzip-hex") (await (gzip-bytes stored false)) stored))
        (ensure (and (= bytes:length row:bytes) (= (await (digest bytes)) row:sha256)) "packet bytes")
        (bind full (template dest "/" row:file))
        (Deno:mkdir-sync (full:slice 0 (full:last-index-of "/")) (obj :recursive true))
        (Deno:write-file-sync full bytes (obj :createNew true)))
      (console:log (JSON:stringify (obj :result "extracted" :files seen:size :checks (express checks))))))
  (if (= mode "pack")
    (do
      (bind output (Deno:open-sync path (obj :write true :createNew true)))
      (bind count (cell 0))
      (bind total (cell 0))
      (async (func visit :args (:string dir) :body
        (for-of entry (Deno:read-dir-sync dir)
          (bind name (template dir "/" entry:name))
          (if entry:is-directory (await (visit name))
            (do
              (ensure (not entry:is-symlink) "no packet symlink")
              (bind bytes (Deno:read-file-sync name))
              (swap! total + bytes:length)
              (ensure (and (<= bytes:length 67108864) (< (express total) 536870912)) "packet budget")
              (bind compressed (await (gzip-bytes bytes true)))
              (bind encoded (encoder:encode (template (JSON:stringify (obj :file (name:slice 2) :bytes bytes:length :sha256 (await (digest bytes)) :encoding "gzip-hex" :hex (hex compressed))) "\n")))
              (bind offset (cell 0))
              (while (< (express offset) encoded:length)
                (bind written (output:write-sync (encoded:subarray (express offset))))
                (ensure (> written 0) "packet write progress")
                (swap! offset + written))
              (swap! count + 1))))
        null))
      (await (visit "./payload"))
      (output:close)
      (console:log (JSON:stringify (obj :result "packed" :files (express count) :bytes (express total) :checks (express checks))))))
  null))
(bind mode (get Deno:args 0))
(if (= mode "freeze") (await (freeze)))
(if (= mode "verify") (await (verify (read-json (get Deno:args 1)) (= (get Deno:args 2) "live"))))
(if (= mode "negative") (await (negative-controls)))
(if (= mode "report") (await (report)))
(if (or (= mode "pack") (= mode "extract")) (await (capture mode (get Deno:args 1) (?? (get Deno:args 2) ""))))
