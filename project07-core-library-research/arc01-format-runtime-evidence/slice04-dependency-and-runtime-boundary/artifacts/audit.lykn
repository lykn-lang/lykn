;; DB01: generation, static inventory and captured-evidence checks are Lykn.
(bind encoder (new TextEncoder))
(bind decoder (new TextDecoder "utf-8" (obj :fatal true)))
(bind checks (cell 0))
(func ensure :args (:boolean ok :string label) :body
  (swap! checks + 1)
  (if (not ok) (throw (new Error label)))
  null)
(func hex :args (:any bytes) :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func read-json :args (:string path) :body (JSON:parse (Deno:read-text-file-sync path)))
(func write-json! :args (:string path :any value) :body
  (Deno:write-text-file-sync path (template (JSON:stringify value null 2) "\n")))
(func put! :args (:object target :string key :any value) :body
  (Object:define-property target key (obj :value value :enumerable true :writable true :configurable true)))
(bind packages #a("std/json/1.1.0" "std/jsonc/1.0.2" "std/yaml/1.2.0" "std/streams/1.1.2" "eemeli/yaml/2.9.1"))
(func transport-list :args () :body
  (for-of pkg packages
    (bind meta (read-json (template "published/" pkg "/meta.json")))
    (for-of path (Object:keys meta:manifest)
      (ensure (and (path:starts-with "/") (not (path:includes "..")) (not (path:includes "\t"))) "safe published path")
      (console:log (template "https://jsr.io/@" pkg path "\t" "published/" pkg path))))
  null)
(bind rows #a())
(func add! :args (:string id :string group :string op :object options) :body
  (bind defaults (obj :id id :family (id:slice 0 4) :owner "Slice04" :group group :op op
    :entry "cases.lykn" :repeats 2 :flags #a() :input "synthetic constants in cases.lykn"
    :config "{}\n" :cache "fresh-empty" :lock "retained merged pins, copied before each attempt"
    :expected "characterize actual event, bytes and errors; no universal guarantee"
    :wallMs 10000 :outputBytes 16777216 :rssKiB 524288 :stopFamily (id:slice 0 4)
    :stop "cap or invalid observation: stop family, preserve owed repeats and re-entry"
    :reentry "Diagnose retained condition; approved protocol, gated sources, fresh roots and controls before retry"))
  (rows:push (Object:assign defaults options))
  null)
(async (func freeze :args () :body
  (bind config (obj :imports (obj)))
  (for-of pair #a(#a("@std/json" "jsr:@std/json@1.1.0") #a("@std/jsonc" "jsr:@std/jsonc@1.0.2") #a("@std/yaml" "jsr:@std/yaml@1.2.0") #a("@std/streams" "jsr:@std/streams@1.1.2"))
    (put! config:imports (get pair 0) (get pair 1)))
  (write-json! "project.json" config)
  (bind json-lock (read-json "json.lock"))
  (bind yaml-lock (read-json "yaml.lock"))
  (bind lock (obj :version "5" :specifiers (Object:assign (obj) json-lock:specifiers yaml-lock:specifiers)
    :jsr (Object:assign (obj) json-lock:jsr yaml-lock:jsr)
    :workspace (obj :dependencies (Object:values config:imports))))
  (write-json! "deno.lock" lock)
  (bind source (Deno:read-text-file-sync "cases.lykn"))
  (bind parser "(import \"@std/yaml\" ((alias parse selected-parse) (alias stringify selected-stringify)))\n(import \"@std/json\" (canonicalize JsonParseStream))\n(import \"@std/jsonc\" ((alias parse jsonc-parse)))\n(import \"@std/streams\" (TextLineStream))\n(func package-smoke :args () :body (obj :json (canonicalize (obj :b 2 :a 1)) :jsonc (jsonc-parse \"{/*comment*/\\\"n\\\":1,}\") :streams #a((typeof (new JsonParseStream)) (typeof (new TextLineStream)))))")
  (Deno:write-text-file-sync "package.lykn" (source:replace (regex ";; BEGIN PARSER[\\s\\S]*?;; END PARSER") parser))
  (for-of name #a("identity" "help" "argv")
    (add! (template "R-01-" name) "infrastructure" name (obj :repeats 1 :expected "separate source/tree/CLI/Deno identities and argv placement")))
  (add! "R-01-minimal" "matrix" "minimal" (obj :expected "native minimal launch emits success with no grants"))
  (for-of pkg packages
    (add! (template "R-02-" (pkg:replace-all "/" "-")) "static" "inventory" (obj :package pkg :repeats 1
      :expected "all metadata files hashed; full export graphs; runtime/type/dev/example edges and license/lineage distinguished")))
  (add! "R-02-toolchain" "static" "toolchain" (obj :repeats 1 :expected "pinned Cargo.lock and Lykn project/config/workflow source; no tooling execution inferred"))
  (add! "R-03-narrow" "matrix" "parser" (obj :entry "package.lykn" :cache "warm-copy" :expected "all selected package imports resolve exactly; parser success without grants"))
  (for-of fault #a("alias" "missing-package" "missing-subpath" "corrupt-lock")
    (add! (template "R-03-" fault) "resolution" fault (obj :entry "package.js" :cache "warm-copy"
      :expected "static resolution error; no graph evaluation; frozen lock bytes unchanged")))
  (add! "R-04-prefetch" "transport" "prefetch" (obj :entry "package.js" :expected "declared online prefetch to two new caches; complete error-free graph and unchanged frozen lock"))
  (add! "R-04-warm" "matrix" "parser" (obj :entry "package.lykn" :cache "warm-copy" :expected "complete cached-only frozen execution without runtime net grant"))
  (add! "R-04-cold" "resolution" "cold" (obj :entry "package.js" :expected "empty-cache cached-only resolution fails; no graph evaluation and unchanged lock"))
  (add! "R-05-parser-native" "permissions" "parser" (obj :expected "native parser success with no grants"))
  (add! "R-05-parser-yaml" "permissions" "parser" (obj :entry "package.lykn" :cache "warm-copy" :expected "package parser success with no grants"))
  (for-of action #a("read" "write")
    (add! (template "R-05-" action "-allowed") "permissions" action (obj :flags #a((template "--allow-" action "=./" (? (= action "read") "inputs/input.txt" "outputs/write.txt")))
      :expected (template "only declared " action " granted; observed operation succeeds")))
    (add! (template "R-05-" action "-denied") "permissions" action (obj :expected "actual NotCapable; untouched denied destination")))
  (for-of action #a("env" "net" "run")
    (add! (template "R-05-" action "-denied") "permissions" action (obj :expected "actual NotCapable, valid operation arguments, no endpoint or OS-error substitute")))
  (for-of condition #a("new" "existing" "symlink" "mode" "reader" "two-writers")
    (add! (template "R-06-" condition) "matrix" "replace" (obj :condition condition
      :flags #a("--allow-read=./outputs" "--allow-write=./outputs")
      :expected "complete write loop/sync/close/rename; exact candidate hashes, destination/link/target metadata; concurrency readiness and nonzero in-window samples")))
  (add! "HP-partial-observer" "harness" "replace" (obj :condition "raw-reader" :family "HP" :stopFamily "observer"
    :flags #a("--allow-read=./outputs" "--allow-write=./outputs") :expected "reader independently records a deliberately partial raw write while writer waits for release"))
  (add! "R-07-cross-filesystem" "matrix" "replace" (obj :condition "cross-filesystem"
    :flags #a("--allow-read=./outputs" "--allow-write=./outputs")
    :expected "existing Games01 filesystem; exclusive scratch; actual rename error or success with complete before/after bytes and device numbers"))
  (for-of point #a("open" "write" "flush" "rename")
    (add! (template "R-07-inject-" point) "matrix" "replace" (obj :condition (template "inject-" point)
      :flags #a("--allow-read=./outputs" "--allow-write=./outputs") :expected (template "declared injection before " point "; preserve old destination and exact orphan state"))))
  (for-of point #a("before" "after")
    (add! (template "R-07-cancel-" point) "matrix" "replace" (obj :condition (template "cancel-" point)
      :flags #a("--allow-read=./outputs" "--allow-write=./outputs") :expectedStop "checkpoint" :expectedExit 137
      :expected (template "external termination at observed " point "-rename checkpoint; exact pre-kill and aftermath bytes"))))
  (add! "R-07-directory" "matrix" "replace" (obj :condition "directory"
    :flags #a("--allow-read=./outputs" "--allow-write=./outputs") :expected "actual OS rename-over-directory error; sentinel and complete orphan preserved before cleanup"))
  (add! "R-08-reconciliation" "static" "resources" (obj :repeats 1 :expected "all 8 J-16 and 54 Y-13 IDs, exact original attempts and 36 unsupported cells; limits and attribution retained"))
  (for-of kind #a("json-parse" "yaml-parse" "yaml-stringify")
    (add! (template "R-08-" kind) "resources" "resource" (obj :resource kind :repeats 6
      :entry (? (= kind "json-parse") "cases.lykn" "package.lykn") :cache (? (= kind "json-parse") "fresh-empty" "warm-copy")
      :flags #a("--allow-read=./inputs/resource.txt") :input "retained scalar recipe x repeated 1048576, JSON quotes plus LF or YAML LF"
      :expected "length 1048576; package stage ms separate from setup and whole-child CPU/wall/RSS; 1 warm-up plus 5 measurements")))
  (add! "R-09-available-pair" "inventory" "runtime-inventory" (obj :repeats 1 :expected "identify existing pairs and support before comparison; unavailable with owner/re-entry if none"))
  (bind fm (Deno:read-text-file-sync "fm01.md"))
  (bind originals (-> fm (:split "\n") (:filter (fn (:string line) (line:starts-with "| R-")))))
  (ensure (= originals:length 9) "all nine original FM01 rows verbatim")
  (bind yp (read-json "yp-inputs.json"))
  (bind jp (read-json "j-inputs.json"))
  (bind inherited (obj :yaml (yp:variants:filter (fn (:object r) (or (= r:family "Y-13") (= r:family "Y-14"))))
    :json (jp:variants:filter (fn (:object r) (= r:family "J-16")))))
  (ensure (= inherited:yaml:length 82) "54 resource plus 28 gated document obligations")
  (ensure (= inherited:json:length 8) "all eight J-16 recipes")
  (for-of row rows
    (put! row "config" (? (= row:entry "cases.lykn") "{}\n" (Deno:read-text-file-sync "project.json")))
    (put! row "lockSha256" (await (digest (Deno:read-file-sync "deno.lock"))))
    (put! row "runtimeCondition" "Deno 2.9.6 sha256 2ad84f9e678ce12600a56772e0bed999938556153bf4da9b71cac7e365e5ce74; operator upgrade during preparation; 2.7.7 removed"))
  (write-json! "inputs.json" (obj :protocol "DB01/RP01/FM01" :status "candidate inventory; launcher and full operational freeze still blocked" :variants rows :originalFm01 originals :inherited inherited
    :payloads (obj :old "ORIGINAL\n" :candidateA "A repeated 65536 plus LF" :candidateB "B repeated 65536 plus LF" :partialBytes 32768)
    :concurrency (obj :maxWorkers 3 :maxReaderSamples 512 :internalDeadlineMs 5000 :pollMs 10 :protocol "ready; partial/complete; release; renamed; observer acknowledgment; finish")
    :inspection (obj :depth 256 :visits 4096 :nodes 2048 :members 2048 :strings 4096 :binary 4096)))
  (Deno:write-text-file-sync "case-manifest.md" (template "# DB01 candidate manifest\n\nOriginal FM01 rows, verbatim:\n\n" (originals:join "\n")
    "\n\nCandidate generation after the launcher blocker, using the operator-suggested eval route. No matrix ran. Operational freeze remains owed; source flags/checkpoint assumptions need review before use. Infrastructure/static rows are not runtime attempts.\n\n| ID | Group | Operation | Repetitions | Expected |\n| --- | --- | --- | --- | --- |\n"
    (-> rows (:map (fn (:object r) (template "| " r:id " | " r:group " | " r:op " | " r:repeats " | " r:expected " |"))) (:join "\n")) "\n"))
  (console:log (JSON:stringify (obj :checks (express checks) :variants rows:length :result "candidate-generated")))))
(async (func published-audit :args () :body
  (bind inventory #a())
  (bind files (cell 0))
  (for-of pkg packages
    (bind meta-path (template "published/" pkg "/meta.json"))
    (bind meta-bytes (Deno:read-file-sync meta-path))
    (bind meta (JSON:parse (decoder:decode meta-bytes)))
    (bind entries #a())
    (for-of path (Object:keys meta:manifest)
      (bind expected (get meta:manifest path))
      (bind bytes (Deno:read-file-sync (template "published/" pkg path)))
      (bind sha (await (digest bytes)))
      (ensure (= bytes:length expected:size) (template "published byte count " pkg path))
      (ensure (= (template "sha256-" sha) expected:checksum) (template "published checksum " pkg path))
      (swap! files + 1)
      (entries:push (obj :path path :url (template "https://jsr.io/@" pkg path) :bytes bytes:length :sha256 sha)))
    (inventory:push (obj :package pkg :metadataUrl (template "https://jsr.io/@" pkg "_meta.json")
      :metadataSha256 (await (digest meta-bytes)) :files entries :exports meta:exports :publishedModuleGraph meta:moduleGraph2)))
  (write-json! "dependency-graph.json" (obj :kind "captured published metadata graphs; NOT a resolved runtime or complete upstream development graph"
    :packages inventory :policy "eemeli static only; no package evaluation; lineage/adoption not inferred from registry"
    :runtimeGraphStatus "not-run" :developmentGraphStatus "full inventory owed"))
  (console:log (JSON:stringify (obj :checks (express checks) :files (express files) :result "published bytes match metadata; graph review remains owed")))))
(func safe-relative :args (:string path) :body
  (and (> path:length 0) (not (path:starts-with "/")) (not (path:includes "\\")) (not (-> (path:split "/") (:includes "..")))))
(func unhex :args (:string text) :body
  (ensure (= (% text:length 2) 0) "even hex length")
  (ensure (-> (regex "^[0-9a-f]*$") (:test text)) "hex alphabet")
  (Uint8Array:from (?? (text:match (regex ".." "g")) #a()) (fn (:string p) (Number:parse-int p 16))))
(async (func pack :args (:string output) :body
  (bind paths (-> (Deno:read-text-file-sync "packet-files.txt") (:trim) (:split "\n")))
  (bind file (Deno:open-sync output (obj :write true :createNew true)))
  (bind total (cell 0))
  (for-of path paths
    (ensure (safe-relative path) "relative packet path")
    (bind bytes (Deno:read-file-sync path))
    (swap! total + bytes:length)
    (ensure (and (<= bytes:length 8388608) (<= (express total) 67108864)) "bounded packet input")
    (bind encoded (encoder:encode (template (JSON:stringify (obj :file path :bytes bytes:length :sha256 (await (digest bytes)) :hex (hex bytes))) "\n")))
    (bind offset (cell 0))
    (while (< (express offset) encoded:length)
      (bind written (file:write-sync (encoded:subarray (express offset))))
      (ensure (> written 0) "packet write progress")
      (swap! offset + written)))
  (file:sync-sync)
  (file:close)
  (console:log (JSON:stringify (obj :checks (express checks) :files paths:length :bytes (express total) :result "packed")))))
(async (func extract :args (:string input :string dest) :body
  (bind text (Deno:read-text-file-sync input))
  (ensure (< (get (encoder:encode text) "length") 150000000) "bounded packet")
  (bind seen (new Set))
  (for-of line (-> text (:trim) (:split "\n"))
    (bind row (JSON:parse line))
    (ensure (and (safe-relative row:file) (not (seen:has row:file))) "safe unique extraction path")
    (seen:add row:file)
    (bind bytes (unhex row:hex))
    (ensure (= bytes:length row:bytes) "packet bytes")
    (ensure (= (await (digest bytes)) row:sha256) "packet hash")
    (bind path (template dest "/" row:file))
    (Deno:mkdir-sync (path:slice 0 (path:last-index-of "/")) (obj :recursive true))
    (Deno:write-file-sync path bytes (obj :createNew true)))
  (console:log (JSON:stringify (obj :checks (express checks) :files seen:size :result "extracted and verified")))))
(func planning-check :args (:string root) :body
  (bind prefix "project07-core-library-research/")
  (bind slice (template prefix "arc01-format-runtime-evidence/slice04-dependency-and-runtime-boundary/"))
  (bind prompt (Deno:read-text-file-sync (template root "/" slice "cc-prompt.md")))
  (bind allowed (new Set (-> prompt (:split "\n") (:filter (fn (:string line) (or (line:starts-with prefix) (= line "backlog/discoveries.md")))))))
  (bind paths (-> (Deno:read-text-file-sync "changed-paths.txt") (:trim) (:split "\n")))
  (bind links (cell 0))
  (for-of path paths
    (ensure (allowed:has path) (template "authorized planning path " path))
    (if (path:ends-with ".md")
      (do (bind text (-> (Deno:read-text-file-sync (template root "/" path)) (:replace (regex "```[\\s\\S]*?```" "g") "")))
        (for-of link (text:match-all (regex "\\[[^\\]]*\\]\\(([^)]+)\\)" "g"))
          (bind target (-> (get link 1) (:split "#") (get 0)))
          (if (and (> target:length 0) (not (target:includes "://")) (not (target:starts-with "mailto:")))
            (do (bind resolved (new URL target (template "file://" root "/" path)))
              (Deno:stat-sync (decodeURIComponent resolved:pathname))
              (swap! links + 1)))))))
  (bind before (-> (Deno:read-text-file-sync "meta/open-set/ledger.md") (:split "\n") (:filter (fn (:string line) (line:starts-with "| DB-")))))
  (bind after (-> (Deno:read-text-file-sync (template root "/" slice "ledger.md")) (:split "\n") (:filter (fn (:string line) (line:starts-with "| DB-")))))
  (ensure (= before:length 8) "eight opening DB criteria")
  (ensure (= after:length 8) "eight retained DB criteria")
  (for-of pair (before:entries)
    (ensure (= (get pair 1) (get after (get pair 0))) "original DB row unchanged"))
  (bind next-ledger (Deno:read-text-file-sync (template root "/" prefix "arc03-findings-and-integration/slice06-deno-launch-compatibility/ledger.md")))
  (bind next-rows (-> next-ledger (:split "\n") (:filter (fn (:string line) (line:starts-with "| LC-")))))
  (ensure (= next-rows:length 6) "six new correction criteria")
  (console:log (JSON:stringify (obj :checks (express checks) :paths paths:length :links (express links) :result "planning paths, links and criterion preservation checked"))))
(bind mode (get Deno:args 0))
(if (= mode "transport-list") (transport-list))
(if (= mode "freeze") (await (freeze)))
(if (= mode "published") (await (published-audit)))
(if (= mode "pack") (await (pack (get Deno:args 1))))
(if (= mode "extract") (await (extract (get Deno:args 1) (get Deno:args 2))))
(if (= mode "planning") (planning-check (get Deno:args 1)))
