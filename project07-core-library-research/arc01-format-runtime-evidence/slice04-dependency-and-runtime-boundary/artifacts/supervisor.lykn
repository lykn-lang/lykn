;; External SH supervision remains active until status, streams and ownership settle.
(bind CLI (-> (Deno:read-text-file-sync "compiler-path.txt") (:trim)))
(bind seed (Deno:cwd))
(bind decoder (new TextDecoder))
(bind encoder (new TextEncoder))
(func delay :args (:number ms) :body (new Promise (fn (:function resolve) (set-timeout resolve ms))))
(func hex :args (:any bytes) :body (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(async (func digest :args (:any bytes) :body (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func require-ok :args (:boolean ok :string message) :body
  (if (not ok) (throw (new Error message)))
  null)
(func environment :args (:string root) :body (obj :PATH "/opt/homebrew/bin:/usr/bin:/bin" :HOME (template root "/home") :TMPDIR (template root "/tmp") :DENO_DIR (template root "/cache") :DENO_NO_UPDATE_CHECK "1" :NO_COLOR "1"))
(func command :args (:string exe :array args :string root) :body
  (new Deno:Command exe (obj :args args :cwd root :clear-env true :env (environment root) :stdin "null" :stdout "piped" :stderr "piped")))
(func missing :args (:any err) :body
  (if (not (= err:name "NotFound")) (throw err))
  null)
(func optional-json :args (:string path) :body
  (try (return (JSON:parse (Deno:read-text-file-sync path)))
    (catch err (require-ok (or (= err:name "NotFound") (= err:name "SyntaxError")) err:message)))
  null)
(func processes :args () :body
  (bind result (-> (command "/bin/ps" #a("-axo" "pid=,ppid=,rss=,stat=,lstart=") seed) (:output-sync)))
  (require-ok result:success "host process observation failed")
  (-> (decoder:decode result:stdout) (:trim) (:split "\n")
    (:map (fn (:string line)
      (bind fields (-> line (:trim) (:split (regex "\\s+"))))
      (obj :pid (Number (get fields 0)) :ppid (Number (get fields 1)) :rss (Number (get fields 2)) :state (get fields 3) :birth (-> fields (:slice 4) (:join " ")))))))
(async (func files :args (:string root :string dir) :body
  (bind rows #a())
  (for-of entry (Deno:read-dir-sync (template root "/" dir))
    (bind path (template dir "/" entry:name))
    (bind full (template root "/" path))
    (bind stat (Deno:lstat-sync full))
    (bind link (? entry:is-symlink (Deno:read-link-sync full) null))
    (if entry:is-symlink
      (require-ok (-> (Deno:real-path-sync full) (:starts-with (template root "/"))) "fixture link stays inside owned root"))
    (bind bytes (? entry:is-directory (new Uint8Array) (Deno:read-file-sync full)))
    (require-ok (<= bytes:length 9437184) "fixture capture bound")
    (rows:push (obj :path path :kind (? entry:is-directory "directory" (? entry:is-symlink "symlink" "file")) :linkTarget link :device stat:dev
      :bytes bytes:length :hex (hex bytes) :sha256 (await (digest bytes)) :mode stat:mode))
    (if entry:is-directory
      (do (bind children (await (files root path))) (for-of child children (rows:push child)))))
  rows))
(func copy-tree :args (:string source :string dest) :body
  (Deno:mkdir-sync dest (obj :recursive true))
  (for-of entry (Deno:read-dir-sync source)
    (require-ok (not entry:is-symlink) "no cache symlinks")
    (bind from (template source "/" entry:name))
    (bind to (template dest "/" entry:name))
    (if entry:is-directory (copy-tree from to) (Deno:copy-file-sync from to)))
  null)
(func prepare-root :args (:string root :string source :string config :string lock) :body
  (Deno:mkdir-sync root)
  (for-of dir #a("inputs" "outputs" "home" "tmp" "cache") (Deno:mkdir-sync (template root "/" dir)))
  (Deno:write-text-file-sync (template root "/cases.lykn") source)
  (Deno:write-text-file-sync (template root "/project.json") config)
  (Deno:write-text-file-sync (template root "/deno.lock") lock)
  null)
(async (func run-one :args (:object spec :number attempt :object manifest) :body
  (bind root (template seed "/runs/" spec:id "-" attempt))
  (bind source (Deno:read-text-file-sync spec:entry))
  (bind padding (? spec:sourcePaddingForms
    (-> (Array:from (obj :length spec:sourcePaddingForms) (fn (:any unused :number index) (template "(bind sh-pad-" index " 0)\n"))) (:join "")) ""))
  (prepare-root root (template padding source) spec:config spec:lock)
  (if (= spec:cache "warm-copy") (copy-tree "transport/cache" (template root "/cache")))
  (if spec:probe (Deno:copy-file-sync spec:probe (template root "/probe.js")))
  (Deno:write-text-file-sync (template root "/inputs/input.txt") "INPUT\n")
  (Deno:write-text-file-sync (template root "/outputs/destination.txt") "ORIGINAL\n")
  (if (= spec:condition "new") (Deno:remove-sync (template root "/outputs/destination.txt")))
  (if (= spec:condition "symlink")
    (do (Deno:rename-sync (template root "/outputs/destination.txt") (template root "/outputs/target.txt"))
      (bind linked (-> (command "/bin/ln" #a("-s" "target.txt" "outputs/destination.txt") root) (:output-sync)))
      (Deno:write-file-sync (template root "/symlink-setup.stdout") linked:stdout)
      (Deno:write-file-sync (template root "/symlink-setup.stderr") linked:stderr)
      (Deno:write-text-file-sync (template root "/symlink-setup.exit") (String linked:code))
      (require-ok linked:success "explicit isolated symlink setup")))
  (if (= spec:condition "mode") (Deno:chmod-sync (template root "/outputs/destination.txt") 416))
  (if (= spec:condition "directory")
    (do (Deno:remove-sync (template root "/outputs/destination.txt"))
      (Deno:mkdir-sync (template root "/outputs/destination.txt"))
      (Deno:write-text-file-sync (template root "/outputs/destination.txt/sentinel.txt") "SENTINEL\n")))
  (bind actual-cross (? (= spec:condition "cross-filesystem") (template spec:crossRoot "/" spec:id "-" attempt ".tmp") ""))
  (if (= spec:op "resource")
    (Deno:write-text-file-sync (template root "/inputs/resource.txt")
      (? (= spec:resource "json-parse") (template (JSON:stringify (String:prototype:repeat:call "x" 1048576)) "\n") (template (String:prototype:repeat:call "x" 1048576) "\n"))))
  (if (= spec:group "observers")
    (do (Deno:mkdir-sync (template root "/workers"))
      (for-of role #a("reader" "a" "b") (prepare-root (template root "/workers/" role) source spec:config spec:lock))))
  (bind before (await (files root "outputs")))
  (bind runtime-args (-> #a("run" "--no-prompt" "--cached-only" "--frozen=true") (:concat spec:flags)
    (:concat #a("cases.lykn" (JSON:stringify (assoc spec :cli CLI :crossPath actual-cross))))))
  (bind args (? spec:transport #a("info" "--json" "--no-npm" "--config=project.json" "--lock=deno.lock" "--frozen-lockfile=true" "probe.js") runtime-args))
  (bind executable (? spec:transport "/opt/homebrew/bin/deno" CLI))
  (bind started (new Date))
  (bind start (performance:now))
  (bind child (-> (command "/usr/bin/time" (-> #a("-l" executable) (:concat args)) root) (:spawn)))
  (bind state (obj :rootExited false :outClosed false :errClosed false :status null :reason null :observedBytes 0 :retainedBytes 0 :maxRssKiB 0
    :checkpoint null :nestedPid 0 :pipeHeldAfterExit false :injected false :drainCancelled false :errorsCapped false))
  (bind known (new Map))
  (bind samples #a())
  (bind errors #a())
  (bind kills #a())
  (bind out-chunks #a())
  (bind err-chunks #a())
  (bind out-reader (child:stdout:get-reader))
  (bind err-reader (child:stderr:get-reader))
  (func record-error :args (:string phase :any err) :body
    (if (< errors:length spec:errorCap) (errors:push (obj :phase phase :name err:name :message (err:message:slice 0 1024)))
      (Object:assign state (obj :errorsCapped true)))
    null)
  (func owned :args (:array table) :body
    (if (= known:size 0)
      (do (bind first (table:find (fn (:object row) (= row:pid child:pid))))
        (if first (known:set first:pid first:birth))))
    (bind changed (cell true))
    (while (express changed)
      (reset! changed false)
      (for-of row table
        (bind parent (table:find (fn (:object p) (and (= p:pid row:ppid) (= (known:get p:pid) p:birth)))))
        (if (and parent (not (known:has row:pid)))
          (do (require-ok (< known:size spec:processCap) "process recording cap")
            (known:set row:pid row:birth) (reset! changed true)))))
    (table:filter (fn (:object row) (and (= (known:get row:pid) row:birth) (not (row:state:starts-with "Z"))))))
  (func terminate :args (:string why) :body
    (if (= state:reason null) (Object:assign state (obj :reason why)))
    (bind targets (owned (processes)))
    (if (> targets:length 0)
      (do
        (require-ok (< kills:length 16) "termination recording cap")
        (bind ids (-> targets (:slice) (:reverse) (:map (fn (:object row) (String row:pid)))))
        (bind result (-> (command "/bin/kill" (-> #a("-KILL") (:concat ids)) root) (:output-sync)))
        (kills:push (obj :ms (- (performance:now) start) :targets targets :exit result:code :stderr (decoder:decode result:stderr)))))
    null)
  (async (func collect :args (:any reader :array chunks :string closed) :body
    (try
      (bind finished (cell false))
      (while (not (express finished))
        (bind item (await (reader:read)))
        (if item:done (reset! finished true)
          (do
            (Object:assign state (obj :observedBytes (+ state:observedBytes item:value:length)))
            (bind keep (item:value:slice 0 (Math:max 0 (- spec:outputBytes state:retainedBytes))))
            (? (> keep:length 0) (chunks:push keep) null)
            (Object:assign state (obj :retainedBytes (+ state:retainedBytes keep:length)))
            (? (and (> state:observedBytes spec:outputBytes) (= state:reason null)) (terminate "output") null))))
      (catch err (record-error "stream" err) (terminate "stream")))
    (Object:define-property state closed (obj :value true :writable true :enumerable true :configurable true))
    null))
  (bind out-promise (collect out-reader out-chunks "outClosed"))
  (bind err-promise (collect err-reader err-chunks "errClosed"))
  (bind status-promise (-> child:status (:then (fn (:object status) (Object:assign state (obj :status status :rootExited true))))))
  (bind complete (cell false))
  (async (func finish-deadline :args () :body
    (terminate "deadline")
    (Object:assign state (obj :drainCancelled true))
    (await (Promise:race #a((Promise:all #a((out-reader:cancel) (err-reader:cancel))) (delay 100))))
    (reset! complete true)))
  (while (not (express complete))
    (try
      (bind rows (owned (processes)))
      (bind rss (rows:reduce (fn (:number sum :object row) (+ sum row:rss)) 0))
      (Object:assign state (obj :maxRssKiB (Math:max state:maxRssKiB rss)))
      (if (>= samples:length spec:sampleCap) (terminate "samples")
        (samples:push (obj :ms (- (performance:now) start) :rssKiB rss :processes rows)))
      (if (and spec:injectObservation (not state:injected) (> known:size 0))
        (do (Object:assign state (obj :injected true)) (throw (new Error "SH_INJECTED_OBSERVATION_FAILURE"))))
      (if (and (= spec:op "pipe-parent") (= state:nestedPid 0))
        (do (bind marker (optional-json (template root "/outputs/nested-ready.json")))
          (if (and marker (rows:some (fn (:object row) (= row:pid marker:pid))))
            (do (Object:assign state (obj :nestedPid marker:pid))
              (Deno:write-text-file-sync (template root "/outputs/release-parent") "registered\n")))))
      (if (and state:rootExited (> rows:length 0) (or (not state:outClosed) (not state:errClosed)))
        (Object:assign state (obj :pipeHeldAfterExit true)))
      (if (and (= spec:expectedStop "checkpoint") (= state:checkpoint null) (= state:reason null))
        (do (bind marker (optional-json (template root "/outputs/cancel.json")))
          (if marker
            (do
              (bind expected (? (= spec:condition "cancel-before") "outputs/replacement.tmp" "outputs/destination.txt"))
              (bind checkpoint-owners (owned (processes)))
              (require-ok (and (= marker:path expected) (= spec:condition (template "cancel-" marker:stage)) (checkpoint-owners:some (fn (:object row) (= row:pid marker:pid)))) "checkpoint identity/path")
              (bind bytes (Deno:read-file-sync (template root "/" expected)))
              (bind sha (await (digest bytes)))
              (require-ok (and (= bytes:length 65537) (= sha marker:sha256)) "independent checkpoint bytes")
              (Object:assign state (obj :checkpoint (obj :marker marker :bytes bytes:length :sha256 sha :ms (- (performance:now) start) :visible (await (files root "outputs")))))
              (terminate "checkpoint")))))
      (if (> rss spec:rssKiB) (terminate "rss"))
      (if (and (> (- (performance:now) start) spec:wallMs) (or (> rows:length 0) (not state:rootExited) (not state:outClosed) (not state:errClosed))) (terminate "wall"))
      (if (and state:rootExited state:outClosed state:errClosed (= rows:length 0)) (reset! complete true))
      (catch err (record-error "observation" err) (terminate "observation")))
    (? (> (- (performance:now) start) (- spec:deadlineMs 250)) (await (finish-deadline)) null)
    (await (delay 20)))
  (await (Promise:race #a((Promise:all #a(out-promise err-promise status-promise)) (delay 100))))
  (func join-bytes :args (:array chunks) :body
    (bind result (new Uint8Array (chunks:reduce (fn (:number n :any bytes) (+ n bytes:length)) 0)))
    (bind offset (cell 0))
    (for-of bytes chunks (result:set bytes (express offset)) (swap! offset + bytes:length))
    result)
  (bind stdout (join-bytes out-chunks))
  (bind stderr (join-bytes err-chunks))
  (bind compiled (cell null))
  (try (reset! compiled (await (digest (Deno:read-file-sync (template root "/target/lykn/run/cases.js"))))) (catch err (missing err)))
  (bind output-files (await (files root "outputs")))
  (bind input-files (await (files root "inputs")))
  (bind cross-file (cell null))
  (if (> actual-cross:length 0)
    (try
      (bind bytes (Deno:read-file-sync actual-cross))
      (reset! cross-file (obj :path actual-cross :hex (hex bytes) :bytes bytes:length :sha256 (await (digest bytes)) :stat (Deno:stat-sync actual-cross)))
      (catch err (missing err))))
  (bind record (obj :spec spec :attempt attempt :cwd root :crossFile (express cross-file) :started (started:toISOString) :ended (-> (new Date) (:toISOString)) :command (-> #a("/usr/bin/time" "-l" executable) (:concat args)) :environment (environment root)
    :exit (? state:status state:status:code null) :signal (? state:status state:status:signal null) :rootExited state:rootExited :streamsClosed (and state:outClosed state:errClosed) :drainCancelled state:drainCancelled
    :stopReason state:reason :wallMs (- (performance:now) start) :samples samples :errors errors :errorsCapped state:errorsCapped :kills kills :survivors (owned (processes)) :maxRssKiB state:maxRssKiB
    :observedBytes state:observedBytes :retainedBytes state:retainedBytes :stdoutHex (hex stdout) :stderrHex (hex stderr) :stdoutSha256 (await (digest stdout)) :stderrSha256 (await (digest stderr))
    :checkpoint state:checkpoint :nestedPid state:nestedPid :pipeHeldAfterExit state:pipeHeldAfterExit :compiled (express compiled) :sourceSha256 (await (digest (Deno:read-file-sync (template root "/cases.lykn"))))
    :configBefore spec:config :lockBefore spec:lock :configAfter (Deno:read-text-file-sync (template root "/project.json")) :lockAfter (Deno:read-text-file-sync (template root "/deno.lock"))
    :before before :files (output-files:concat input-files)))
  (Deno:write-text-file-sync (template root "/record.json") (template (JSON:stringify record) "\n"))
  (bind audit-args #a("run" "--no-prompt" "--cached-only" "--frozen=true" (template "--allow-read=" root "," seed "/inputs.json" (? (> actual-cross:length 0) (template "," actual-cross) "")) "audit.lykn" "verify" (template root "/record.json") "live"))
  (bind audit (await (-> (command CLI audit-args seed) (:output))))
  (Deno:write-file-sync (template root "/audit.stdout") audit:stdout)
  (Deno:write-file-sync (template root "/audit.stderr") audit:stderr)
  (Deno:write-text-file-sync (template root "/audit.exit") (String audit:code))
  (console:log (JSON:stringify (obj :id spec:id :attempt attempt :exit record:exit :stop record:stopReason :audit audit:code :wallMs record:wallMs)))
  (require-ok audit:success "semantic audit failed; stop this group and retain owed attempts")
  record))
(bind group (get Deno:args 0))
(require-ok (-> #a("controls" "native" "observers" "cancellation" "files" "resources" "resolution" "prefetch") (:includes group)) "known group")
(bind manifest (JSON:parse (Deno:read-text-file-sync "inputs.json")))
(for-of name (Object:keys manifest:sources)
  (require-ok (= (get manifest:sources name) (await (digest (Deno:read-file-sync name)))) "frozen source hash"))
(processes)
(if (not (= group "controls")) (Deno:read-text-file-sync "controls.verified"))
(if (or (= group "observers") (= group "cancellation")) (Deno:read-text-file-sync "native.verified"))
(Deno:mkdir-sync "runs" (obj :recursive true))
(for-of spec manifest:variants
  (if (= spec:group group)
    (do (bind attempt (cell 1))
      (while (<= (express attempt) spec:repeats)
        (await (run-one spec (express attempt) manifest))
        (swap! attempt + 1)))))
(Deno:write-text-file-sync (template group ".verified") (JSON:stringify (obj :group group :semanticAudit true :manifestSha256 (await (digest (Deno:read-file-sync "inputs.json"))))))
