;; Bounded native fixture. audit.lykn generates the package entry from two markers.
;; BEGIN PARSER
(func selected-parse :args (:string text) :body (JSON:parse text))
(func selected-stringify :args (:any value) :body (JSON:stringify value))
(func package-smoke :args () :body "native")
;; END PARSER
(bind encoder (new TextEncoder))
(func emit :args (:object value) :body (console:log (JSON:stringify value)))
(func hex :args (:any bytes) :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func delay :args (:number ms) :body (new Promise (fn (:function resolve) (set-timeout resolve ms))))
(func append-item :args (:array items :any value) :body (conj items value))
(func require-condition :args (:boolean ok :string message) :body
  (if (not ok) (throw (new Error message)))
  null)
(func candidate :args (:string name) :body (encoder:encode (template (name:repeat 65536) "\n")))
(func missing-only :args (:any err) :body
  (if (not (= err:name "NotFound")) (throw err))
  null)
(func close-if-open! :args (:any file) :body
  (if (not (= file null)) (file:close))
  null)
(func exists :args (:string path) :body
  (try (Deno:lstat-sync path) (return true)
    (catch err (missing-only err)))
  false)
(async (func wait-for :args (:string path) :body
  (bind start (performance:now))
  (while (not (exists path))
    (require-condition (<= (- (performance:now) start) 5000) (template "checkpoint timeout " path))
    (await (delay 10)))
  null))
(func mark! :args (:string path :object data) :body
  (Deno:write-text-file-sync path (JSON:stringify (assoc data :pid Deno:pid))))
(async (func write-all! :args (:any file :any bytes) :body
  (bind offset (cell 0))
  (bind writes (cell #a()))
  (while (< (express offset) bytes:length)
    (bind count (await (file:write (bytes:subarray (express offset) (Math:min bytes:length (+ (express offset) 4096))))))
    (require-condition (> count 0) "non-progressing write")
    (swap! writes append-item count)
    (swap! offset + count))
  (express writes)))
(func inject! :args (:string condition :string point) :body
  (if (= condition (template "inject-" point)) (throw (new Error (template "DECLARED_INJECTION_BEFORE_" point))))
  null)
(async (func replace-file :args (:object spec) :body
  (bind stage (cell "open"))
  (bind candidate-bytes (candidate "A"))
  (bind file (cell null))
  (bind temp (? (= spec:condition "cross-filesystem") spec:crossPath "outputs/replacement.tmp"))
  (bind destination "outputs/destination.txt")
  (try
    (inject! spec:condition "open")
    (reset! file (await (Deno:open temp (obj :write true :createNew true :mode 384))))
    (reset! stage "write")
    (inject! spec:condition "write")
    (bind writes (await (write-all! (express file) candidate-bytes)))
    (reset! stage "flush")
    (inject! spec:condition "flush")
    (-> (express file) (:sync-sync))
    (-> (express file) (:close))
    (reset! file null)
    (emit (obj :event "prepared" :writes writes :bytes candidate-bytes:length :sha256 (await (digest candidate-bytes))))
    (if (= spec:condition "cancel-before")
      (do (mark! "outputs/cancel.json" (obj :stage "before" :path temp :sha256 (await (digest candidate-bytes))))
        (while true (+ 1 1))))
    (reset! stage "rename")
    (inject! spec:condition "rename")
    (await (Deno:rename temp destination))
    (if (= spec:condition "cancel-after")
      (do (mark! "outputs/cancel.json" (obj :stage "after" :path destination :sha256 (await (digest candidate-bytes))))
        (while true (+ 1 1))))
    (emit (obj :event "replaced" :sha256 (await (digest (Deno:read-file-sync destination)))))
    (catch err (emit (obj :event "operation-error" :stage (express stage) :name err:name :message err:message :injected (err:message:starts-with "DECLARED_INJECTION"))))
    (finally (close-if-open! (express file))))
  null))
(async (func writer :args (:object spec) :body
  (bind base spec:shared)
  (bind role spec:role)
  (bind bytes (candidate (? (= role "a") "A" "B")))
  (bind raw (= spec:condition "raw-reader"))
  (bind path (template base "/" (? raw "destination.txt" (template role ".tmp"))))
  (await (wait-for (template base "/reader-ready.json")))
  (bind file (await (Deno:open path (obj :write true :create true :truncate true :mode 384))))
  (bind writes (await (write-all! file (? raw (bytes:slice 0 32768) bytes))))
  (file:sync-sync)
  (file:close)
  (mark! (template base "/" role "-ready.json") (obj :role role :writes writes :path path :bytes (? raw 32768 bytes:length) :fullSha256 (await (digest bytes))))
  (await (wait-for (template base "/release-" role)))
  (if raw
    (do (bind tail (await (Deno:open path (obj :write true :append true))))
      (await (write-all! tail (bytes:subarray 32768))) (tail:sync-sync) (tail:close))
    (await (Deno:rename path (template base "/destination.txt"))))
  (mark! (template base "/" role "-done.json") (obj :role role :fullSha256 (await (digest bytes))))
  (emit (obj :event "writer-complete" :role role :sha256 (await (digest bytes))))))
(async (func reader :args (:object spec) :body
  (bind base spec:shared)
  (bind start (performance:now))
  (bind samples (cell #a()))
  (bind old-hash (await (digest (encoder:encode "ORIGINAL\n"))))
  (bind a-hash (await (digest (candidate "A"))))
  (bind b-hash (await (digest (candidate "B"))))
  (while (and (< (- (performance:now) start) 5000) (< (get (express samples) "length") 512) (not (exists (template base "/finish"))))
    (bind bytes (await (Deno:read-file (template base "/destination.txt"))))
    (bind hash (await (digest bytes)))
    (bind kind (cond ((= hash old-hash) "old") ((= hash a-hash) "a") ((= hash b-hash) "b") (:else "partial")))
    (swap! samples append-item (obj :ms (- (performance:now) start) :bytes bytes:length :sha256 hash :kind kind))
    (mark! (template base "/seen-" kind ".json") (obj :kind kind :bytes bytes:length :sha256 hash))
    (mark! (template base "/reader-ready.json") (obj :samples (get (express samples) "length")))
    (await (delay 10)))
  (if (not (exists (template base "/finish"))) (throw (new Error "reader exhausted bounds before protocol finish")))
  (emit (obj :event "reader-complete" :samples (express samples)))))
(async (func concurrent :args (:object spec) :body
  (bind root (Deno:cwd))
  (bind shared (template root "/outputs"))
  (bind roles (? (= spec:condition "two-writers") #a("reader" "a" "b") #a("reader" "a")))
  (bind children #a())
  (for-of role roles
    (bind cwd (template root "/workers/" role))
    (bind args #a("run" "--no-prompt" "--cached-only" "--frozen=true" "--allow-read=../../outputs" "--allow-write=../../outputs" "cases.lykn"
      (JSON:stringify (obj :op (? (= role "reader") "worker-reader" "worker-writer") :role role :shared shared :condition spec:condition))))
    (bind options (obj :args args :cwd cwd :clear-env true
      :env (obj :PATH "/opt/homebrew/bin:/usr/bin:/bin" :HOME (template cwd "/home") :TMPDIR (template cwd "/tmp") :DENO_DIR (template cwd "/cache") :DENO_NO_UPDATE_CHECK "1" :NO_COLOR "1")
      :stdin "null" :stdout "piped" :stderr "piped"))
    (bind child (-> (new Deno:Command spec:cli options) (:spawn)))
    (children:push (obj :role role :pid child:pid :command args :options options :result (child:output))))
  (await (wait-for (template shared "/reader-ready.json")))
  (await (wait-for (template shared "/seen-old.json")))
  (await (wait-for (template shared "/a-ready.json")))
  (if (= spec:condition "two-writers") (await (wait-for (template shared "/b-ready.json"))))
  (if (= spec:condition "raw-reader") (await (wait-for (template shared "/seen-partial.json"))))
  (Deno:write-text-file-sync (template shared "/release-a") "release\n")
  (await (wait-for (template shared "/a-done.json")))
  (await (wait-for (template shared "/seen-a.json")))
  (if (= spec:condition "two-writers")
    (do (Deno:write-text-file-sync (template shared "/release-b") "release\n")
      (await (wait-for (template shared "/b-done.json")))
      (await (wait-for (template shared "/seen-b.json")))))
  (Deno:write-text-file-sync (template shared "/finish") "finish\n")
  (for-of child children
    (bind result (await child:result))
    (emit (obj :event "worker-result" :role child:role :pid child:pid :command child:command :options child:options
      :exit result:code :stdout (-> (new TextDecoder) (:decode result:stdout)) :stderr (-> (new TextDecoder) (:decode result:stderr))))
    (if (not result:success) (throw (new Error "worker failure"))))
  (emit (obj :event "concurrent-complete" :condition spec:condition :sha256 (await (digest (Deno:read-file-sync (template shared "/destination.txt"))))))))
(async (func resource :args (:object spec) :body
  (bind text (Deno:read-text-file-sync "inputs/resource.txt"))
  (bind setup-start (performance:now))
  (bind value (? (= spec:resource "yaml-stringify") (selected-parse text) null))
  (bind setup-ms (- (performance:now) setup-start))
  (bind start (performance:now))
  (bind result (? (= spec:resource "yaml-stringify") (selected-stringify value) (selected-parse text)))
  (bind stage-ms (- (performance:now) start))
  (bind bytes (encoder:encode result))
  (emit (obj :event "resource" :resource spec:resource :setupMs setup-ms :stageMs stage-ms :units result:length :bytes bytes:length
    :sha256 (await (digest bytes)) :preview (result:slice 0 32) :inputSha256 (await (digest (encoder:encode text)))))))
(async (func dispatch :args (:object spec) :body
  (if (= spec:op "control-timeout") (while true (+ 1 1)))
  (if (= spec:op "control-rss") (while true (+ 1 1)))
  (if (= spec:op "control-output") (while true (console:log (String:prototype:repeat:call "x" 1024))))
  (if (= spec:op "minimal") (emit (obj :event "minimal" :value 42)))
  (if (= spec:op "parser") (emit (obj :event "parser" :value (selected-parse "{\"n\":1}") :packages (package-smoke))))
  (if (= spec:op "read") (emit (obj :event "read" :text (await (Deno:read-text-file "inputs/input.txt")))))
  (if (= spec:op "write") (do (await (Deno:write-text-file "outputs/write.txt" "WRITTEN\n")) (emit (obj :event "write" :success true))))
  (if (= spec:op "env") (emit (obj :event "env" :value (Deno:env:get "DB_SYNTHETIC"))))
  (if (= spec:op "net") (do (bind conn (await (Deno:connect (obj :hostname "127.0.0.1" :port 9)))) (conn:close) (emit (obj :event "net" :success true))))
  (if (= spec:op "run") (do (bind out (await (-> (new Deno:Command "/usr/bin/true" (obj :stdin "null" :stdout "piped" :stderr "piped")) (:output)))) (emit (obj :event "run" :success out:success))))
  (if (= spec:op "replace")
    (if (-> #a("reader" "two-writers" "raw-reader") (:includes spec:condition)) (await (concurrent spec)) (await (replace-file spec))))
  (if (= spec:op "worker-reader") (await (reader spec)))
  (if (= spec:op "worker-writer") (await (writer spec)))
  (if (= spec:op "resource") (await (resource spec)))
  (if (not (-> #a("minimal" "parser" "read" "write" "env" "net" "run" "replace" "worker-reader" "worker-writer" "resource") (:includes spec:op)))
    (throw (new Error "unknown operation")))
  null))
(bind spec (JSON:parse (get Deno:args 0)))
(try (await (dispatch spec))
  (catch err (emit (obj :event "uncaught-operation" :name err:name :message err:message)) (Deno:exit 1)))
