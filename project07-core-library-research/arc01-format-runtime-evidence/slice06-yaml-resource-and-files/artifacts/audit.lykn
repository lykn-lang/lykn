;; YR-M01 Lykn fixture generator, evidence auditor and lossless packet transport.
(bind encoder (new TextEncoder))
(bind decoder (new TextDecoder "utf-8" (obj :fatal true)))
(bind checks (cell 0))
(func ensure :args (:boolean ok :string label) :body
  (swap! checks (fn (:number n) (+ n 1)))
  (if (not ok) (throw (new Error label))))
(func append-item :args (:array values :any item) :body (conj values item))
(func put! :args (:object target :string key :any value) :body
  (Object:define-property target key (obj :value value :enumerable true :writable true :configurable true)))
(func hex :args (:any bytes) :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(func unhex :args (:string text) :body
  (Uint8Array:from (?? (text:match (regex ".." "g")) #a()) (fn (:string p) (Number:parse-int p 16))))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func read-json :args (:string path) :body (JSON:parse (Deno:read-text-file-sync path)))
(func records :args (:string path) :body
  (-> (Deno:read-text-file-sync path) (:trim) (:split "\n") (:filter (fn (:string line) (> line:length 0)))
    (:map (fn (:string line) (JSON:parse line)))))
(func write-json! :args (:string path :any value) :body
  (Deno:write-text-file-sync path (template (JSON:stringify value null 2) "\n")))
(bind original-hash "012be588e360a46b4458cc2be8ea99448b3314783bc794509df83eeb17e627db")
(bind owner "slice06-yaml-resource-and-files")
(func recipe-text :args (:object recipe) :body
  (if (= recipe:kind "depth") (return (template (String:prototype:repeat:call "[" recipe:size) "0" (String:prototype:repeat:call "]" recipe:size) "\n")))
  (if (= recipe:kind "string") (return (template (String:prototype:repeat:call "x" recipe:size) "\n")))
  (ensure (and (= recipe:kind "alias-dag") (= recipe:fanout 2)) "known recipe")
  (bind text (cell "base: &a0 [x,x]\n"))
  (for-of n (Array:from (obj :length recipe:size) (fn (:any ignored :number i) (+ i 1)))
    (swap! text (fn (:string prior) (template prior "a" n ": &a" n " [*a" (- n 1) ",*a" (- n 1) "]\n"))))
  (express text))
(async (func freeze :args () :body
  (bind original-bytes (Deno:read-file-sync "yp-inputs.json"))
  (ensure (= (await (digest original-bytes)) original-hash) "YP-M01 immutable hash")
  (bind original (JSON:parse (decoder:decode original-bytes)))
  (bind rows (cell #a()))
  (bind pairs (cell #a()))
  (bind recipes (new Map))
  (Deno:mkdir-sync "fixtures" (obj :recursive true))
  (for-of prior original:variants
    (if (prior:id:starts-with "Y-")
      (do (bind row (structured-clone prior))
        (put! row "original" prior)
        (put! row "phase" (? (= row:owner owner) "matrix" "other-owner"))
        (if (= row:owner owner)
          (do (bind spec row:case)
            (put! row "op" "probe")
            (put! row "expectedExit" 0)
            (if (= row:family "Y-13")
              (do (bind recipe spec:recipe)
                (bind text (recipe-text recipe))
                (bind bytes (encoder:encode text))
                (bind hash (await (digest bytes)))
                (ensure (and (= hash row:inputSha256) (= bytes:length row:encodedBytes)) (template "original recipe bytes " row:id))
                (if (not (recipes:has hash))
                  (do (recipes:set hash (obj :kind recipe:kind :size recipe:size :fanout recipe:fanout
                        :sha256 hash :encodedBytes bytes:length :recipe "recipe-text in retained audit.lykn; UTF-8; exact LF delimiters"))
                    (Deno:write-file-sync (template "fixtures/" hash ".yaml") bytes)))
                (put! spec "inputSha256" hash)
                (put! spec "encodedBytes" bytes:length)
                (put! row "fixture" (template "fixtures/" hash ".yaml"))
                (put! row "stopFamily" (template recipe:kind "/" recipe:operation "/" recipe:bound))
                (put! row "flags" #a("--allow-read=./inputs/source.yaml"))
                (if (or (= recipe:operation "toJS") (= recipe:bound "explicit"))
                  (do (put! row "phase" "unsupported")
                    (put! row "unsupported" (obj :toJS (= recipe:operation "toJS") :packageBound (= recipe:bound "explicit")
                      :evidence "std/yaml@1.2.0 mod.ts,parse.ts,stringify.ts,_loader_state.ts and _dumper_state.ts and types.ts; no conversion API or resource-limit option"
                      :reentry "Slice04 compatible-route policy; repeat original cell if an approved pinned package exposes this capability")))))
              (do (bind failure spec:failure)
                (put! row "stopFamily" row:id)
                (put! row "flags" #a("--allow-read=./inputs,./outputs" "--allow-write=./outputs"))
                (put! row "files" #a((obj :path "inputs/source.yaml" :hex spec:hex)
                  (obj :path "outputs/destination.yaml" :hex "4f524947494e414c0a")))
                (if (or (= failure "raw-interrupt") (= failure "safe-interrupt"))
                  (do (put! row "expectedStop" "partial-write") (put! row "expectedExit" 137)))))
            (put! row "args" #a((JSON:stringify spec)))
            (swap! pairs append-item #a(row:id (JSON:stringify spec)))))
        (swap! rows append-item row))))
  (ensure (= (get (express rows) "length") 349) "349 original YAML owners")
  (bind selected (-> (express rows) (:filter (fn (:object r) (= r:phase "matrix")))) )
  (ensure (= selected:length 26) "18 executable resource + 8 file variants")
  (ensure (= (get (-> (express rows) (:filter (fn (:object r) (= r:phase "unsupported")))) "length") 36) "36 unsupported resource cells")
  (bind first-case (get selected 0))
  (for-of name #a("inspector-control" "unknown-operation" "unknown-case" "unknown-options")
    (bind probe (or (= name "unknown-case") (= name "unknown-options")))
    (bind bad (? (= name "unknown-case") (obj :id "UNKNOWN") (assoc first-case:case :options (obj :schema "unsupported"))))
    (swap! rows append-item (obj :id (template "HP-" name) :family "HP" :owner owner :phase "harness" :stopFamily name
      :op (? probe "probe" name) :args (? probe #a((JSON:stringify bad)) #a()) :files #a() :flags #a() :repeats 2
      :expectedExit (? (= name "inspector-control") 0 1) :expected "bounded inspector or dispatch rejection")))
  (for-of name #a("raw-interrupt" "safe-interrupt")
    (bind prior (-> (express rows) (:find (fn (:object r) (= r:id (template "Y-16-" name))))))
    (swap! rows append-item (assoc prior :id (template "HP-" name) :family "HP" :phase "harness" :repeats 1)))
  (write-json! "inputs.json" (obj :protocol "RP01/FM01/AE01" :revision "YR-M01" :originalSha256 original-hash
    :resourceCells 54 :fileVariants 8 :unsupportedCells 36 :executableResourceCells 18 :resourceAttemptCeiling 108 :fileAttempts 16
    :inspection (obj :depth 256 :visits 4096 :nodes 2047 :members 2048 :stringUnits 4096 :binaryBytes 4096 :emittedRecordBytes 1048576)
    :variants (express rows)))
  (bind source (Deno:read-text-file-sync "cases.lykn"))
  (bind declaration (template ";; BEGIN CONTRACTS\n(bind contracts (new Map (JSON:parse " (JSON:stringify (JSON:stringify (express pairs))) ")))\n;; END CONTRACTS"))
  (Deno:write-text-file-sync "cases.lykn" (source:replace (regex ";; BEGIN CONTRACTS[\\s\\S]*?;; END CONTRACTS") (fn () declaration)))
  (Deno:write-text-file-sync "resource-inputs.jsonl" (template (-> (Array:from (recipes:values)) (:map (fn (:object r) (JSON:stringify r))) (:join "\n")) "\n"))
  (bind lines (cell #a("# Frozen resource/file crosswalk — YR-M01" "" "All original 349 rows are retained verbatim under original in inputs.json. Eighteen default parse/stringify cells have a ceiling of six attempts; 36 unavailable conversion/bound cells are unsupported. Eight file faults repeat twice. Ten harness attempts and three stop controls are separate. Original questions remain unchanged." "" "| ID | Phase | Owner | Original question |" "| --- | --- | --- | --- |")))
  (for-of row (express rows) (swap! lines append-item (template "| " row:id " | " row:phase " | " row:owner " | " row:expected " |")))
  (Deno:write-text-file-sync "case-manifest.md" (template (-> (express lines) (:join "\n")) "\n"))
  (console:log (JSON:stringify (obj :freeze "pass" :checks (express checks) :uniqueRecipes recipes:size)))))
(func graph-check :args () :body
  (bind graph (read-json "dependency-graph.json"))
  (ensure (= (get (Object:keys (?? graph:npmPackages (obj))) "length") 0) "no npm graph")
  (ensure (= graph:modules:length 26) "26 actual modules")
  (for-of module graph:modules
    (ensure (not (or (module:specifier:starts-with "node:") (module:specifier:starts-with "npm:") (Object:has-own module "error"))) "module graph error/Node/npm"))
  (bind lock (read-json "deno.lock"))
  (ensure (= (JSON:stringify (Object:keys lock:jsr)) "[\"@std/yaml@1.2.0\"]") "exact package pin")
  (console:log (JSON:stringify (obj :graph "pass" :checks (express checks)))))
(bind mode (get Deno:args 0))
(if (= mode "freeze") (await (freeze)))
(if (= mode "graph") (graph-check))
(func events :args (:object row) :body
  (-> row:stdout (:trim) (:split "\n") (:filter (fn (:string line) (> line:length 0)))
    (:map (fn (:string line) (JSON:parse line)))))
(func fact :args (:array stream :string label) :body
  (bind found (stream:filter (fn (:array item) (= (get item 0) label))))
  (ensure (= found:length 1) (template "one event " label))
  (get (get found 0) 1))
(func same :args (:any left :any right) :body (= (JSON:stringify left) (JSON:stringify right)))
(func at-path :args (:array files :string path) :body
  (files:find (fn (:object entry) (= entry:path path))))
(func same-files :args (:array left :array right) :body
  (func sorted :args (:array values) :body
    (-> (values:slice) (:sort (fn (:object a :object b) (a:path:locale-compare b:path)))))
  (same (sorted left) (sorted right)))
(func entry :args (:object node :string key) :body
  (bind pair (node:entries:find (fn (:array pair) (= (get (get pair 0) "value") key))))
  (ensure (not (= pair undefined)) (template "own key " key))
  (get pair 1))
(async (func stream-check :args (:object row) :body
  (for-of label #a("stdout" "stderr")
    (bind text (get row label))
    (bind bytes (encoder:encode text))
    (ensure (= (hex bytes) (get row (template label "Hex"))) "exact stream bytes")
    (ensure (= (await (digest bytes)) (get row (template label "Sha256"))) "exact stream hash"))
  (ensure (= row:outputBytesRetained (+ (/ row:stdoutHex:length 2) (/ row:stderrHex:length 2))) "combined retained bytes")
  (ensure (<= row:outputBytesRetained 16777216) "retention cap")
  (ensure (<= row:outputBytesRetained row:outputBytesObserved) "drain accounting")
  (ensure (= row:survivors:length 0) "no observed survivor")
  (ensure (> row:maxSampledTreeRssKiB 0) "positive host RSS observation")
  (ensure (= row:harnessError null) "no harness error")
  (ensure (= row:sourceSha256 (await (digest (Deno:read-file-sync "cases.lykn")))) "retained source matches child")
  (ensure (= row:compiledSha256 (await (digest (Deno:read-file-sync "cases.js")))) "reviewed emitted bytes match child")
  (ensure (= row:configText (Deno:read-text-file-sync "project.json")) "actual config bytes")
  (if (not (= row:phase "control")) (ensure (= row:lockText (Deno:read-text-file-sync "deno.lock")) "frozen actual lock"))
  (ensure (= row:preparation:exit 0) "fixture preparation succeeded")
  (ensure (= row:environment:PATH "/opt/homebrew/bin:/usr/bin:/bin") "real executable PATH")
  (ensure (= row:environment:HOME (template row:cwd "/home")) "fresh HOME")
  (ensure (= row:environment:TMPDIR (template row:cwd "/tmp")) "fresh TMPDIR")
  (ensure (= row:environment:DENO_DIR (template row:cwd "/cache")) "fresh cache")
  (ensure (= row:environment:DENO_NO_UPDATE_CHECK "1") "no update checks")
  (ensure (= row:environment:NO_COLOR "1") "no color")
  (ensure (row:command:includes "--no-prompt") "no prompt")
  (ensure (not (or (row:command:includes "-A") (row:command:includes "--allow-all"))) "no blanket grants")))
(async (func states-check :args (:object row) :body
  (for-of label #a("preparedInput" "preparedOutput" "inputState" "outputBefore" "inputAfter" "outputAfter" "inputRestored" "outputCleaned")
    (for-of file (get row label)
      (ensure (and (not (file:path:starts-with "/")) (not (file:path:includes ".."))) "relative fixture path")
      (if file:sha256
        (do
          (ensure (<= file:size 9437184) "bounded fixture size")
          (if (not (= file:hex null))
            (do (ensure (<= file:size 4096) "bounded complete hex")
              (bind bytes (unhex file:hex))
              (ensure (= bytes:length file:size) "file hex length")
              (ensure (= (await (digest bytes)) file:sha256) "file hex hash")
              (ensure (= (hex (bytes:slice 0 64)) file:previewHex) "file preview matches bytes")))
          (ensure (<= file:previewHex:length 128) "bounded preview")))))
  null))
(func partial-check :args (:object row :array stream) :body
  (ensure (= row:stopReason "partial-write") "checkpoint stop reason")
  (ensure (= row:exit 137) "killed exit")
  (ensure (= row:signal "SIGKILL") "external SIGKILL")
  (ensure (> row:kills:length 0) "kill command retained")
  (bind proof row:checkpoint)
  (bind marker proof:marker)
  (bind serialized (fact stream "serializedText"))
  (bind bytes (encoder:encode serialized))
  (ensure (= marker:fullBytes bytes:length) "checkpoint complete output size")
  (ensure (= marker:partialBytes (Math:floor (/ bytes:length 2))) "declared partial byte count")
  (ensure (= marker:partialHex (hex (bytes:slice 0 marker:partialBytes))) "partial exact output prefix")
  (ensure (same marker (fact stream "checkpoint")) "child and observer checkpoint agree")
  (ensure (same-files proof:visibleBeforeKill row:outputAfter) "aftermath equals independently visible pre-kill state")
  (ensure (> proof:observedMs 0) "checkpoint precedes recorded termination")
  (ensure (<= proof:observedMs row:wallMs) "checkpoint time before finish")
  (bind part (at-path row:outputAfter marker:path))
  (ensure (= part:hex marker:partialHex) "actual partial aftermath")
  (bind dest (at-path row:outputAfter "outputs/destination.yaml"))
  (if (= row:faultMode "raw-interrupt")
    (ensure (= dest:hex marker:partialHex) "raw destination was truncated to partial output")
    (do (ensure (= dest:hex "4f524947494e414c0a") "safe interruption preserves old destination")
      (ensure (= (at-path row:outputCleaned "outputs/replacement.tmp") undefined) "orphan removed only after evidence")
      (ensure (> row:cleanup:length 0) "orphan cleanup explicit"))))
(async (func controls-check :args () :body
  (graph-check)
  (bind controls (records "controls.stdout"))
  (ensure (= controls:length 3) "three external controls")
  (for-of row controls
    (await (stream-check row))
    (ensure (= row:stopReason (? (= row:id "control-timeout") "wall" (? (= row:id "control-output") "output" "rss"))) "correct external control reason")
    (ensure (= row:exit 137) "control externally killed")
    (ensure (> row:kills:length 0) "external control signal"))
  (bind harness (records "harness.stdout"))
  (ensure (= harness:length 10) "ten harness attempts")
  (for-of row harness
    (await (stream-check row)) (await (states-check row))
    (if row:checkpoint
      (partial-check row (events row))
      (do (ensure (= row:stopReason null) "no unintended harness cap")
        (if (= row:id "HP-inspector-control")
          (do (ensure (= row:exit 0) "inspector successful")
            (bind stream (events row))
            (ensure (= (get (entry (fact stream "cycle") "self") "kind") "reference") "cycle reference")
            (bind string (fact stream "stringBound"))
            (ensure (and (= string:length 8388608) (= string:value:length 4096) string:truncated) "bounded 8MiB string observation")
            (ensure (-> (JSON:stringify (fact stream "depthBound")) (:includes "depth-bound")) "depth bound")
            (ensure (get (fact stream "memberBound") "truncated") "member bound"))
          (do (ensure (= row:exit 1) "dispatch rejected")
            (ensure (or (row:stderr:includes "Unknown operation") (row:stderr:includes "Unknown case ID")
              (row:stderr:includes "Exact operation/options contract mismatch")) "explicit dispatch error"))))))
  (ensure (= (-> (Deno:read-text-file-sync "meta/permission-denied.exit") (:trim)) "1") "actual denial exit")
  (ensure (-> (Deno:read-text-file-sync "meta/permission-denied.stderr") (:includes "NotCapable")) "actual Deno denial")
  (ensure (= (-> (Deno:read-text-file-sync "meta/permission-scoped.exit") (:trim)) "0") "scoped read exit")
  (ensure (= (-> (Deno:read-text-file-sync "meta/permission-scoped.stdout") (:trim)) "CONTROL") "actual scoped read")
  (bind argv (-> (Deno:read-text-file-sync "meta/argv.bin") (:split "\u0000")))
  (ensure (= (get argv 0) "run") "argv run")
  (ensure (and (> (argv:index-of "--allow-read=./inputs") 0) (< (argv:index-of "--allow-read=./inputs") (argv:index-of "--"))) "read flag effective")
  (ensure (> (argv:index-of "--allow-all") (argv:index-of "--")) "trailing flag remains script data")
  (Deno:write-text-file-sync "permissions-verified.txt" "Real denied/scoped read, argv, graph, controls and checkpoints audited\n")
  (console:log (JSON:stringify (obj :controls "pass" :checks (express checks) :supervisor 3 :harness 10)))))
(if (= mode "preflight") (await (controls-check)))
(async (func source-capture :args () :body
  (bind graph (read-json "dependency-graph.json"))
  (Deno:mkdir-sync "package-source" (obj :recursive true))
  (bind evidence (cell #a()))
  (for-of module graph:modules
    (if (module:specifier:starts-with "https://jsr.io/@std/yaml/1.2.0/")
      (do (bind raw (Deno:read-text-file-sync module:local))
        (bind source (get (raw:split "\n// denoCacheMetadata=") 0))
        (bind path (module:specifier:replace "https://jsr.io/@std/yaml/1.2.0/" "package-source/"))
        (Deno:mkdir-sync (path:slice 0 (path:last-index-of "/")) (obj :recursive true))
        (Deno:write-text-file-sync path source)
        (swap! evidence append-item (obj :url module:specifier :path path :sourceSha256 (await (digest (encoder:encode source)))
          :omission "Deno cache transport metadata only; no package source changed")))))
  (write-json! "package-source-index.json" (express evidence))
  (console:log (JSON:stringify (obj :sources "retained" :modules (get (express evidence) "length"))))))
(if (= mode "sources") (await (source-capture)))
(func value-check :args (:object recipe :object value) :body
  (if (= recipe:kind "string")
    (do (ensure (= value:kind "string") "scalar is string")
      (ensure (= value:length recipe:size) "exact scalar length")
      (ensure (= value:value (String:prototype:repeat:call "x" (Math:min recipe:size 4096))) "exact bounded scalar preview")
      (ensure (= value:truncated (> recipe:size 4096)) "honest scalar truncation")
      (return)))
  (if (= recipe:kind "depth")
    (do (bind node (cell value))
      (for-of i (Array:from (obj :length recipe:size) (fn (:any ignored :number i) i))
        (ensure (= (get (express node) "kind") "array") "nested sequence kind")
        (ensure (= (get (express node) "length") 1) "single nested member")
        (reset! node (entry (express node) "0")))
      (ensure (= (get (express node) "kind") "number") "deep leaf number")
      (ensure (= (get (express node) "value") "0") "deep leaf zero")
      (return)))
  (ensure (= value:kind "object") "DAG root mapping")
  (ensure (= value:entries:length (+ recipe:size 1)) "all DAG levels represented")
  (bind base (entry value "base"))
  (ensure (= base:kind "array") "base sequence")
  (ensure (= base:length 2) "base fanout")
  (for-of key #a("0" "1") (ensure (= (get (entry base key) "value") "x") "base x leaf"))
  (bind previous (cell base:id))
  (for-of n (Array:from (obj :length recipe:size) (fn (:any ignored :number i) (+ i 1)))
    (bind node (entry value (template "a" n)))
    (ensure (= node:kind "array") "alias level sequence")
    (ensure (= node:length 2) "alias fanout two")
    (for-of key #a("0" "1")
      (bind ref (entry node key))
      (ensure (= ref:kind "reference") "alias does not expand for logging")
      (ensure (= ref:id (express previous)) "both aliases share previous identity"))
    (reset! previous node:id)))
(func mode-bits :args (:number mode-number) :body
  (Number:parse-int (-> (mode-number:to-string 8) (:slice -3)) 8))
(async (func file-check :args (:object row :object spec :array stream) :body
  (bind failure spec:case:failure)
  (bind prepared (at-path row:preparedInput "inputs/source.yaml"))
  (ensure (= prepared:sha256 spec:inputSha256) "original source before fault")
  (ensure (= prepared:hex spec:case:hex) "independent source bytes")
  (if (= failure "missing")
    (do (ensure (= row:inputState:length 0) "missing at invocation")
      (ensure (= row:inputAfter:length 0) "missing after failure"))
    (do
      (bind restored (at-path row:inputRestored "inputs/source.yaml"))
      (ensure (= restored:hex prepared:hex) "source preserved through fault/restoration")
      (if (= failure "unreadable")
        (do (bind inaccessible (at-path row:inputState "inputs/source.yaml"))
          (ensure (= (mode-bits inaccessible:mode) 0) "mode 000 active")
          (ensure (> inaccessible:error:length 0) "parent records inaccessible file")
          (ensure (= (mode-bits restored:mode) 384) "explicit mode restoration")
          (ensure (> row:cleanup:length 0) "mode restoration after evidence"))
        (ensure (same-files row:inputState row:inputAfter) "source unchanged"))))
  (if (or (= failure "raw-interrupt") (= failure "safe-interrupt"))
    (do (partial-check row stream)
      (ensure (= row:checkpoint:marker:fullSha256 (await (digest (encoder:encode (fact stream "serializedText"))))) "full output checkpoint hash")
      (return)))
  (ensure (= row:stopReason null) "ordinary fault not timeout")
  (ensure (= row:exit 0) "fault captured as structured outcome")
  (ensure (= (fact stream "status") "fault-observed") "actual fault expressed")
  (bind error (fact stream "error"))
  (bind observed (fact stream "fault"))
  (ensure (not (= error:name "NotCapable")) "OS operation not Deno grant denial")
  (ensure (> error:message:length 0) "complete operation message")
  (bind expected-stage (? (or (= failure "missing") (= failure "unreadable")) "read-input"
    (? (or (= failure "missing-parent") (= failure "unwritable")) "open-write"
      (? (= failure "rename-injected") "pre-rename" "rename"))))
  (ensure (= error:stage expected-stage) "fault at specified operation")
  (ensure (= observed:stage expected-stage) "structured stage agrees")
  (ensure (= observed:class (? (= failure "rename-injected") "deliberate-injection" "operation-error")) "OS versus injection class")
  (if (= failure "rename-injected") (ensure (= error:message "DECLARED_INJECTION_BEFORE_RENAME") "literal deliberate injection"))
  (if (or (= failure "missing") (= failure "missing-parent")) (ensure (= error:name "NotFound") "actual missing file/path error"))
  (if (or (= failure "unreadable") (= failure "unwritable")) (ensure (= error:name "PermissionDenied") "actual filesystem permission error"))
  (if (= failure "unwritable")
    (ensure (= (mode-bits (get (at-path row:outputBefore "outputs/blocked") "mode")) 320) "directory mode 0500"))
  (if (or (= failure "rename-injected") (= failure "rename-directory"))
    (do
      (bind orphan (at-path row:outputAfter "outputs/replacement.tmp"))
      (ensure (= orphan:hex (hex (encoder:encode (fact stream "serializedText")))) "full orphan serialization bytes")
      (ensure (= (at-path row:outputCleaned "outputs/replacement.tmp") undefined) "orphan separately cleaned")
      (ensure (> row:cleanup:length 0) "cleanup receipt")
      (ensure (same-files row:outputBefore (row:outputAfter:filter (fn (:object file) (not (= file:path "outputs/replacement.tmp"))))) "existing destination/sentinel preserved"))
    (ensure (same-files row:outputBefore row:outputAfter) "fault leaves output state unchanged"))
  (if (= failure "rename-directory")
    (do (ensure (not (= error:name "Error")) "actual typed rename error")
      (ensure (= (get (at-path row:outputAfter "outputs/destination.yaml/sentinel.txt") "hex") "4449524543544f52592d53454e54494e454c0a") "directory sentinel intact")))))
(func summary-stats :args (:array values) :body
  (if (= values:length 0) (return null))
  (bind sorted (-> (values:slice) (:sort (fn (:number a :number b) (- a b)))))
  (obj :values values :median (get sorted (Math:floor (/ sorted:length 2))) :min (get sorted 0) :max (get sorted (- sorted:length 1))))
(async (func audit :args () :body
  (await (controls-check))
  (bind manifest (read-json "inputs.json"))
  (bind original (read-json "yp-inputs.json"))
  (ensure (= (await (digest (Deno:read-file-sync "yp-inputs.json"))) original-hash) "YP-M01 bytes retained")
  (bind originals (original:variants:filter (fn (:object r) (r:id:starts-with "Y-"))))
  (bind rows (manifest:variants:filter (fn (:object r) (r:id:starts-with "Y-"))))
  (ensure (= rows:length 349) "full owner crosswalk")
  (for-of pair (rows:entries)
    (bind row (get pair 1))
    (bind prior (get originals (get pair 0)))
    (ensure (same row:original prior) "original row verbatim")
    (ensure (and (= row:id prior:id) (= row:owner prior:owner) (= row:inputSha256 prior:inputSha256) (= row:encodedBytes prior:encodedBytes)) "original identity owner and bytes"))
  (bind recipes (records "resource-inputs.jsonl"))
  (ensure (= recipes:length 9) "nine unique deterministic recipes")
  (for-of recipe recipes
    (bind bytes (encoder:encode (recipe-text recipe)))
    (ensure (= bytes:length recipe:encodedBytes) "recipe exact length")
    (ensure (= (await (digest bytes)) recipe:sha256) "recipe exact hash"))
  (bind raw (records "matrix.stdout"))
  (bind runs (raw:filter (fn (:object r) (Object:has-own r "attempt"))))
  (bind unique (new Set))
  (bind results (cell #a()))
  (bind file-results (cell #a()))
  (bind counts (obj :resourceCells 54 :unsupportedCells 0 :resourceAttempts 0 :warmups 0 :measurements 0
    :fileVariants 8 :fileAttempts 0 :stoppedAttempts 0 :notRunAttempts 0 :notRunCells 0 :warnings 0))
  (for-of row runs
    (ensure (not (unique:has row:cwd)) "fresh CWD per attempt") (unique:add row:cwd)
    (await (stream-check row)) (await (states-check row))
    (ensure (and (row:command:includes "--cached-only") (row:command:includes "--frozen=true")) "cached frozen package child")
    (bind spec (rows:find (fn (:object r) (= r:id row:id))))
    (ensure (and (not (= spec undefined)) (= spec:phase "matrix")) "only executable frozen IDs invoked")
    (for-of flag spec:flags (ensure (row:command:includes flag) "declared narrow grant present"))
    (ensure (= (get row:command (- row:command:length 1)) (get spec:args 0)) "exact short dispatch spec")
    (if (not (= row:stopReason null)) (put! counts "stoppedAttempts" (+ counts:stoppedAttempts 1)))
    (bind stream (events row))
    (bind warnings (stream:filter (fn (:array e) (= (get e 0) "warning"))))
    (for-of e warnings
      (bind warning (get e 1))
      (ensure (and (> warning:name:length 0) (> warning:message:length 0) (> warning:stage:length 0)) "ordered warning details"))
    (put! counts "warnings" (+ counts:warnings warnings:length))
    (if (= spec:family "Y-16")
      (do (put! counts "fileAttempts" (+ counts:fileAttempts 1))
        (await (file-check row spec stream))
        (swap! file-results append-item (obj :id row:id :attempt row:attempt :exit row:exit :signal row:signal
          :faults (stream:filter (fn (:array event) (-> #a("error" "fault" "serializedText" "checkpoint" "original" "edited") (:includes (get event 0)))))
          :preparedInput row:preparedInput :preparedOutput row:preparedOutput :inputState row:inputState
          :outputBefore row:outputBefore :inputAfter row:inputAfter :outputAfter row:outputAfter
          :checkpoint row:checkpoint :cleanup row:cleanup :inputRestored row:inputRestored :outputCleaned row:outputCleaned)))
      (do
        (put! counts "resourceAttempts" (+ counts:resourceAttempts 1))
        (bind phase (? (= row:attempt 1) "warmups" "measurements"))
        (put! counts phase (+ (get counts phase) 1))
        (ensure (same-files row:inputState row:inputAfter) "resource input unchanged")
        (ensure (= row:outputAfter:length 0) "resource has no file outputs")
        (bind input (at-path row:inputState "inputs/source.yaml"))
        (ensure (= input:sha256 spec:inputSha256) "actual resource input hash")
        (ensure (= input:size spec:encodedBytes) "actual resource input length")
        (if (= row:stopReason null)
          (do (ensure (= row:exit 0) "resource child success")
            (ensure (= (fact stream "status") "complete") "complete package operation")
            (ensure (= (get (fact stream "input") "sha256") spec:inputSha256) "child independently verified input")
            (ensure (= (get (fact stream "input") "bytes") spec:encodedBytes) "child verified input size")
            (ensure (same (fact stream "exports") #a("YamlSyntaxError" "parse" "parseAll" "stringify")) "actual public value exports")
            (value-check spec:case:recipe (fact stream "value"))
            (bind timings (stream:filter (fn (:array e) (= (get e 0) "timing"))))
            (bind operation spec:case:recipe:operation)
            (ensure (= timings:length (? (= operation "parse") 1 2)) "separate parse setup/stringify timers")
            (ensure (same (timings:map (fn (:array e) (get (get e 1) "stage"))) (? (= operation "parse") #a("parse") #a("setup-parse" "stringify"))) "stage attribution")
            (for-of e timings
              (bind timing (get e 1))
              (ensure (and timing:ok (Number:is-finite timing:ms) (>= timing:ms 0) (< timing:ms row:wallMs)) "finite stage duration within child"))
            (if (= operation "stringify")
              (do (bind serialized (fact stream "serialized"))
                (ensure (> serialized:bytes 0) "serializer output size measured")
                (ensure (= serialized:sha256:length 64) "serializer output digest measured")
                (ensure (<= serialized:previewHex:length 128) "serializer output bounded preview"))))
          (do (ensure (-> #a("rss" "wall" "output") (:includes row:stopReason)) "declared resource stop")
            (ensure (= row:exit 137) "resource cap externally killed")
            (ensure (= row:signal "SIGKILL") "cap signal")
            (if (= row:stopReason "rss") (ensure (> row:maxSampledTreeRssKiB 524288) "observed RSS crossed cap"))
            (if (= row:stopReason "wall") (ensure (> row:wallMs 10000) "wall crossed cap"))
            (if (= row:stopReason "output") (ensure (> row:outputBytesObserved 16777216) "output crossed cap")))))))
  (for-of spec (rows:filter (fn (:object r) (= r:owner owner)))
    (bind attempts (runs:filter (fn (:object r) (= r:id spec:id))))
    (bind dispositions (raw:filter (fn (:object r) (and (= r:id spec:id) (not (Object:has-own r "attempt"))))))
    (if (= spec:phase "unsupported")
      (do (ensure (= attempts:length 0) "unsupported never invoked")
        (ensure (= dispositions:length 1) "unsupported disposition retained")
        (bind item (get dispositions 0))
        (ensure (and (= item:attempts 0) (= item:phase "unsupported") (same item:disposition spec:unsupported)) "exact unsupported reason/re-entry")
        (put! counts "unsupportedCells" (+ counts:unsupportedCells 1))
        (swap! results append-item (obj :id spec:id :outcome "unsupported" :reason spec:unsupported :attempts 0)))
      (do
        (bind owed (dispositions:reduce (fn (:number sum :object r) (+ sum r:attemptsOwed)) 0))
        (ensure (= (+ attempts:length owed) spec:repeats) "all repetitions accounted")
        (put! counts "notRunAttempts" (+ counts:notRunAttempts owed))
        (if (= attempts:length 0) (put! counts "notRunCells" (+ counts:notRunCells 1)))
        (for-of pair (attempts:entries) (ensure (= (get (get pair 1) "attempt") (+ (get pair 0) 1)) "ordered fresh repetitions"))
        (for-of disposition dispositions
          (ensure (and (= disposition:owner owner) (> disposition:reentry:length 0)) "not-run ownership/re-entry")
          (ensure (runs:some (fn (:object r)
            (bind prior (rows:find (fn (:object candidate) (= candidate:id r:id))))
            (and (= prior:stopFamily spec:stopFamily) (not (= r:stopReason null))))) "not-run has actual earlier family stop"))
        (if (= spec:family "Y-13")
          (do
            (bind measured (attempts:filter (fn (:object r) (and (> r:attempt 1) (= r:stopReason null)))))
            (bind stage-values (measured:map (fn (:object r)
              (bind timing (-> (events r) (:find (fn (:array e) (and (= (get e 0) "timing") (= (get (get e 1) "stage") spec:case:recipe:operation))))))
              (get (get timing 1) "ms"))))
            (bind snapshots (attempts:filter (fn (:object r) (= r:stopReason null))))
            (if (> snapshots:length 1)
              (do (bind first (events (get snapshots 0)))
                (for-of r (snapshots:slice 1)
                  (bind current (events r))
                  (ensure (same (fact first "value") (fact current "value")) "repeatable bounded value facts")
                  (if (= spec:case:recipe:operation "stringify")
                    (ensure (same (fact first "serialized") (fact current "serialized")) "repeatable serializer bytes/digest")))))
            (swap! results append-item (obj :id spec:id :outcome (? (= owed 0) "complete" "protocol-stop")
              :recipe spec:case:recipe :attempts attempts:length :notRun dispositions
              :packageMs (summary-stats stage-values)
              :wholeChildMs (summary-stats (measured:map (fn (:object r) r:wallMs)))
              :sampledTreeRssKiB (summary-stats (measured:map (fn (:object r) r:maxSampledTreeRssKiB)))
              :raw (attempts:map (fn (:object r) (obj :attempt r:attempt :role (? (= r:attempt 1) "warm-up" "measured")
                :stopReason r:stopReason :wallMs r:wallMs :maxSampledTreeRssKiB r:maxSampledTreeRssKiB :events (events r)))))))))))
  (ensure (= counts:unsupportedCells 36) "all unsupported cells retained")
  (ensure (= counts:fileAttempts 16) "all file repetitions retained")
  (ensure (= (+ counts:resourceAttempts counts:notRunAttempts) 108) "resource attempt ceiling reconciles")
  (Deno:write-text-file-sync "results.md" (template "# YAML resource outcomes — YR-M01\n\nSame-author host observations. Package timers exclude file preparation/inspection; whole-child timings and sampled RSS include them. One warm-up plus five measurements where completed; raw arrays and median/range are descriptive only. Unsupported and protocol not-runs are not measurements.\n\n```json\n" (JSON:stringify (obj :counts counts :cells (express results)) null 2) "\n```\n"))
  (Deno:write-text-file-sync "file-audit.md" (template "# File-fault byte and state audit\n\nTwo fresh attempts per variant. All before/after states precede separate cleanup. OS errors, Deno denials and injection remain distinct. Partial-write checkpoint bytes were independently reread before external termination; no durability or concurrency claim.\n\n```json\n" (JSON:stringify (express file-results) null 2) "\n```\n"))
  (console:log (JSON:stringify (obj :audit "pass" :checks (express checks) :counts counts)))))
(if (= mode "audit") (await (audit)))
(func planning-check :args (:string root) :body
  (bind prompt (Deno:read-text-file-sync (template root "/project07-core-library-research/arc01-format-runtime-evidence/slice06-yaml-resource-and-files/cc-prompt.md")))
  (bind allowed (new Set (-> prompt (:split "\n") (:filter (fn (:string line)
    (or (line:starts-with "project07-core-library-research/") (line:starts-with "backlog/")))))))
  (bind paths (-> (Deno:read-text-file-sync "changed-paths.txt") (:trim) (:split "\n")))
  (bind links (cell 0))
  (for-of path paths
    (ensure (allowed:has path) (template "explicit scope " path))
    (if (path:ends-with ".md")
      (do (bind text (Deno:read-text-file-sync (template root "/" path)))
        (bind prose (text:replace (regex "```[\\s\\S]*?```" "g") ""))
        (bind base (new URL (template "file://" root "/" path)))
        (for-of match (prose:match-all (regex "\\]\\(([^\\s)]+)\\)" "g"))
          (bind target (get match 1))
          (if (not (or (target:starts-with "https:") (target:starts-with "http:") (target:starts-with "#")))
            (do (Deno:stat-sync (new URL target base)) (swap! links + 1)))))))
  (console:log (JSON:stringify (obj :planning "pass" :paths paths:length :links (express links) :checks (express checks)))))
(if (= mode "planning") (planning-check (get Deno:args 1)))
(func write-all! :args (:any file :any bytes) :body
  (bind offset (cell 0))
  (while (< (express offset) bytes:length)
    (bind written (file:write-sync (bytes:subarray (express offset))))
    (ensure (> written 0) "packet write progress")
    (swap! offset + written))
  null)
(async (func packet :args (:string operation :string root) :body
  (if (= operation "pack")
    (do (bind paths (-> (Deno:read-text-file-sync "packet-paths.txt") (:trim) (:split "\n")))
      (bind output (Deno:open-sync "raw-transcript.txt" (obj :write true :create true :truncate true)))
      (try
        (for-of path paths
          (ensure (not (or (path:starts-with "/") (path:includes ".."))) "relative packet path")
          (bind bytes (Deno:read-file-sync (template root "/" path)))
          (bind text (decoder:decode bytes))
          (write-all! output (encoder:encode (template (JSON:stringify (obj :file path :bytes bytes:length :sha256 (await (digest bytes)) :text text)) "\n"))))
        (output:sync-sync)
        (finally (output:close)))
      (console:log (JSON:stringify (obj :packet "pass" :files paths:length :checks (express checks))))
      (return)))
  (bind input (records (get Deno:args 2)))
  (for-of record input
    (ensure (not (or (record:file:starts-with "/") (record:file:includes ".."))) "relative extraction path")
    (bind bytes (encoder:encode record:text))
    (ensure (= bytes:length record:bytes) "packet byte count")
    (ensure (= (await (digest bytes)) record:sha256) "packet hash")
    (bind destination (template root "/" record:file))
    (Deno:mkdir-sync (destination:slice 0 (destination:last-index-of "/")) (obj :recursive true))
    (Deno:write-file-sync destination bytes (obj :create-new true)))
  (console:log (JSON:stringify (obj :extraction "pass" :files input:length :checks (express checks))))))
(if (= mode "pack") (await (packet "pack" (get Deno:args 1))))
(if (= mode "extract") (await (packet "extract" (get Deno:args 1))))
(ensure (-> #a("freeze" "graph" "sources" "preflight" "audit" "planning" "pack" "extract") (:includes mode)) "known audit mode")
