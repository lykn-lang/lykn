;; CDC comparison of fresh runtime evidence to the extracted CC confirmation.
;; argv[0]: CC confirmation directory. Run in the fresh trial, after audit.lykn.
(bind checks (cell 0))
(func equal :args (:any a :any b :string label) :body
  (swap! checks + 1)
  (if (not (= (JSON:stringify a) (JSON:stringify b))) (throw (new Error label))))
(func rows :args (:string path) :body
  (-> (Deno:read-text-file-sync path) (:trim) (:split "\n") (:map (fn (:string line) (JSON:parse line)))))
(func events :args (:object row) :body
  (-> row:stdout (:trim) (:split "\n") (:map (fn (:string line) (JSON:parse line)))))
(func fact :args (:object row :string label) :body
  (bind selected (-> (events row) (:filter (fn (:array event) (= (get event 0) label)))))
  (equal selected:length 1 (template "unique fact " label))
  (get (get selected 0) 1))
(func normalize-path :args (:any value :string cwd) :body
  (JSON:parse (-> (JSON:stringify value) (:replace-all cwd "<attempt>"))))
(func comparable-events :args (:object row) :body
  (bind stream (normalize-path (events row) row:cwd))
  (for-of event stream
    (bind label (get event 0))
    (bind value (get event 1))
    (if (or (= label "preparationMs") (= label "inspectionMs"))
      (do (equal (and (Number:is-finite value) (>= value 0)) true "valid observer timer")
        (Object:define-property event "1" (obj :value "<duration>"))))
    (if (= label "timing")
      (do (equal (and (Number:is-finite value:ms) (>= value:ms 0)) true "valid package timer")
        (Reflect:delete-property value "ms")))
    (if (= label "checkpoint") (Reflect:delete-property value "pid")))
  stream)
(func comparable-files :args (:array files :string cwd) :body
  (normalize-path (files:filter (fn (:object file) (not (= file:path "outputs/checkpoint.json")))) cwd))
(func hex :args (:any bytes) :body
  (-> (Array:from bytes) (:map (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(bind prior-root (get Deno:args 0))
(bind original (rows (template prior-root "/matrix.stdout")))
(bind current (rows "matrix.stdout"))
(equal original:length 160 "CC complete cell accounting")
(equal current:length 160 "CDC complete cell accounting")
(bind unique (new Set))
(bind attempted (cell 0))
(bind unsupported (cell 0))
(bind live-files (cell 0))
(for-of pair (current:entries)
  (bind row (get pair 1))
  (bind prior (get original (get pair 0)))
  (equal row:id prior:id "ordered identity")
  (bind key (template row:id ":" (?? row:attempt "unsupported")))
  (equal (unique:has key) false "unique cell/attempt")
  (unique:add key)
  (if (= row:phase "unsupported")
    (do (equal row prior "exact unsupported disposition") (swap! unsupported + 1))
    (do
      (swap! attempted + 1)
      (for-of field #a("attempt" "exit" "signal" "stopReason" "faultMode" "sourceSha256" "compiledSha256" "configText" "lockText")
        (equal (get row field) (get prior field) (template row:id " identity/outcome " field)))
      (equal (comparable-events row) (comparable-events prior) (template row:id " semantic stream"))
      (equal row:survivors #a() "no observed survivors")
      (equal row:harnessError null "no harness error")
      (for-of field #a("preparedInput" "preparedOutput" "inputState" "outputBefore" "inputAfter" "outputAfter" "inputRestored" "outputCleaned")
        (equal (comparable-files (get row field) row:cwd) (comparable-files (get prior field) prior:cwd)
          (template row:id " captured file state " field)))
      (for-of field #a("inputRestored" "outputCleaned")
        (for-of file (get row field)
          (if (and (Object:has-own file "sha256") (not (= file:path "outputs/checkpoint.json")))
            (do (bind bytes (Deno:read-file-sync (template row:cwd "/" file:path)))
              (swap! live-files + 1)
              (equal bytes:length file:size "live file byte count")
              (equal (await (digest bytes)) file:sha256 "live complete file digest")
              (equal (get (Deno:stat-sync (template row:cwd "/" file:path)) "mode") file:mode "live mode")))))
      (if row:checkpoint
        (do (bind marker (fact row "checkpoint"))
          (bind saved (JSON:parse (Deno:read-text-file-sync (template row:cwd "/outputs/checkpoint.json"))))
          (equal saved marker "live checkpoint payload")
          (equal marker:partialBytes 26 "partial bytes")
          (equal marker:fullBytes 53 "complete bytes")
          (equal row:stopReason "partial-write" "actual interrupted write")
          (bind dest (Deno:read-file-sync (template row:cwd "/outputs/destination.yaml")))
          (equal (hex dest) (? (= row:faultMode "raw-interrupt") marker:partialHex "4f524947494e414c0a") "live destination after interruption"))))))
(equal (express attempted) 124 "124 package/file attempts")
(equal (express unsupported) 36 "36 zero-attempt capabilities")
(equal (> (express live-files) 124) true "non-vacuous complete live file audit")
(bind cc-sources (JSON:parse (Deno:read-text-file-sync (template prior-root "/package-source-index.json"))))
(bind new-sources (JSON:parse (Deno:read-text-file-sync "package-source-index.json")))
(equal new-sources cc-sources "captured package source identity")
(console:log (JSON:stringify (obj :cdc "pass" :checks (express checks) :attempts (express attempted) :unsupported (express unsupported)
  :liveFiles (express live-files)
  :normalization #a("named durations" "attempt CWD strings" "checkpoint PID; checkpoint file audited independently"))))
