\\\"recipe\\\":{\\\"kind\\\":\\\"alias-dag\\\",\\\"size\\\":12,\\\"fanout\\\":2,\\\"bound\\\":\\\"explicit\\\",\\\"operation\\\":\\\"stringify\\\"},\\\"encodedLimit\\\":9437184,\\\"payloadLimit\\\":8388608,\\\"inputSha256\\\":\\\"24a060f0e5cf889c692fb03cdf34fe9d9cde7a8f010d73fb91c29be85bc386d7\\\",\\\"encodedBytes\\\":242}\"],[\"Y-16-missing\",\"{\\\"id\\\":\\\"Y-16-missing\\\",\\\"hex\\\":\\\"6e616d653a204164610a6e3a20310a666c6167733a205b747275652c2066616c73655d0a6e696c3a206e756c6c0a\\\",\\\"op\\\":\\\"file-failure\\\",\\\"options\\\":{\\\"schema\\\":\\\"default\\\"},\\\"stringifyOptions\\\":{\\\"schema\\\":\\\"default\\\"},\\\"edit\\\":\\\"n=2\\\",\\\"failure\\\":\\\"missing\\\"}\"],[\"Y-16-unreadable\",\"{\\\"id\\\":\\\"Y-16-unreadable\\\",\\\"hex\\\":\\\"6e616d653a204164610a6e3a20310a666c6167733a205b747275652c2066616c73655d0a6e696c3a206e756c6c0a\\\",\\\"op\\\":\\\"file-failure\\\",\\\"options\\\":{\\\"schema\\\":\\\"default\\\"},\\\"stringifyOptions\\\":{\\\"schema\\\":\\\"default\\\"},\\\"edit\\\":\\\"n=2\\\",\\\"failure\\\":\\\"unreadable\\\"}\"],[\"Y-16-missing-parent\",\"{\\\"id\\\":\\\"Y-16-missing-parent\\\",\\\"hex\\\":\\\"6e616d653a204164610a6e3a20310a666c6167733a205b747275652c2066616c73655d0a6e696c3a206e756c6c0a\\\",\\\"op\\\":\\\"file-failure\\\",\\\"options\\\":{\\\"schema\\\":\\\"default\\\"},\\\"stringifyOptions\\\":{\\\"schema\\\":\\\"default\\\"},\\\"edit\\\":\\\"n=2\\\",\\\"failure\\\":\\\"missing-parent\\\"}\"],[\"Y-16-unwritable\",\"{\\\"id\\\":\\\"Y-16-unwritable\\\",\\\"hex\\\":\\\"6e616d653a204164610a6e3a20310a666c6167733a205b747275652c2066616c73655d0a6e696c3a206e756c6c0a\\\",\\\"op\\\":\\\"file-failure\\\",\\\"options\\\":{\\\"schema\\\":\\\"default\\\"},\\\"stringifyOptions\\\":{\\\"schema\\\":\\\"default\\\"},\\\"edit\\\":\\\"n=2\\\",\\\"failure\\\":\\\"unwritable\\\"}\"],[\"Y-16-raw-interrupt\",\"{\\\"id\\\":\\\"Y-16-raw-interrupt\\\",\\\"hex\\\":\\\"6e616d653a204164610a6e3a20310a666c6167733a205b747275652c2066616c73655d0a6e696c3a206e756c6c0a\\\",\\\"op\\\":\\\"file-failure\\\",\\\"options\\\":{\\\"schema\\\":\\\"default\\\"},\\\"stringifyOptions\\\":{\\\"schema\\\":\\\"default\\\"},\\\"edit\\\":\\\"n=2\\\",\\\"failure\\\":\\\"raw-interrupt\\\"}\"],[\"Y-16-safe-interrupt\",\"{\\\"id\\\":\\\"Y-16-safe-interrupt\\\",\\\"hex\\\":\\\"6e616d653a204164610a6e3a20310a666c6167733a205b747275652c2066616c73655d0a6e696c3a206e756c6c0a\\\",\\\"op\\\":\\\"file-failure\\\",\\\"options\\\":{\\\"schema\\\":\\\"default\\\"},\\\"stringifyOptions\\\":{\\\"schema\\\":\\\"default\\\"},\\\"edit\\\":\\\"n=2\\\",\\\"failure\\\":\\\"safe-interrupt\\\"}\"],[\"Y-16-rename-injected\",\"{\\\"id\\\":\\\"Y-16-rename-injected\\\",\\\"hex\\\":\\\"6e616d653a204164610a6e3a20310a666c6167733a205b747275652c2066616c73655d0a6e696c3a206e756c6c0a\\\",\\\"op\\\":\\\"file-failure\\\",\\\"options\\\":{\\\"schema\\\":\\\"default\\\"},\\\"stringifyOptions\\\":{\\\"schema\\\":\\\"default\\\"},\\\"edit\\\":\\\"n=2\\\",\\\"failure\\\":\\\"rename-injected\\\"}\"],[\"Y-16-rename-directory\",\"{\\\"id\\\":\\\"Y-16-rename-directory\\\",\\\"hex\\\":\\\"6e616d653a204164610a6e3a20310a666c6167733a205b747275652c2066616c73655d0a6e696c3a206e756c6c0a\\\",\\\"op\\\":\\\"file-failure\\\",\\\"options\\\":{\\\"schema\\\":\\\"default\\\"},\\\"stringifyOptions\\\":{\\\"schema\\\":\\\"default\\\"},\\\"edit\\\":\\\"n=2\\\",\\\"failure\\\":\\\"rename-directory\\\"}\"]]")))
;; END CONTRACTS
(func put! :args (:object target :string key :any value) :body
  (Object:define-property target key (obj :value value :enumerable true :writable true :configurable true)))
(func warning-options :args (:string stage) :body
  (obj :schema "default" :onWarning (fn (:any err)
    (emit "warning" (obj :stage stage :name err:name :message err:message :details (tree err))))))
(func timed :args (:string stage :function action) :body
  (emit "stage-start" stage)
  (bind start (performance:now))
  (try
    (bind value (action))
    (bind ms (- (performance:now) start))
    (emit "timing" (obj :stage stage :ms ms :ok true))
    (return (obj :ok true :value value :ms ms))
    (catch err
      (bind failed-ms (- (performance:now) start))
      (emit "timing" (obj :stage stage :ms failed-ms :ok false))
      (error-fact stage err)
      (return (obj :ok false :ms failed-ms)))))
(async (func bytes-fact :args (:string label :any bytes) :body
  (emit label (obj :bytes bytes:length :sha256 (await (digest bytes))
    :previewHex (hex (bytes:slice 0 64)) :completePreview (<= bytes:length 64)))))
(async (func resource :args (:object spec) :body
  (bind start (performance:now))
  (bind bytes (Deno:read-file-sync "inputs/source.yaml"))
  (ensure (= bytes:length spec:encodedBytes) "resource file size")
  (ensure (= (await (digest bytes)) spec:inputSha256) "resource file hash")
  (ensure (<= bytes:length 9437184) "encoded budget")
  (bind text (-> (new TextDecoder) (:decode bytes)))
  (await (bytes-fact "input" bytes))
  (emit "preparationMs" (- (performance:now) start))
  (bind yaml (await (dynamic-import "@std/yaml")))
  (emit "exports" (-> (Object:keys yaml) (:sort)))
  (bind operation spec:recipe:operation)
  (ensure (and (= spec:recipe:bound "default") (or (= operation "parse") (= operation "stringify"))) "unsupported package capability")
  (bind options (warning-options (? (= operation "parse") "parse" "setup-parse")))
  (bind parsed (timed (? (= operation "parse") "parse" "setup-parse") (fn () (yaml:parse text options))))
  (if (not parsed:ok) (do (emit "status" (? (= operation "parse") "parse-rejected" "setup-rejected")) (return)))
  (bind result (? (= operation "parse") parsed (timed "stringify" (fn () (yaml:stringify parsed:value (obj :schema "default"))))))
  (if (not result:ok) (do (emit "status" "stringify-rejected") (return)))
  (bind inspect-start (performance:now))
  (emit "value" (tree parsed:value))
  (if (= operation "stringify") (await (bytes-fact "serialized" (encoder:encode result:value))))
  (emit "inspectionMs" (- (performance:now) inspect-start))
  (emit "status" "complete")))
(func write-all! :args (:any file :any bytes) :body
  (bind offset (cell 0))
  (while (< (express offset) bytes:length)
    (bind n (file:write-sync (bytes:subarray (express offset))))
    (ensure (> n 0) "write made no progress")
    (swap! offset + n))
  (express offset))
(async (func fault :args (:object spec) :body
  (bind failure spec:failure)
  (bind stage (cell "read-input"))
  (try
    (bind bytes (Deno:read-file-sync "inputs/source.yaml"))
    (ensure (= (hex bytes) spec:hex) "file input must match frozen bytes")
    (await (bytes-fact "input" bytes))
    (bind yaml (await (dynamic-import "@std/yaml")))
    (reset! stage "parse")
    (bind value (yaml:parse (-> (new TextDecoder) (:decode bytes)) (warning-options "parse")))
    (emit "original" (tree value))
    (put! value "n" 2)
    (emit "edited" (tree value))
    (reset! stage "serialize")
    (bind output (yaml:stringify value (obj :schema "default")))
    (bind data (encoder:encode output))
    (emit "serializedText" output)
    (await (bytes-fact "serialized" data))
    (reset! stage "validate")
    (bind validated (yaml:parse output (warning-options "validate")))
    (ensure (and (= validated:name "Ada") (= validated:n 2) (= validated:nil null)
      (= (JSON:stringify validated:flags) "[true,false]")) "independent edited value invariant")
    (bind parent (? (= failure "missing-parent") "outputs/absent"
      (? (= failure "unwritable") "outputs/blocked" "outputs")))
    (bind dest (template parent "/destination.yaml"))
    (bind temp (template parent "/replacement.tmp"))
    (bind raw (= failure "raw-interrupt"))
    (bind interrupted (or raw (= failure "safe-interrupt")))
    (bind path (? raw dest temp))
    (reset! stage "open-write")
    (bind file (Deno:open-sync path (? raw (obj :write true :truncate true) (obj :write true :create-new true))))
    (try
      (reset! stage "write")
      (if interrupted
        (do
          (bind part (data:slice 0 (Math:floor (/ data:length 2))))
          (write-all! file part)
          (file:sync-sync)
          (bind checkpoint (obj :pid Deno:pid :path path :partialBytes part:length :fullBytes data:length
            :partialHex (hex part) :fullSha256 (await (digest data)) :kind failure))
          (Deno:write-text-file-sync "outputs/checkpoint.json" (JSON:stringify checkpoint))
          (emit "checkpoint" checkpoint)
          (while true)))
      (write-all! file data)
      (reset! stage "sync")
      (file:sync-sync)
      (finally (file:close)))
    (reset! stage "pre-rename")
    (if (= failure "rename-injected") (throw (new Error "DECLARED_INJECTION_BEFORE_RENAME")))
    (reset! stage "rename")
    (Deno:rename-sync temp dest)
    (reset! stage "reread")
    (bind reread (Deno:read-file-sync dest))
    (ensure (= (hex reread) (hex data)) "full serialized destination reread")
    (await (bytes-fact "reread" reread))
    (emit "status" "fault-not-expressed")
    (catch err
      (error-fact (express stage) err)
      (emit "fault" (obj :requested failure :stage (express stage)
        :class (? (= err:message "DECLARED_INJECTION_BEFORE_RENAME") "deliberate-injection"
          (? (= err:name "NotCapable") "deno-permission-denial" "operation-error"))))
      (emit "status" "fault-observed")))))
(async (func dispatch :args () :body
  (bind op (get Deno:args 0))
  (bind arg (get Deno:args 1))
  (if (= op "materialize") (do (materialize arg) (return)))
  (if (= op "control-read") (do (console:log (Deno:read-text-file-sync "inputs/control.txt")) (return)))
  (if (= op "control-timeout") (do (emit "checkpoint" "busy-loop") (while true)))
  (if (= op "control-output") (while true (console:log "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")))
  (if (= op "control-rss") (do (await (new Promise (fn (:function resolve) (set-timeout resolve 3000)))) (return)))
  (if (= op "inspector-control")
    (do (bind cycle (obj)) (put! cycle "self" cycle)
      (emit "cycle" (tree cycle))
      (emit "stringBound" (tree (String:prototype:repeat:call "x" 8388608)))
      (bind nested (cell 0))
      (for-of i (Array:from (obj :length 258) (fn (:any ignored :number i) i)) (reset! nested #a((express nested))))
      (emit "depthBound" (tree (express nested)))
      (emit "memberBound" (tree (Array:from (obj :length 4098) (fn () 0))))
      (return)))
  (if (= op "probe")
    (do (bind spec (JSON:parse arg))
      (ensure (contracts:has spec:id) "Unknown case ID")
      (ensure (= (contracts:get spec:id) (JSON:stringify spec)) "Exact operation/options contract mismatch")
      (if (= spec:op "resource") (await (resource spec)) (await (fault spec)))
      (return)))
  (throw (new Error (template "Unknown operation: " op)))))
(await (dispatch))
