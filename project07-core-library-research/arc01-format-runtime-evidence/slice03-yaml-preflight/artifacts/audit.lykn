;; Lykn owns fixture generation and evidence audit. No package import here.
(bind encoder (new TextEncoder))
(bind checks (cell 0))
(func ensure :args (:boolean ok :string label) :body
  (swap! checks (fn (:number n) (+ n 1)))
  (if (not ok) (throw (new Error label))))
(func hex :args (:any bytes) :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(func unhex :args (:string text) :body
  (Uint8Array:from (?? (text:match (regex ".." "g")) #a()) (fn (:string p) (Number:parse-int p 16))))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func append-item :args (:array values :any item) :body (conj values item))
(bind schemas #a("failsafe" "json" "core" "default" "extended"))
(bind sentinel-ids (new Set #a("Y-01-edit" "Y-02-true-plain-default" "Y-02-true-plain-core"
  "Y-02-true-plain-failsafe" "Y-02-true-quoted-default" "Y-02-true-quoted-core"
  "Y-02-true-quoted-failsafe" "Y-04-duplicate-reject" "Y-05-alias" "Y-06-cycle"
  "Y-06-unresolved" "Y-08-two-parse" "Y-08-two-parseAll" "Y-09-malformed"
  "Y-10-noop" "Y-10-edit")))
(bind variants (cell #a()))
(func recipe-bytes :args (:object recipe) :body
  (if (= recipe:kind "depth")
    (return (encoder:encode (template (String:prototype:repeat:call "[" recipe:size) "0" (String:prototype:repeat:call "]" recipe:size) "\n"))))
  (if (= recipe:kind "string")
    (return (encoder:encode (template (String:prototype:repeat:call "x" recipe:size) "\n"))))
  (bind lines (cell #a("base: &a0 [x,x]")))
  (bind level (cell 1))
  (while (<= (express level) recipe:size)
    (bind n (express level))
    (swap! lines append-item (template "a" n ": &a" n " [*a" (- n 1) ",*a" (- n 1) "]"))
    (swap! level (fn (:number current) (+ current 1))))
  (encoder:encode (template (-> (express lines) (:join "\n")) "\n")))
(func add :args (:string id :string text :string op :string schema :string expected :object extra) :body
  (bind family (id:slice 0 4))
  (bind owner (? (= family "Y-14") "slice07-yaml-document-fidelity"
    (? (or (= family "Y-13") (= family "Y-16")) "slice06-yaml-resource-and-files" "slice05-yaml-value-behavior")))
  (bind spec (Object:assign (obj :id id :hex (hex (encoder:encode text)) :op op
    :options (obj :schema schema) :stringifyOptions (obj :schema schema) :edit "none") extra))
  (bind flags (? (= op "edit-file") #a("--allow-read=./inputs,./outputs" "--allow-write=./outputs") #a()))
  (bind files (? (= op "edit-file") #a((obj :path "inputs/source.yaml" :hex spec:hex)
    (obj :path "outputs/destination.yaml" :hex "4f524947494e414c0a")) #a()))
  (swap! variants append-item (obj :id id :family family :owner owner
    :phase (? (sentinel-ids:has id) "sentinel" "future") :op "probe" :args #a((JSON:stringify spec))
    :case spec :text text :expected expected :repeats (? (= family "Y-13") 6 2)
    :flags flags :files files :gate (? (= family "Y-14") "D-2609-YNOD: source only; requires Slice04 compatible route" null))))
(async (func freeze :args () :body
  (bind base "name: Ada\nn: 1\nflags: [true, false]\nnil: null\n")
  (bind presentation "# title\nn: 01 # note\ntext: 'hello'\n\nseq: [a, b]\n")
  (add "Y-01-edit" base "edit-file" "default" "Only n becomes2; input unchanged; output rereads expected tree" (obj :edit "n=2"))
  (for-of scalar #a("yes" "on" "true" "null" "~" "" "012" "0o12" ".nan" ".inf" "2026-09-12")
    (for-of style #a("plain" "quoted")
      (for-of schema schemas
        (bind spelling (? (= style "quoted") (JSON:stringify scalar) scalar))
        (bind label (? (= scalar "") "empty" (? (= scalar "~") "tilde" scalar)))
        (add (template "Y-02-" label "-" style "-" schema) (template "v: " spelling "\n") "parse" schema
          "Record exact original lexeme beside represented kind/value; schema-dependent outcome unknown; quoted values are strings"
          (obj :scalar scalar :style style)))))
  (bind tags #a("!!str 12" "!!int \"12\"" "!!timestamp 2026-09-12" "!!binary SGk=" "!!set {a: null}"
    "!!omap [a: 1]" "!!pairs [a: 1]" "!!js/regexp /x/i" "!!js/undefined ~" "!custom x"))
  (for-of pair (tags:entries)
    (for-of schema schemas
      (add (template "Y-03-tag" (get pair 0) "-" schema) (template (get pair 1) "\n") "parse" schema
        "Characterize tag support/rejection and represented kind; binary unstable; custom type construction not installed" (obj))))
  (for-of duplicate #a(false true)
    (add (? duplicate "Y-04-duplicate-allow" "Y-04-duplicate-reject") "a: 1\na: 2\n" "parse" "default"
      (? duplicate "Last key wins when explicitly allowed; retain original duplicate bytes" "YamlSyntaxError before output write")
      (obj :options (obj :schema "default" :allowDuplicateKeys duplicate))))
  (bind key-inputs #a("true: bool\n1: number\n\"1\": string\n" "? [a,b]\n: sequence\n" "? {a: b}\n: mapping\n"))
  (for-of pair (key-inputs:entries)
    (for-of duplicate #a(false true)
      (add (template "Y-04-key" (get pair 0) "-allow" duplicate) (get pair 1) "parse" "default"
        "Compare original YAML key kinds with represented own property keys; coercion/collision is loss"
        (obj :options (obj :schema "default" :allowDuplicateKeys duplicate)))))
  (add "Y-05-alias" "a: &base {x: 1}\nb: *base\n" "alias" "default" "Report a===b before edit and b.x after a.x=9" (obj))
  (add "Y-06-cycle" "a: &a [*a]\n" "cycle" "default" "Inspector terminates and reports repeated identity; parser outcome characterized" (obj))
  (add "Y-06-unresolved" "a: *missing\n" "parse" "default" "Unresolved alias rejected with positioned error" (obj))
  (for-of schema schemas
    (add (template "Y-07-merge-" schema) "base: &b {x: 1, y: 2}\nitem: {<<: *b, y: 3}\n" "rewrite" schema
      "Characterize merge resolution, overrides and loss/retention of merge/anchor presentation" (obj)))
  (bind document-inputs #a("---\na: 1\n...\n---\nb: 2\n" "---\na: 1\n---\n---\nb: 2\n" "---\na: 1\n---\nb: [\n"))
  (for-of pair (document-inputs:entries)
    (for-of op #a("parse" "parseAll")
      (bind label (get #a("two" "empty" "invalid") (get pair 0)))
      (add (template "Y-08-" label "-" op) (get pair 1) op "default"
        "Single parse rejects multiple docs; parseAll preserves order/empty docs or returns attributable error; no false all-success" (obj))))
  (bind malformed-inputs #a("a: [1,\n" "a:\n  b: 1\n c: 2\n" "a: &x 1\nb: &x 2\nc: *x\n" "a:\n\tb: 1\n"))
  (for-of pair (malformed-inputs:entries)
    (add (template "Y-09-" (get #a("malformed" "indent" "anchor" "tab") (get pair 0))) (get pair 1) "parse" "default"
      "Record errors/warnings with exact positions; duplicate-anchor outcome unknown; rejected parse must not replace destination" (obj)))
  (for-of edit #a("none" "n=2")
    (add (template "Y-10-" (? (= edit "none") "noop" "edit")) presentation "rewrite" "default"
      "Retain original/noop/edited bytes; presentation loss characterized independently of semantic edit" (obj :edit edit)))
  (bind presentations #a("text: |+\n  one\n\n" "text: >-\n  one\n  two\n" "%YAML 1.2\n---\nn: 1\n"
    "\uFEFFn: 1\n" "n: 1\r\ntext: hello\r\n" "n: 1"))
  (for-of pair (presentations:entries)
    (add (template "Y-11-" (get #a("literal" "folded" "directive" "bom" "crlf" "no-lf") (get pair 0)))
      (get pair 1) "rewrite" "default" "Scalar semantic newlines and document presentation are separate; retain all byte changes" (obj)))
  (for-of token #a("9007199254740991" "9007199254740992" "9007199254740993" "-9007199254740993" "0.1" "1.2300" "1e400" "1e-400" "-0")
    (for-of schema schemas
      (add (template "Y-12-number-" token "-" schema) (template "x: " token "\n") "parse" schema
        "Original numeric token retained; represented Number loss cannot be hidden by roundtrip" (obj))))
  (bind presence-inputs #a("{}\n" "x: null\n" "x: false\n" "x: 0\n" "x: \"\"\n"))
  (for-of pair (presence-inputs:entries)
    (add (template "Y-12-presence-" (get pair 0)) (get pair 1) "parse" "default"
      "Distinguish own presence/null/falsy and preserve false/zero/empty defaults" (obj)))
  (add "Y-12-own-undefined" "{}\n" "runtime-presence" "extended" "Construct own x=undefined, distinguish absence and report serializer effect" (obj))
  (add "Y-12-exact-keys" "first-name: 0\nfirstName: 1\n\"\": 2\n\"a:b\": 3\na/b: 4\n\"~\": 5\n__proto__: 6\nconstructor: 7\ntoString: 8\n"
    "keys" "default" "Exact dynamic keys, own properties and prototype unchanged after value edit" (obj :edit "add10 to every value"))
  (for-of kind #a("depth" "string" "alias-dag")
    (bind sizes (? (= kind "depth") #a(16 64 256) (? (= kind "string") #a(1024 1048576 8388608) #a(4 8 12))))
    (for-of size sizes
      (for-of bound #a("default" "explicit")
        (for-of operation #a("parse" "toJS" "stringify")
          (add (template "Y-13-" kind "-" size "-" bound "-" operation) "" "resource" "default"
            "One warmup+5; supervisor10s/16MiB/512MiB sampled; stop larger family on cap; absent API/bound is unsupported, not silently simulated"
            (obj :recipe (obj :kind kind :size size :fanout 2 :bound bound :operation operation)
              :encodedLimit 9437184 :payloadLimit 8388608))))))
  (for-of pair (-> #a(presentation) (:concat presentations) (:entries))
    (for-of tokens #a(false true)
      (for-of edit #a("none" "n=2")
        (add (template "Y-14-doc" (get pair 0) "-tokens" tokens "-" edit) (get pair 1) "document" "default"
          "GATED: Document.setIn/toString, node comments and keepSourceTokens comparison; preserve semantic intent and every unrelated byte change"
          (obj :keepSourceTokens tokens :edit edit)))))
  (for-of kind #a("Date" "Map" "Set" "undefined" "function" "cycle")
    (for-of skip #a(false true)
      (add (template "Y-15-" kind "-skip" skip) "" "runtime" "default"
        "Characterize accepted/rejected/coerced/dropped; skipInvalid never means fidelity" (obj :runtimeKind kind :stringifyOptions (obj :schema "default" :skipInvalid skip)))))
  (for-of mode #a("missing" "unreadable" "missing-parent" "unwritable" "raw-interrupt" "safe-interrupt" "rename-injected" "rename-directory")
    (add (template "Y-16-" mode) base "file-failure" "default"
      "Preserve source and safe destination on failure; raw truncation separate; modes/path failures versus injected failure explicit"
      (obj :failure mode :edit "n=2")))
  (for-of row (express variants)
    (bind bytes (? (= row:family "Y-13") (recipe-bytes row:case:recipe) (unhex row:case:hex)))
    (Object:define-property row "inputSha256" (obj :value (await (digest bytes)) :enumerable true))
    (Object:define-property row "encodedBytes" (obj :value bytes:length :enumerable true))
    (Object:define-property row "inputKind" (obj :value (? (= row:family "Y-13") "recipe" "literal") :enumerable true)))
  (for-of control #a("inspector-control" "unknown-operation" "unknown-case")
    (swap! variants append-item (obj :id (template "HP-" control) :family "HP" :owner "slice03-yaml-preflight"
      :phase "sentinel" :op (? (= control "unknown-case") "probe" control)
      :args (? (= control "unknown-case") #a("{\"id\":\"NOT-A-CASE\"}") #a()) :repeats 2 :flags #a() :files #a()
      :expectedExit (? (= control "inspector-control") 0 1) :expected "Inspector exact kinds/bounds or explicit rejection of unknown operation/case")))
  (bind manifest (obj :protocol "RP01/FM01" :revision "YP-M01" :schemas schemas
    :sentinelPurpose "Preparation controls only; full families remain owed" :variants (express variants)))
  (Deno:write-text-file-sync "inputs.json" (template (JSON:stringify manifest null 2) "\n"))
  (bind lines (cell #a("# Frozen YAML matrix — YP-M01" "" "Generated by retained audit.lykn freeze before YAML execution. All YAML families remain owed to their listed full-execution owners. Literal UTF-8 bytes/hash, schema/options, repeats and expectation are in inputs.json; no parser-under-test oracle." "" "Y-02: eleven scalars × two quoting styles × five schemas. Empty unquoted uses v: with an empty value; quoted empty is a string. Y-03: ten tags × five schemas. Resource recipes are specified below, never executed here. Y-14 remains gated on D-2609-YNOD and Slice04 policy." "" "Resource bytes: depth=N open brackets + scalar0 + N closing brackets + LF; string=x repeated N as a plain scalar plus LF; alias DAG: base: &a0 [x,x], then aI: &aI [*a(I-1),*a(I-1)] for I=1..N. Explicit bound means inspector depth256/4096 visits and external RP01 budgets, plus package option only if an actual API is established; unsupported toJS/options must be recorded by Slice06." "" "| ID | Phase here | Full owner | Operation / schema | Expected invariant or question |" "| --- | --- | --- | --- | --- |")))
  (for-of row (express variants)
    (swap! lines append-item (template "| " row:id " | " row:phase " | " row:owner " | "
      (? (= row:family "HP") row:op (template row:case:op " / " row:case:options:schema)) " | " row:expected " |")))
  (Deno:write-text-file-sync "case-manifest.md" (template (-> (express lines) (:join "\n")) "\n"))
  (console:log (JSON:stringify (obj :phase "freeze" :variants (get (express variants) "length")
    :sentinels (get (-> (express variants) (:filter (fn (:object row) (= row:phase "sentinel")))) "length"))))))
(bind mode (get Deno:args 0))
(if (= mode "freeze") (await (freeze)))
(if (not (-> #a("freeze" "audit" "graph" "planning") (:includes mode))) (throw (new Error "Unknown audit mode")))

(func records :args (:string path) :body
  (-> (Deno:read-text-file-sync path) (:trim) (:split "\n")
    (:filter (fn (:string line) (> line:length 0))) (:map (fn (:string line) (JSON:parse line)))))
(func facts :args (:object row) :body
  (new Map (-> row:stdout (:trim) (:split "\n")
    (:filter (fn (:string line) (> line:length 0))) (:map (fn (:string line) (JSON:parse line))))))
(func entry :args (:object node :string key) :body
  (bind pair (node:entries:find (fn (:array item) (bind name (get item 0)) (= name:value key))))
  (ensure (not (= pair undefined)) (template "missing represented property " key))
  (get pair 1))
(func equal-files :args (:array a :array b) :body
  (= (JSON:stringify (a:to-sorted (fn (:object x :object y) (x:path:locale-compare y:path))))
    (JSON:stringify (b:to-sorted (fn (:object x :object y) (x:path:locale-compare y:path))))))
(func graph-check :args () :body
  (bind graph (JSON:parse (Deno:read-text-file-sync "dependency-graph.json")))
  (bind npm-keys (Object:keys (?? graph:npmPackages (obj))))
  (ensure (= npm-keys:length 0) "npm graph")
  (for-of module graph:modules
    (ensure (not (or (module:specifier:starts-with "npm:") (module:specifier:starts-with "node:"))) "Node/npm module")
    (ensure (not (Object:has-own module "error")) "graph resolution error"))
  (bind lock (JSON:parse (Deno:read-text-file-sync "deno.lock")))
  (ensure (= (JSON:stringify (Object:keys lock:jsr)) "[\"@std/yaml@1.2.0\"]") "one pinned package")
  (console:log (JSON:stringify (obj :graph "pass" :modules graph:modules:length :packages (Object:keys lock:jsr)))))
(async (func audit :args () :body
  (graph-check)
  (bind manifest (JSON:parse (Deno:read-text-file-sync "inputs.json")))
  (bind ids (new Set))
  (bind families (new Set))
  (for-of spec manifest:variants
    (ensure (not (ids:has spec:id)) "duplicate ID") (ids:add spec:id)
    (if (not (= spec:family "HP"))
      (do (families:add spec:family)
          (bind bytes (? (= spec:inputKind "recipe") (recipe-bytes spec:case:recipe) (unhex spec:case:hex)))
          (ensure (= spec:inputSha256 (await (digest bytes))) (template spec:id " original hash"))
          (ensure (= spec:encodedBytes bytes:length) (template spec:id " original length"))
          (ensure (= (get spec:args 0) (JSON:stringify spec:case)) "exact case argv"))))
  (ensure (= families:size 16) "all16 YAML families")
  (ensure (= (get (manifest:variants:filter (fn (:object v) (= v:family "Y-02"))) "length") 110) "scalar cross product")
  (ensure (= (get (manifest:variants:filter (fn (:object v) (= v:family "Y-03"))) "length") 50) "tag cross product")
  (bind specs (manifest:variants:filter (fn (:object v) (= v:phase "sentinel"))))
  (bind runs (records "sentinel.stdout"))
  (ensure (= runs:length (* specs:length 2)) "all sentinel repeats")
  (bind source-hash (await (digest (Deno:read-file-sync "cases.lykn"))))
  (bind compiled-hash (await (digest (Deno:read-file-sync "cases.js"))))
  (bind lock-hash (await (digest (Deno:read-file-sync "deno.lock"))))
  (bind first (new Map))
  (for-of spec specs
    (bind pair (runs:filter (fn (:object row) (= row:id spec:id))))
    (ensure (= pair:length 2) (template spec:id " count"))
    (ensure (= (JSON:stringify (pair:map (fn (:object row) row:attempt))) "[1,2]") "attempt identities")
    (first:set spec:id (get pair 0))
    (if (= (?? spec:expectedExit 0) 0)
      (ensure (= (get (get pair 0) "stdout") (get (get pair 1) "stdout")) (template spec:id " deterministic stdout"))))
  (for-of row runs
    (bind spec (specs:find (fn (:object spec) (= spec:id row:id))))
    (ensure (= row:exit (?? spec:expectedExit 0)) (template row:id " exit"))
    (ensure (= row:stopReason null) "no sentinel cap")
    (ensure (= row:survivors:length 0) "no survivors")
    (ensure (= row:sourceSha256 source-hash) "source pin")
    (ensure (= row:compiledSha256 compiled-hash) "compiled pin")
    (ensure (= (await (digest (Deno:read-file-sync (template row:cwd "/deno.lock")))) lock-hash) "frozen attempt lock")
    (ensure (= row:stdoutSha256 (await (digest (unhex row:stdoutHex)))) "stdout hash")
    (ensure (= row:stderrSha256 (await (digest (unhex row:stderrHex)))) "stderr hash")
    (ensure (equal-files row:inputState row:inputAfter) "source immutable")
    (if (not (= row:id "Y-01-edit"))
      (ensure (equal-files row:outputBefore row:outputAfter) "non-file probe leaves outputs unchanged"))
    (for-of file row:outputAfter
      (ensure (= file:sha256 (await (digest (unhex file:hex)))) "output file hash")))
  (func fact :args (:string id :string label) :body (bind data (facts (first:get id))) (data:get label))
  (for-of id #a("Y-04-duplicate-reject" "Y-06-unresolved" "Y-08-two-parse" "Y-09-malformed")
    (bind error (fact id "error"))
    (ensure (= error:name "YamlSyntaxError") (template id " expected syntax error"))
    (ensure (= error:stage "parse") "error stage")
    (ensure (= (get (entry error:details "line") "kind") "number") "structured error line"))
  (for-of schema #a("default" "core" "failsafe")
    (for-of style #a("plain" "quoted")
      (bind node (entry (fact (template "Y-02-true-" style "-" schema) "parsed") "v"))
      (ensure (= node:kind (? (or (= style "quoted") (= schema "failsafe")) "string" "boolean")) "schema scalar kind")
      (ensure (= node:value "true") "true scalar represented value")))
  (ensure (= (fact "Y-05-alias" "aliasBefore") true) "alias identity")
  (bind alias-after (fact "Y-05-alias" "aliasAfter"))
  (ensure (and alias-after:same (= alias-after:bX 9)) "alias edit shared")
  (ensure (= (fact "Y-06-cycle" "selfCycle") true) "cycle identity")
  (bind cycle-array (entry (fact "Y-06-cycle" "parsed") "a"))
  (ensure (= (get (entry cycle-array "0") "id") cycle-array:id) "cycle reference same traversal ID")
  (ensure (= (get (fact "Y-08-two-parseAll" "parsed") "length") 2) "two documents")
  (bind edited (fact "Y-01-edit" "reread"))
  (ensure (= (get (entry edited "n") "value") "2") "reread n=2")
  (ensure (= (get (entry edited "name") "value") "Ada") "reread name")
  (ensure (= (get (entry edited "nil") "kind") "null") "reread null")
  (bind flags (entry edited "flags"))
  (ensure (= (get (entry flags "0") "value") "true") "reread first flag")
  (ensure (= (get (entry flags "1") "value") "false") "reread second flag")
  (bind byte-report (cell #a("# Sentinel byte audit" "" "Generated by audit.lykn; zero-based positional differing ranges [start,end), including unmatched EOF bytes. Alignment is positional, not a minimum edit script. Original/noop/edit are separate byte records.")))
  (for-of id #a("Y-01-edit" "Y-10-noop" "Y-10-edit")
    (bind spec (specs:find (fn (:object row) (= row:id id))))
    (bind input (unhex spec:case:hex))
    (for-of label #a("noop" "output")
      (bind output (unhex (get (fact id label) "hex")))
      (bind ranges (cell #a())) (bind start (cell null))
      (for-of i (Array:from (obj :length (Math:max input:length output:length)) (fn (:any ignored :number i) i))
        (bind different (not (= (get input i) (get output i))))
        (if (and different (= (express start) null)) (reset! start i))
        (if (and (not different) (not (= (express start) null)))
          (do (swap! ranges append-item #a((express start) i)) (reset! start null))))
      (if (not (= (express start) null)) (swap! ranges append-item #a((express start) (Math:max input:length output:length))))
      (swap! byte-report append-item (template "\n## " id " " label "\n\nOriginal " input:length " bytes SHA256 " (await (digest input)) " hex " (hex input)
        "\n\nObserved " output:length " bytes SHA256 " (await (digest output)) " hex " (hex output)
        "\n\nDiffering ranges " (JSON:stringify (express ranges)) "\n"))))
  (bind controls (records "controls.stdout"))
  (ensure (= controls:length 3) "three supervisor controls")
  (for-of row controls
    (ensure (= row:stopReason (? (= row:id "control-timeout") "wall" (? (= row:id "control-output") "output" "rss"))) "control reason")
    (ensure (= row:exit 137) "control exit")
    (ensure (= row:survivors:length 0) "control cleanup")
    (ensure (> row:maxSampledTreeRssKiB 0) "control observation")
    (if (= row:id "control-output") (ensure (<= row:outputBytesRetained 4096) "combined output bound")))
  (bind inspected (fact "HP-inspector-control" "inspector"))
  (ensure (= (get (entry inspected "0") "kind") "undefined") "undefined tagged")
  (ensure (= (get (entry inspected "1") "kind") "null") "null tagged")
  (ensure (= (get (entry inspected "3") "value") "-0") "negative zero tagged")
  (ensure (= (get (entry inspected "4") "value") "NaN") "NaN tagged")
  (ensure (= (get (entry inspected "5") "value") "Infinity") "Infinity tagged")
  (ensure (= (get (entry inspected "6") "kind") "date") "timestamp tagged")
  (ensure (= (get (entry inspected "7") "hex") "00ff") "binary exact")
  (ensure (= (get (entry inspected "8") "kind") "map") "map keys represented separately")
  (ensure (= (get (entry inspected "9") "kind") "set") "set inspected")
  (ensure (= (get (fact "HP-inspector-control" "bounds") "truncated") true) "string bound")
  (ensure (-> (JSON:stringify (fact "HP-inspector-control" "depthBound")) (:includes "depth-bound")) "depth bound")
  (bind map-node (entry inspected "8"))
  (ensure (= (get (get (get map-node:entries 0) 0) "kind") "boolean") "map boolean key")
  (ensure (= (get (get (get map-node:entries 1) 0) "kind") "number") "map numeric key")
  (ensure (= (get (entry inspected "6") "iso") "2026-09-12T00:00:00.000Z") "timestamp value")
  (ensure (= (get (entry inspected "12") "kind") "function") "unsupported function tagged")
  (ensure (= (get (entry inspected "13") "length") 2) "sparse length")
  (ensure (= (get (get (entry inspected "13") "entries") "length") 0) "sparse absent own slots")
  (ensure (-> (first:get "HP-unknown-case") (get "stderr") (:includes "Unknown case ID: NOT-A-CASE")) "unknown ID explicit")
  (ensure (-> (first:get "HP-unknown-operation") (get "stderr") (:includes "Unknown operation:")) "unknown operation explicit")
  (Deno:write-text-file-sync "byte-audit.md" (template (-> (express byte-report) (:join "\n")) "\n"))
  (bind report (cell #a("# Sentinel observations" "" "Generated by retained Lykn audit; first of two deterministic attempts shown. These are preparation probes, not completed YAML families.")))
  (for-of spec specs
    (bind row (first:get spec:id))
    (swap! report append-item (template "\n## " spec:id "\n\nExit " row:exit "; stop reason " row:stopReason "; two attempts.\n"))
    (if (not (= spec:family "HP"))
      (swap! report append-item (template "\n```json\n" row:stdout "```\n"))))
  (swap! report append-item "\n## Frozen family ownership and counts\n\n| Family | Variants | Owner |\n| --- | --- | --- |")
  (for-of family (-> (Array:from families) (:sort))
    (bind owned (manifest:variants:filter (fn (:object row) (= row:family family))))
    (swap! report append-item (template "| " family " | " owned:length " | " (get (get owned 0) "owner") " |")))
  (Deno:write-text-file-sync "sentinel-summary.md" (template (-> (express report) (:join "\n")) "\n"))
  (console:log (JSON:stringify (obj :result "pass" :checks (express checks) :sentinelAttempts runs:length :frozenVariants manifest:variants:length :yamlFamilies families:size)))))
(if (= mode "graph") (graph-check))
(if (= mode "audit") (await (audit)))

(func planning-check :args (:string root) :body
  (bind scope (-> (Deno:read-text-file-sync (template root "/project07-core-library-research/arc01-format-runtime-evidence/slice03-yaml-preflight/cc-prompt.md"))
    (:split "\n") (:filter (fn (:string line) (or (line:starts-with "project07-core-library-research/") (line:starts-with "backlog/"))))))
  (bind allowed (new Set scope))
  (bind paths (-> (Deno:read-text-file-sync "changed-paths.txt") (:trim) (:split "\n")))
  (bind links (cell 0))
  (for-of path paths
    (ensure (allowed:has path) (template "outside explicit scope: " path))
    (if (path:ends-with ".md")
      (do (bind text (Deno:read-text-file-sync (template root "/" path)))
          (bind prose (text:replace (regex "```[\\s\\S]*?```" "g") ""))
          (bind base (new URL (template "file://" root "/" path)))
          (for-of match (prose:match-all (regex "\\]\\(([^\\s)]+)\\)" "g"))
            (bind target (get match 1))
            (if (not (or (target:starts-with "https:") (target:starts-with "http:") (target:starts-with "#")))
              (do (bind url (new URL target base)) (Deno:stat-sync url)
                  (swap! links (fn (:number n) (+ n 1)))))))))
  (console:log (JSON:stringify (obj :planning "pass" :paths paths:length :links (express links)))))
(if (= mode "planning") (planning-check (get Deno:args 1)))
