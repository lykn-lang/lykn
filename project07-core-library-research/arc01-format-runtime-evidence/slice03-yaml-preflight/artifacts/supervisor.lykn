;; External RP01 supervisor: the parser runs in a separate CLI/Deno process tree.
;; Host tools are limited to /usr/bin/time, /bin/ps and /bin/kill.
(bind CLI (-> (Deno:read-text-file-sync "compiler-path.txt") (:trim)))
(bind decoder (new TextDecoder))
(bind seed (Deno:cwd))
(func append-item :args (:array values :any value) :body (conj values value))
(func emit :args (:any record) :body (console:log (JSON:stringify record)))
(func hex :args (:any bytes) :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func delay :args (:number ms) :body
  (new Promise (fn (:function resolve) (set-timeout resolve ms))))
(func environment :args (:string root) :body
  (obj :PATH "/opt/homebrew/bin:/usr/bin:/bin" :HOME (template root "/home")
    :TMPDIR (template root "/tmp") :DENO_DIR (template root "/cache")
    :DENO_NO_UPDATE_CHECK "1" :NO_COLOR "1"))
(func command :args (:string executable :array args :string root) :body
  (new Deno:Command executable (obj :args args :cwd root :clear-env true
    :env (environment root) :stdin "null" :stdout "piped" :stderr "piped")))
(func copy-tree :args (:string from :string to) :body
  (Deno:mkdir-sync to (obj :recursive true))
  (for-of entry (Deno:read-dir-sync from)
    (bind src (template from "/" entry:name))
    (bind dest (template to "/" entry:name))
    (if entry:is-directory (copy-tree src dest) (Deno:copy-file-sync src dest)))
  null)
(async (func snapshot :args (:string root :string relative) :body
  (bind records (cell #a()))
  (for-of entry (Deno:read-dir-sync (template root "/" relative))
    (bind path (template relative "/" entry:name))
    (bind full (template root "/" path))
    (bind info (Deno:lstat-sync full))
    (if info:is-symlink (throw (new Error "symlink escaped fixture contract")))
    (if info:is-directory
      (do (swap! records append-item (obj :path path :directory true :mode info:mode))
          (bind children (await (snapshot root path)))
          (swap! records (fn (:array old) (old:concat children))))
      (try
        (bind bytes (Deno:read-file-sync full))
        (swap! records append-item (obj :path path :mode info:mode :size bytes:length
          :hex (hex bytes) :sha256 (await (digest bytes))))
        (catch err (swap! records append-item (obj :path path :mode info:mode :error err:message))))))
  (express records)))
(func processes :args () :body
  (bind out (-> (command "/bin/ps" #a("-axo" "pid=,ppid=,rss=,stat=") seed) (:output-sync)))
  (if (not out:success) (throw (new Error "ps observation unavailable")))
  (-> (decoder:decode out:stdout) (:trim) (:split "\n")
    (:map (fn (:string line)
      (bind parts (-> line (:trim) (:split (regex "\\s+"))))
      (obj :pid (Number (get parts 0)) :ppid (Number (get parts 1))
        :rss (Number (get parts 2)) :state (get parts 3))))))
(func descendants :args (:array table :number parent) :body
  (bind ids (new Set #a(parent)))
  (bind changed (cell true))
  (while (express changed)
    (reset! changed false)
    (for-of row table
      (? (and (ids:has row:ppid) (not (ids:has row:pid)))
        (do (ids:add row:pid) (reset! changed true)) undefined)))
  (table:filter (fn (:object row) (ids:has row:pid))))

(async (func run-one :args (:object spec :number attempt) :body
  (bind root (template seed "/runs/" spec:id "-" attempt))
  (Deno:mkdir-sync root (obj :recursive true))
  (for-of dir #a("inputs" "outputs" "home" "tmp")
    (Deno:mkdir-sync (template root "/" dir) (obj :recursive true)))
  (Deno:copy-file-sync (template seed "/cases.lykn") (template root "/cases.lykn"))
  (if (= spec:phase "native")
    (Deno:write-text-file-sync (template root "/project.json") "{}\n")
    (do
      (Deno:copy-file-sync (template seed "/project.json") (template root "/project.json"))
      (if (not (= spec:phase "control"))
        (do (Deno:copy-file-sync (template seed "/deno.lock") (template root "/deno.lock"))
            (copy-tree (template seed "/cache") (template root "/cache"))))))
  (bind prep-args #a("run" "--no-prompt" "--allow-write=./inputs,./outputs" "cases.lykn" "materialize" (JSON:stringify spec:files)))
  (bind prep (await (-> (command CLI prep-args root) (:output))))
  (if (not prep:success) (throw (new Error (template "Fixture preparation failed: " (decoder:decode prep:stderr)))))
  (bind before (await (snapshot root "inputs")))
  (bind before-out (await (snapshot root "outputs")))
  (bind args (-> #a("run" "--no-prompt") (:concat spec:flags)
    (:concat (? (or (= spec:phase "sentinel") (= spec:phase "stress")) #a("--cached-only" "--frozen=true") #a()))
    (:concat #a("cases.lykn" spec:op)) (:concat spec:args)))
  (bind wall (?? spec:wallMs 10000))
  (bind cap (?? spec:outputBytes 16777216))
  (bind rss-cap (?? spec:rssKiB 524288))
  (bind started (new Date))
  (bind start (performance:now))
  (bind child (-> (command "/usr/bin/time" (-> #a("-l" CLI) (:concat args)) root) (:spawn)))
  (bind done (cell false))
  (bind reason (cell null))
  (bind total (cell 0))
  (bind stored (cell 0))
  (bind peak (cell 0))
  (bind samples (cell #a()))
  (bind known (new Set #a(child:pid)))
  (bind kills (cell #a()))
  (async (func stop :args (:string why) :body
    (if (not (= (express reason) null)) (return))
    (reset! reason why)
    (bind table (processes))
    (bind owned (descendants table child:pid))
    (for-of row owned (known:add row:pid))
    (bind targets (-> (Array:from known) (:reverse) (:map (fn (:number pid) (String pid)))))
    (bind out (await (-> (command "/bin/kill" (-> #a("-KILL") (:concat targets)) root) (:output))))
    (swap! kills append-item (obj :targets targets :exit out:code :stderr (decoder:decode out:stderr)))))
  (async (func collect :args (:any stream) :body
    (bind chunks (cell #a()))
    (bind reader (stream:get-reader))
    (bind item (cell (await (reader:read))))
    (while (not (get (express item) "done"))
      (bind bytes (get (express item) "value"))
      (swap! total + bytes:length)
      (bind keep (bytes:slice 0 (Math:max 0 (- cap (express stored)))))
      (swap! stored + keep:length)
      (swap! chunks append-item keep)
      (? (> (express total) cap) (await (stop "output")) undefined)
      (reset! item (await (reader:read))))
    (reader:release-lock)
    (bind result (new Uint8Array (-> (express chunks) (:reduce (fn (:number n :any b) (+ n b:length)) 0))))
    (bind offset (cell 0))
    (for-of chunk (express chunks) (result:set chunk (express offset)) (swap! offset + chunk:length))
    result))
  (async (func watch :args () :body
    (while (not (express done))
      (bind rows (descendants (processes) child:pid))
      (for-of row rows (known:add row:pid))
      (bind rss (rows:reduce (fn (:number n :object row) (+ n row:rss)) 0))
      (swap! peak Math:max rss)
      (swap! samples append-item (obj :ms (- (performance:now) start) :rssKiB rss :processes rows))
      (? (> rss rss-cap) (await (stop "rss")) undefined)
      (? (> (- (performance:now) start) wall) (await (stop "wall")) undefined)
      (await (delay 25)))
    null))
  (bind observed-status (-> child:status (:then (fn (:any status) (reset! done true) status))))
  (bind results (await (Promise:all #a((collect child:stdout) (collect child:stderr) observed-status (watch)))))
  (bind stdout (get results 0))
  (bind stderr (get results 1))
  (bind status (get results 2))
  (bind ended (new Date))
  (bind survivors (-> (processes) (:filter (fn (:object row)
    (and (known:has row:pid) (not (row:state:starts-with "Z")))))))
  (bind record (obj :id spec:id :attempt attempt :phase spec:phase :expected spec:expected
    :cwd root :utcStart (started:toISOString) :utcEnd (ended:toISOString)
    :command (-> #a("/usr/bin/time" "-l" CLI) (:concat args)) :environment (environment root)
    :wallMs (- (performance:now) start) :exit status:code :signal status:signal
    :stopReason (express reason) :outputBytesObserved (express total) :outputBytesRetained (express stored)
    :maxSampledTreeRssKiB (express peak) :samples (express samples) :kills (express kills) :survivors survivors
    :stdout (decoder:decode stdout) :stderr (decoder:decode stderr)
    :stdoutHex (hex stdout) :stderrHex (hex stderr)
    :stdoutSha256 (await (digest stdout)) :stderrSha256 (await (digest stderr))
    :inputState before :outputBefore before-out :inputAfter (await (snapshot root "inputs"))
    :outputAfter (await (snapshot root "outputs"))
    :sourceSha256 (await (digest (Deno:read-file-sync (template root "/cases.lykn"))))
    :compiledSha256 (await (digest (Deno:read-file-sync (template root "/target/lykn/run/cases.js"))))
    :configText (Deno:read-text-file-sync (template root "/project.json"))
    :preparation (obj :command (-> #a(CLI) (:concat prep-args)) :exit prep:code
      :stdout (decoder:decode prep:stdout) :stderr (decoder:decode prep:stderr))))
  (emit record)
  record))

;; Check host observation before any potentially nonterminating child.
(processes)
(bind group (get Deno:args 0))
(if (not (-> #a("controls" "sentinel") (:includes group)))
  (throw (new Error (template "Unknown supervisor group: " group))))
(bind manifest (JSON:parse (Deno:read-text-file-sync "inputs.json")))
(if (= group "controls")
  (do
    (for-of kind #a("timeout" "output" "rss")
      (bind spec (obj :id (template "control-" kind) :phase "control" :op (template "control-" kind)
        :args #a() :files #a() :flags #a() :expected (template "supervisor stops for " kind)
        :wallMs 500 :outputBytes (? (= kind "output") 4096 16777216)
        :rssKiB (? (= kind "rss") 1 524288)))
      (bind result (await (run-one spec 1)))
      (if (or (not (= result:stopReason (? (= kind "timeout") "wall" kind))) (> result:survivors:length 0) (= result:maxSampledTreeRssKiB 0))
        (throw (new Error "Supervisor control did not establish bounded termination"))))
    (Deno:write-text-file-sync "supervisor-verified.txt" "wall/output/RSS controls passed\n")))
(if (not (= group "controls"))
  (do
    (Deno:read-text-file-sync "supervisor-verified.txt")
    (bind blocked (new Set))
    (for-of spec manifest:variants
      (if (= spec:phase group)
        (do
          (if (blocked:has spec:family)
            (emit (obj :id spec:id :phase group :notRun "earlier family cap or harness failure"))
            (do
              (bind attempt (cell 1))
              (while (<= (express attempt) spec:repeats)
                (bind result (await (run-one spec (express attempt))))
                (? (and (not (= result:stopReason null)) (not (= result:stopReason spec:expectedStop)))
                  (blocked:add spec:family) undefined)
                (? (and (not (= result:exit (?? spec:expectedExit 0))) (= result:stopReason null))
                  (blocked:add spec:family) undefined)
                (swap! attempt (fn (:number n) (+ n 1)))
                (? (blocked:has spec:family) (reset! attempt (+ spec:repeats 1)) undefined)))))))))
