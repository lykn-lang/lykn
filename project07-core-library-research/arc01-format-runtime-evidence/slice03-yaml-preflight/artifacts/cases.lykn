;; YAML preparation sentinels only. Full-family execution is owned by later slices.
(bind encoder (new TextEncoder))
(func emit :args (:string label :any value) :body
  (bind text (JSON:stringify #a(label value)))
  (bind bytes (encoder:encode text))
  (if (> bytes:length 1048576) (throw (new Error "inspector output exceeds 1MiB")))
  (console:log text))
(func ensure :args (:boolean ok :string message) :body
  (if (not ok) (throw (new Error message))))
(func hex :args (:any bytes) :body
  (-> (Array:from bytes (fn (:number b) (-> (b:to-string 16) (:pad-start 2 "0")))) (:join "")))
(func unhex :args (:string text) :body
  (Uint8Array:from (?? (text:match (regex ".." "g")) #a()) (fn (:string p) (Number:parse-int p 16))))
(async (func digest :args (:any bytes) :body
  (hex (new Uint8Array (await (crypto:subtle:digest "SHA-256" bytes))))))
(func append-item :args (:array values :any item) :body (conj values item))
(func inspect :args (:any value :object seen :number depth) :body
  (seen:set "visits" (+ (seen:get "visits") 1))
  (if (> (seen:get "visits") 4096) (return (obj :kind "visit-bound")))
  (if (> depth 256) (return (obj :kind "depth-bound")))
  (if (= value null) (return (obj :kind "null")))
  (bind kind (typeof value))
  (if (= kind "number")
    (return (obj :kind kind :value (? (Object:is value (Number "-0")) "-0" (String value)) :finite (Number:is-finite value))))
  (if (= kind "string")
    (return (obj :kind kind :value (value:slice 0 4096) :length value:length :truncated (> value:length 4096))))
  (if (not (= kind "object")) (return (obj :kind kind :value (String value))))
  (if (seen:has value) (return (obj :kind "reference" :id (seen:get value))))
  (if (>= seen:size 2048) (return (obj :kind "node-bound")))
  (bind id seen:size)
  (seen:set value id)
  (bind tag (Object:prototype:to-string:call value))
  (if (= tag "[object Date]")
    (return (obj :kind "date" :id id :milliseconds (String (value:get-time))
      :iso (? (Number:is-NaN (value:get-time)) null (value:toISOString)))))
  (if (= tag "[object RegExp]") (return (obj :kind "regexp" :id id :source value:source :flags value:flags)))
  (if (ArrayBuffer:is-view value)
    (return (obj :kind tag :id id :byteLength value:byteLength
      :hex (hex (new Uint8Array value:buffer value:byteOffset (Math:min value:byteLength 4096)))
      :truncated (> value:byteLength 4096))))
  (if (= tag "[object Map]")
    (return (obj :kind "map" :id id :entries
      (-> (Array:from value) (:slice 0 2048) (:map (fn (:array pair)
        #a((inspect (get pair 0) seen (+ depth 1)) (inspect (get pair 1) seen (+ depth 1))))))
      :size value:size :truncated (> value:size 2048))))
  (if (= tag "[object Set]")
    (return (obj :kind "set" :id id :values
      (-> (Array:from value) (:slice 0 2048) (:map (fn (:any v) (inspect v seen (+ depth 1)))))
      :size value:size :truncated (> value:size 2048))))
  (bind keys (Object:keys value))
  (obj :kind (? (Array:is-array value) "array" "object") :tag tag :id id
    :length (? (Array:is-array value) value:length null) :truncated (> keys:length 2048)
    :entries (-> keys (:slice 0 2048) (:map (fn (:string key)
      #a((obj :kind "string" :value key) (inspect (get value key) seen (+ depth 1))))))))
(func tree :args (:any value) :body (inspect value (new Map #a(#a("visits" 0))) 0))
(func error-fact :args (:string stage :any err) :body
  (emit "error" (obj :stage stage :name err:name :message err:message
    :details (tree err))))
(func materialize :args (:string data) :body
  (for-of item (JSON:parse data)
    (Deno:write-file-sync item:path (unhex item:hex))))
(bind allowed (new Set #a("Y-01-edit" "Y-02-true-plain-default" "Y-02-true-plain-core"
  "Y-02-true-plain-failsafe" "Y-02-true-quoted-default" "Y-02-true-quoted-core"
  "Y-02-true-quoted-failsafe" "Y-04-duplicate-reject" "Y-05-alias" "Y-06-cycle"
  "Y-06-unresolved" "Y-08-two-parse" "Y-08-two-parseAll" "Y-09-malformed"
  "Y-10-noop" "Y-10-edit")))
(async (func probe :args (:object spec) :body
  (ensure (allowed:has spec:id) (template "Unknown case ID: " spec:id))
  (bind bytes (unhex spec:hex))
  (ensure (<= bytes:length 9437184) "encoded input limit")
  (emit "input" (obj :hex spec:hex :sha256 (await (digest bytes)) :bytes bytes:length))
  (bind yaml (await (dynamic-import "@std/yaml")))
  (emit "exports" (-> (Object:keys yaml) (:sort)))
  (bind options (assoc spec:options :onWarning (fn (:any err) (emit "warning" (tree err)))))
  (bind stage (cell "parse"))
  (try
    (bind text (new TextDecoder))
    (bind input (text:decode bytes))
    (bind value (? (= spec:op "parseAll") (yaml:parse-all input options) (yaml:parse input options)))
    (emit "parsed" (tree value))
    (if (= spec:op "alias")
      (do (emit "aliasBefore" (= value:a value:b))
          (Object:define-property value:a "x" (obj :value 9 :writable true :enumerable true :configurable true))
          (emit "aliasAfter" (obj :same (= value:a value:b) :bX value:b:x))))
    (if (= spec:op "cycle") (emit "selfCycle" (= value:a (get value:a 0))))
    (if (or (= spec:op "rewrite") (= spec:op "edit-file"))
      (do (reset! stage "stringify")
          (bind noop (yaml:stringify value spec:stringifyOptions))
          (bind edited (? (= spec:edit "n=2") (assoc value :n 2) value))
          (bind output (yaml:stringify edited spec:stringifyOptions))
          (emit "noop" (obj :text noop :hex (hex (encoder:encode noop))))
          (emit "output" (obj :text output :hex (hex (encoder:encode output))))
          (emit "reparsed" (tree (yaml:parse output options)))
          (if (= spec:op "edit-file")
            (do (reset! stage "read-fixture")
                (ensure (= (hex (Deno:read-file-sync "inputs/source.yaml")) spec:hex) "file matches literal fixture")
                (reset! stage "write")
                (bind file (Deno:open-sync "outputs/replacement.tmp" (obj :create-new true :write true)))
                (try (bind outbytes (encoder:encode output)) (bind offset (cell 0))
                  (while (< (express offset) outbytes:length)
                    (swap! offset + (file:write-sync (outbytes:subarray (express offset)))))
                  (file:sync-sync) (finally (file:close)))
                (Deno:rename-sync "outputs/replacement.tmp" "outputs/destination.yaml")
                (emit "reread" (tree (yaml:parse (Deno:read-text-file-sync "outputs/destination.yaml") options)))))))
    (emit "status" "complete")
    (catch err (error-fact (express stage) err) (emit "status" "error")))))
(async (func dispatch :args () :body
  (bind op (get Deno:args 0))
  (bind arg (get Deno:args 1))
  (if (= op "materialize") (do (materialize arg) (return)))
  (if (= op "control-read") (do (console:log (Deno:read-text-file-sync "inputs/control.txt")) (return)))
  (if (= op "control-timeout") (do (emit "checkpoint" "busy-loop") (while true)))
  (if (= op "control-output") (while true (console:log "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")))
  (if (= op "control-rss") (do (await (new Promise (fn (:function resolve) (set-timeout resolve 3000)))) (return)))
  (if (= op "probe") (do (await (probe (JSON:parse arg))) (return)))
  (if (= op "inspector-control")
    (do (bind cycle (obj)) (Object:define-property cycle "self" (obj :value cycle :enumerable true))
        (emit "inspector" (tree #a(undefined null false (Number "-0") NaN Infinity
          (new Date "2026-09-12T00:00:00Z") (Uint8Array:of 0 255)
          (new Map #a(#a(true "boolean-key") #a(1 "number-key")))
          (new Set #a(1 2)) cycle (Symbol "s") (fn () 1) (new Array 2))))
        (emit "bounds" (tree (String:prototype:repeat:call "x" 4097)))
        (bind nested (cell 0))
        (for-of i (Array:from (obj :length 258) (fn (:any ignored :number i) i))
          (reset! nested #a((express nested))))
        (emit "depthBound" (tree (express nested)))
        (return)))
  (throw (new Error (template "Unknown operation: " op)))))
(await (dispatch))
