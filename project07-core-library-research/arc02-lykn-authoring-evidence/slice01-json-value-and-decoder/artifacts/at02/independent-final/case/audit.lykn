;; Review-only structured-output oracle, independent of decoder implementation.
(bind root "/private/tmp/lykn-at02-cdc-final.XeqVk0cQ")
(func ensure :args (:boolean pass :string message) :returns :void :body
  (if (not pass) (throw (new Error message))))
(func read-text :args (:string path) :returns :string :body
  (Deno:read-text-file-sync (template root "/" path)))
(func equal-value :args (:any actual :any expected :string label) :returns :void :body
  (ensure (= (JSON:stringify actual) (JSON:stringify expected)) (template "wrong value: " label)))
(func observations :args (:string cell :number count) :returns :any :body
  (bind text (read-text (template "logs/" cell "/stdout.raw")))
  (bind trimmed (text:trim-end))
  (bind lines (trimmed:split "\n"))
  (ensure (= lines:length count) (template "line count " cell))
  (bind values (new Map))
  (for-of line lines
    (bind split (line:index-of " "))
    (ensure (> split 0) "missing observation label")
    (bind label (line:slice 0 split))
    (ensure (not (values:has label)) (template "duplicate observation " label))
    (values:set label (JSON:parse (line:slice (+ split 1)))))
  values)
(func j-number :args (:number value) :returns :object :body (obj :tag "JNumber" :value value))
(func decoded :args (:any value) :returns :object :body (obj :tag "Decoded" :value value))
(func rejected :args (:any failure) :returns :object :body (obj :tag "Rejected" :failure failure))
(func some :args (:any value) :returns :object :body (obj :tag "Some" :value value))
(func wrong :args (:string path :string expected) :returns :object :body
  (rejected (obj :tag "WrongValue" :path path :expected expected)))
(func config :args (:number port :any label) :returns :object :body
  (decoded (obj :tag "ServerConfig" :port port :label label)))
(func check-decoder :args (:string cell) :returns :void :body
  (bind got (observations cell 40))
  (bind expected
    (array
      (array "J02-null" (decoded (obj :tag "JNull")))
      (array "J02-bool" (decoded (obj :tag "JBoolean" :value false)))
      (array "J02-number" (decoded (j-number 0)))
      (array "J02-string" (decoded (obj :tag "JString" :value "")))
      (array "J02-array" (decoded (obj :tag "JArray" :values (array))))
      (array "J02-object" (decoded (obj :tag "JObject" :entries (array))))
      (array "J01-nested" (decoded (JSON:parse "{\"tag\":\"JObject\",\"entries\":[{\"tag\":\"Entry\",\"key\":\"name\",\"value\":{\"tag\":\"JString\",\"value\":\"Ada\"}},{\"tag\":\"Entry\",\"key\":\"n\",\"value\":{\"tag\":\"JNumber\",\"value\":1}},{\"tag\":\"Entry\",\"key\":\"flags\",\"value\":{\"tag\":\"JArray\",\"values\":[{\"tag\":\"JBoolean\",\"value\":true},{\"tag\":\"JBoolean\",\"value\":false}]}},{\"tag\":\"Entry\",\"key\":\"nil\",\"value\":{\"tag\":\"JNull\"}}]}")))
      (array "L01-injected-undefined" (wrong "$[1]" "JSON value"))
      (array "J07-raw-own-undefined-label" (wrong "$[\"label\"]" "JSON value"))
      (array "port-0" (config 0 (obj :tag "LabelMissing")))
      (array "port-max" (config 65535 (obj :tag "LabelMissing")))
      (array "port-negative" (rejected (obj :tag "InvalidPort" :path "server.port" :value -1)))
      (array "port-too-large" (rejected (obj :tag "InvalidPort" :path "server.port" :value 65536)))
      (array "port-fraction" (rejected (obj :tag "InvalidPort" :path "server.port" :value 1.5)))
      (array "port-string" (wrong "server.port" "integer 0..65535"))
      (array "port-missing" (rejected (obj :tag "MissingField" :path "server.port")))
      (array "port-null" (wrong "server.port" "integer 0..65535"))
      (array "label-missing" (config 8080 (obj :tag "LabelMissing")))
      (array "label-null" (config 8080 (obj :tag "LabelNull")))
      (array "label-empty" (config 0 (obj :tag "LabelText" :value "")))
      (array "label-text" (config 8080 (obj :tag "LabelText" :value "edge")))
      (array "label-false" (wrong "label" "string or null"))
      (array "label-zero" (wrong "label" "string or null"))
      (array "label-own-undefined-present" (some (obj :tag "JUndefined")))
      (array "label-own-undefined-result" (wrong "label" "string or null"))))
  (for-of pair expected
    (equal-value (got:get (get pair 0)) (get pair 1) (get pair 0)))
  (bind keys (array "first-name" "firstName" "" "a:b" "a/b" "~" "__proto__" "constructor" "toString"))
  (bind entries (keys:map (fn (:string key :number index) (obj :tag "Entry" :key key :value (j-number index)))))
  (bind key-object (obj :tag "JObject" :entries entries))
  (equal-value (got:get "J08-exact-key-data") (decoded key-object) "all exact key data")
  (bind names (array "K02-first-name" "K03-firstName" "K04-empty" "K05-colon" "K06-slash" "K07-tilde" "K08-proto" "K09-constructor" "K10-toString"))
  (for-of pair (names:entries)
    (equal-value (got:get (get pair 1)) (some (j-number (get pair 0))) (get pair 1)))
  (bind original (obj :tag "JObject" :entries (conj entries (obj :tag "Entry" :key "nested" :value key-object))))
  (bind updated-inner
    (obj :tag "JObject" :entries
      (keys:map (fn (:string key :number index)
        (obj :tag "Entry" :key key :value (j-number (? (= key "__proto__") 55 index)))))))
  (bind updated (obj :tag "JObject" :entries (conj entries (obj :tag "Entry" :key "nested" :value updated-inner))))
  (equal-value (got:get "edit-original-alias") original "original nested alias byte-value")
  (equal-value (got:get "edit-updated") updated "only nested exact proto key changes")
  (equal-value (got:get "edit-alias-identity") false "distinct root identity")
  (equal-value (got:get "edit-path-nested-proto") (some (j-number 55)) "updated path")
  (equal-value (got:get "edit-untouched-constructor") (some (j-number 7)) "untouched sibling")
  (console:log cell "40/40 exact observations"))

(for-of cell (array "decoder-run-default" "decoder-run-stripped" "decoder-public-run" "decoder-formatted-run-default" "decoder-formatted-run-stripped" "decoder-formatted-public-run")
  (check-decoder cell)
  (ensure (= (read-text (template "logs/" cell "/stderr.raw")) "") (template cell " stderr")))

(for-of name (array "decoder" "controls" "zero-field-control")
  (ensure (= (read-text (template "case/" name "-formatted.lykn"))
    (read-text (template "case/" name "-formatted-again.lykn"))) (template name " formatter idempotence"))
  (for-of mode (array "default" "stripped")
    (ensure (= (read-text (template "logs/" name "-run-" mode "/stdout.raw"))
      (read-text (template "logs/" name "-formatted-run-" mode "/stdout.raw"))) (template name " formatted runtime " mode))
    (ensure (= (read-text (template "case/target/" name "-" mode ".js"))
      (read-text (template "case/target/" name "-formatted-" mode ".js"))) (template name " formatted native emitted " mode)))
  (ensure (= (read-text (template "logs/" name "-public-run/stdout.raw"))
    (read-text (template "logs/" name "-formatted-public-run/stdout.raw"))) (template name " formatted public behavior"))
  (ensure (= (read-text (template "public/target/" name "-public.js"))
    (read-text (template "public/target/" name "-formatted-public.js"))) (template name " formatted public emitted")))
(console:log "all 3 specimens formatter-idempotent, emitted-byte stable and runtime stable")

(func check-controls :args (:string cell :boolean stripped :boolean public-path) :returns :void :body
  (bind got (observations cell 12))
  (bind expected
    (array
      (array "T01-valid-scalar" (obj :tag "ControlNumber" :value 3))
      (array "T02-zero-field" (obj :tag "ControlNull"))
      (array "T03-wrong-scalar" (? stripped (obj :tag "ControlNumber" :value "wrong")
        (obj :thrown "TypeError" :message "ControlNumber: field 'value' expected number, got string")))
      (array "T04-wrong-outer-array" (? stripped (obj :tag "ControlArray" :values "wrong")
        (obj :thrown "TypeError" :message "ControlArray: field 'values' expected array, got string")))
      (array "T05-wrong-nested-array-member" (obj :tag "ControlArray" :values (array "bad")))
      (array "T06-unrelated-tag" (obj :tag "OtherTag" :id 9))
      (array "T07-missing-tag" (? stripped (obj :value 1)
        (obj :thrown "TypeError" :message "expectControl: arg 'value' expected ControlJson, got object")))
      (array "T08-forged-known-tag-match" "wrong")
      (array "T09-omitted-arm" (obj :thrown "Error" :message "match: no matching pattern"))
      (array "T10-wildcard" "wildcard")
      (array "T11-nested-positive" (obj :thrown "ReferenceError" :message (? public-path "t__gensym7 is not defined" "number is not defined")))
      (array "T12-nested-negative" (obj :thrown "ReferenceError" :message (? public-path "t__gensym7 is not defined" "number is not defined")))))
  (for-of pair expected (equal-value (got:get (get pair 0)) (get pair 1) (get pair 0)))
  (ensure (= (read-text (template "logs/" cell "/stderr.raw")) "") (template cell " uncaught stderr"))
  (console:log cell "12/12 characterized observations; nested 2/12 remain implementation failures"))
(for-of spelling (array "" "-formatted")
  (check-controls (template "controls" spelling "-run-default") false false)
  (check-controls (template "controls" spelling "-run-stripped") true false)
  (check-controls (template "controls" spelling "-public-run") false true))

(for-of name (array "decoder" "controls" "zero-field-control")
  (for-of suffix (array "-run-default" "-run-stripped" "-public-run" "-formatted-run-default" "-formatted-run-stripped" "-formatted-public-run")
    (ensure (= (read-text (template "logs/" name suffix "/exit-status.txt")) "0\n") (template name suffix " command failed"))
    (ensure (= (read-text (template "logs/" name suffix "/stderr.raw")) "") (template name suffix " stderr"))))
(console:log "all 18 raw/formatted runtime commands exit 0; no uncaught stderr")
