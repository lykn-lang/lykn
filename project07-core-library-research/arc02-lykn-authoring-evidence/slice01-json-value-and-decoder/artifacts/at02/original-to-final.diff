+(func
+  nested-key
+  :args
+  (:any root :string key)
+  :returns
+  :any
+  :body
+  (match
+    root
+    ((JObject outer)
+      (match
+        (lookup outer "nested")
+        ((None) None)
+        ((Some inner)
+          (match inner ((JObject entries) (lookup entries key)) (_ None)))))
+    (_ None)))
+
+(func
+  replace-entry
+  :args
+  (:any entry :string key :any replacement)
+  :returns
+  :any
+  :body
+  (match
+    entry
+    ((Entry found-key old-value)
+      (if (= found-key key) (return (Entry found-key replacement)))
+      (Entry found-key old-value))))
+
+(func
+  replace-key
+  :args
+  (:any value :string key :any replacement)
+  :returns
+  :any
+  :body
+  (match
+    value
+    ((JObject entries)
+      (JObject
+        (entries:map (fn (:any entry) (replace-entry entry key replacement)))))
+    (_ value)))
+
+(func
+  edit-nested-prototype-key
+  :args
+  (:any root :any replacement)
+  :returns
+  :any
+  :body
+  (match
+    root
+    ((JObject outer)
+      (match
+        (lookup outer "nested")
+        ((Some inner)
+          (match
+            inner
+            ((JObject inner-entries)
+              (replace-key
+                root
+                "nested"
+                (replace-key inner "__proto__" replacement)))
+            (_ root)))
+        ((None) root)))
+    (_ root)))
