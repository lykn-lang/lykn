(bind trace (array))
(func plus-ten :args (:any n) :returns :any :body (+ n 10))
(match plus-ten
  (match :when (do (trace:push (match 1)) false)
    (trace:push "wrong"))
  (_
    (match 2
      (1 (trace:push "wrong-inner"))
      (_ (trace:push 22)))))
(do
  (bind match (fn (:any a :any b) (+ a b)))
  (trace:push (match 3 (plus-ten 1))))
(console:log (JSON:stringify trace))
