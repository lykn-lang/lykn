(import "lang/compiler.js" (compile))
(bind cli "/Users/oubiwann/lab/lykn/lang/.worktrees/contract-predicate-lowering/target/release/lykn")
(bind home (Deno:cwd))
(bind decoder (new TextDecoder))
(func demand :args (:boolean condition :string message) :body
  (if (not condition) (throw (new Error message)) null))
(func capture :args (:string label :string cwd :string program :any args) :body
  (bind stem (+ home "/receipts/" label))
  (Deno:writeTextFileSync (+ stem ".command.json") (JSON:stringify (obj :program program :args args :cwd cwd :env (obj :DENO_DIR (Deno:env:get "DENO_DIR") :XDG_CACHE_HOME (Deno:env:get "XDG_CACHE_HOME") :NPM_CONFIG_CACHE (Deno:env:get "NPM_CONFIG_CACHE") :TMPDIR (Deno:env:get "TMPDIR"))) null 2))
  (bind command (new Deno:Command program (obj :args args :cwd cwd :stdout "piped" :stderr "piped")))
  (bind result (command:outputSync))
  (Deno:writeFileSync (+ stem ".stdout.txt") result:stdout)
  (Deno:writeFileSync (+ stem ".stderr.txt") result:stderr)
  (Deno:writeTextFileSync (+ stem ".status.txt") (String result:code))
  result)
(func run-esm :args (:string label :string path :string expected) :body
  (bind result (capture label home (Deno:execPath) (array "run" "--no-config" "--no-prompt" "--cached-only" path)))
  (demand (and (= result:code 0) (= result:stderr:length 0) (= (decoder:decode result:stdout) expected)) (+ label " runtime mismatch")))
(func unit-routes :args (:string stem :string field :string other :string expected) :body
  (bind source (+ home "/fixtures/" stem ".lykn"))
  (for-of mode (array "checked" "stripped")
    (bind label (+ stem "-" mode))
    (bind path (+ home "/runtime/" label ".mjs"))
    (bind args (array "compile" source "-o" path))
    (if (= mode "stripped") (args:push "--strip-assertions"))
    (bind result (capture (+ label "-compile") home cli args))
    (demand (= result:code 0) (+ label (decoder:decode result:stderr)))
    (bind js (Deno:readTextFileSync path))
    (bind dts (Deno:readTextFileSync (+ home "/runtime/" label ".d.ts")))
    (demand (and (js:includes field) (not (js:includes other)) (dts:includes field) (not (dts:includes other))) (+ label " paired metadata mismatch"))
    (run-esm (+ label "-run") path expected))
  (bind json-result (capture (+ stem "-json") home cli (array "compile" source "--kernel-json")))
  (demand (= json-result:code 0) (+ stem " JSON compile failed"))
  (Deno:writeFileSync (+ home "/runtime/" stem ".kernel.json") json-result:stdout)
  (bind forms (JSON:parse (decoder:decode json-result:stdout)))
  (bind js-path (+ home "/runtime/" stem "-json-public.mjs"))
  (Deno:writeTextFileSync js-path (compile forms))
  (run-esm (+ stem "-json-run") js-path expected)
  (console:log stem "JS/stripped/JSON/DTS pass"))
(unit-routes "unit-a" "left" "right" "3\n")
(unit-routes "unit-b" "right" "left" "three\n")
(bind mismatch (capture "mismatch" home cli (array "compile" (+ home "/fixtures/mismatch.lykn") "-o" (+ home "/runtime/mismatch.mjs"))))
(bind error-text (decoder:decode mismatch:stderr))
(demand (and (= mismatch:code 1) (error-text:includes "age") (error-text:includes "suggestion: change the type annotation") (not (error-text:includes "warning:"))) "analysis failure adapter mismatch")
(bind recovered (capture "recovery" home cli (array "compile" (+ home "/fixtures/unit-a.lykn") "-o" (+ home "/runtime/recovery.mjs"))))
(demand (= recovered:code 0) "CLI recovery failed")
(run-esm "recovery-run" (+ home "/runtime/recovery.mjs") "3\n")
(bind warnings (capture "compile-warnings" home cli (array "compile" (+ home "/fixtures/warnings.lykn") "-o" (+ home "/runtime/warnings.mjs"))))
(bind warning-text (decoder:decode warnings:stderr))
(demand (and (= warnings:code 0) (warning-text:includes "unused binding 'unused'") (warning-text:includes ".d.ts will use")) "compile warning adapter mismatch")
(bind dist (capture "dist-warnings" "/private/tmp/lykn-b2b1-cdc/dist-warning" cli (array "dist")))
(bind dist-text (decoder:decode dist:stderr))
(demand (and (= dist:code 0) (not (dist-text:includes "unused binding 'unused'")) (dist-text:includes ".d.ts will use")) (+ "dist warning asymmetry mismatch " dist-text))
(bind dist-failure (capture "dist-analysis-failure" "/private/tmp/lykn-b2b1-cdc/dist-failure" cli (array "dist")))
(bind dist-error (decoder:decode dist-failure:stderr))
(demand (and (= dist-failure:code 1) (dist-error:includes "mod.lykn") (dist-error:includes "age") (dist-error:includes "suggestion: change the type annotation")) (+ "dist failure mismatch " dist-error))
(console:log "analysis failure/recovery/compile-dist warning asymmetry pass")
