(set-symbol! globalThis "_" 99)
(bind calls (cell 0))
(func next-seven :args () :body (reset! calls (+ calls:value 1)) 7)
(export (bind :number _ (next-seven)))
(export (bind (object (alias _ visible) _ (spread rest)) (obj :_ 3 :extra 4)))
(export (bind (array (spread (object (alias "0" nested)))) (array 17 18)))
(export (bind _value 7))
(export (bind VERSION "0.4.0"))
(console:log calls:value _)
