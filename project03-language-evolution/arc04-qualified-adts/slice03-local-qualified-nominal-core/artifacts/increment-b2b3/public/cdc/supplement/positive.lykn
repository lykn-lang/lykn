(set-symbol! globalThis "_" 99)
(bind defaults (cell 0))
(func next-default :args () :body (reset! defaults (+ defaults:value 1)) 7)
(func scalar-default :args ((default :number _ (next-default))) :body _)
(func object-default :args ((object (default :number _ (next-default)))) :body _)
(func multi-nested
  (:args ((array (default :number _ (next-default)) (rest :number tail)))
    :body (array _ tail:length))
  (:args (:string _) :body (array _ "string")))
(console:log (scalar-default 8) defaults:value (scalar-default) defaults:value)
(console:log (object-default (obj :_ 8)) defaults:value (object-default (obj)) defaults:value)
(console:log (JSON:stringify (multi-nested (array undefined 2 3))) defaults:value)
(console:log (JSON:stringify (multi-nested "text")) defaults:value)
(kernel:block (bind :number hidden (Number 7)))
(console:log (typeof hidden))
