(import "file:///Users/oubiwann/lab/lykn/lang/.worktrees/contract-predicate-lowering/packages/lang/mod.js"
  (lykn read expandExpr compileExpr))
(bind evidence "/Users/oubiwann/lab/lykn/lang/.worktrees/planning/project03-language-evolution/arc04-qualified-adts/slice03-local-qualified-nominal-core/artifacts/increment-b2b3/public/cdc/supplement/")
(bind positive (await (Deno:readTextFile (+ evidence "positive.lykn"))))
(await (Deno:writeTextFile (+ evidence "positive.mjs") (lykn positive)))
(bind exports-source (await (Deno:readTextFile (+ evidence "exports.lykn"))))
(await (Deno:writeTextFile (+ evidence "exports.mjs") (lykn exports-source)))
(bind bad-array (await (Deno:readTextFile (+ evidence "bad-array.lykn"))))
(await (Deno:writeTextFile (+ evidence "bad-array.mjs") (lykn bad-array)))
(bind bad-export (await (Deno:readTextFile (+ evidence "bad-export.lykn"))))
(await (Deno:writeTextFile (+ evidence "bad-export.mjs") (lykn bad-export)))
(bind bad-rest (await (Deno:readTextFile (+ evidence "bad-multi-rest.lykn"))))
(await (Deno:writeTextFile (+ evidence "bad-multi-rest.mjs") (lykn bad-rest)))
(bind first-fragment (expandExpr (get (read "(fn (:any _) _)") 0)))
(bind first-ast (compileExpr first-fragment))
(bind failed (cell false))
(try (lykn "(func invalid :args (:number) :body 1)")
  (catch problem (reset! failed true)))
(bind second-fragment (expandExpr (get (read "(fn (:any _) _)") 0)))
(bind second-ast (compileExpr second-fragment))
(bind first-param (get first-ast:params 0))
(console:log failed:value
  (= (JSON:stringify first-ast) (JSON:stringify second-ast))
  first-ast:type (!= first-param:name "_") first-ast:body:name)
