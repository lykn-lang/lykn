(import "/Users/oubiwann/lab/lykn/lang/.worktrees/contract-predicate-lowering/packages/lang/mod.js" (lykn))
(func expect-invalid :args (:string stem :string expected) :body
  (bind source (Deno:readTextFileSync (+ "fixtures/" stem ".lykn")))
  (try
    (bind output (lykn source))
    (Deno:writeTextFileSync (+ "runtime/public-" stem ".mjs") output)
    (throw (new Error (+ "unexpected compilation success: " stem)))
    (catch failure
      (bind message failure:message)
      (Deno:writeTextFileSync (+ "receipts/public-" stem ".diagnostic.txt") message)
      (if (not (message:includes expected)) (throw failure))
      (if (message:includes "was-expanded") (throw failure))
      (console:log stem message))))
(func expect-runtime :args (:string stem :string expected) :body
  (bind source (Deno:readTextFileSync (+ "fixtures/" stem ".lykn")))
  (bind output (lykn source))
  (bind path (+ (Deno:cwd) "/runtime/public-" stem ".mjs"))
  (Deno:writeTextFileSync path output)
  (bind args (array "run" "--no-config" "--no-prompt" "--cached-only" path))
  (Deno:writeTextFileSync (+ "receipts/public-" stem "-run.command.json") (JSON:stringify (obj :program (Deno:execPath) :args args :cwd (Deno:cwd)) null 2))
  (bind command (new Deno:Command (Deno:execPath) (obj :args args :stdout "piped" :stderr "piped")))
  (bind result (command:outputSync))
  (Deno:writeFileSync (+ "receipts/public-" stem "-run.stdout.txt") result:stdout)
  (Deno:writeFileSync (+ "receipts/public-" stem "-run.stderr.txt") result:stderr)
  (Deno:writeTextFileSync (+ "receipts/public-" stem "-run.status.txt") (String result:code))
  (bind decoder (new TextDecoder))
  (if (!== result:code 0) (throw (new Error (decoder:decode result:stderr))))
  (if (!== (decoder:decode result:stdout) expected) (throw (new Error (+ "unexpected output " stem))))
  (console:log stem "runtime-pass"))
(expect-invalid "header-order" "parameter name must be an atom")
(expect-invalid "header-registration-control" "parameter name must be an atom")
(expect-invalid "header-default-order" "(default) second element must be a name")
(expect-invalid "header-default-body-order" "(default) second element must be a name")
(expect-invalid "header-fn-order" "parameter name must be an atom")
(expect-invalid "header-genfn-order" "parameter name must be an atom")
(expect-invalid "header-lambda-order" "parameter name must be an atom")
(expect-invalid "header-later-clause-valid-overloads" "parameter name must be an atom")
(expect-invalid "genfn-missing-yields-body" "genfn: :yields requires a type keyword and body")
(expect-invalid "genfn-actual-body-binding" "forbidden as a strict-mode binding identifier")
(expect-runtime "header-valid-default-probe-quoted" "41\n")
(expect-runtime "genfn-ignored-header" "41\n")
(expect-runtime "genfn-inert-binding-payload" "41\n")
(expect-runtime "genfn-no-metadata" "[ 41 ]\n")
(expect-runtime "genfn-typed-yields" "[ 41 ]\n")
