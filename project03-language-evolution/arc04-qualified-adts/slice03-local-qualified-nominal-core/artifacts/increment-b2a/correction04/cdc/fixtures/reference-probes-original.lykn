(import "/Users/oubiwann/lab/lykn/lang/.worktrees/contract-predicate-lowering/packages/lang/compiler.js" (compile compile-expr))
(import "/Users/oubiwann/lab/lykn/lang/.worktrees/contract-predicate-lowering/packages/lang/reader.js" (read))
(import "/Users/oubiwann/lab/lykn/lang/.worktrees/contract-predicate-lowering/packages/lang/surface-helpers.js" ((alias hostReference host-reference)))
(bind home "/private/tmp/lykn-s03-a-cdc-5caf3d87")
(bind references (Object:from-entries #a(
  #a("OWN-Symbol" "Symbol") #a("OWN-SymbolFor" "SymbolFor")
  #a("OWN-ObjectFreeze" "ObjectFreeze") #a("OWN-ObjectDefineProperties" "ObjectDefineProperties")
  #a("OWN-NumberIsNaN" "NumberIsNaN") #a("OWN-ArrayIsArray" "ArrayIsArray")
  #a("OWN-Promise" "Promise") #a("OWN-TypeError" "TypeError") #a("OWN-Error" "Error"))))
(func replace-node :args (:any node) :returns :any :body
  (if (and (= node:type "atom") (Object:has-own references node:value))
    (return (host-reference (get references node:value))))
  (if (= node:type "list")
    (return (assoc node :values (node:values:map replace-node))))
  (if (= node:type "cons")
    (return (assoc node :car (replace-node node:car) :cdr (replace-node node:cdr))))
  node)
(bind values-source "(array (OWN-Symbol \"local\") (OWN-SymbolFor \"lykn.s03.a.review\") (OWN-ObjectFreeze (object (field 7))) (OWN-ObjectDefineProperties (object) (object (field (object (value 8) (enumerable true))))) (OWN-NumberIsNaN NaN) (OWN-ArrayIsArray (array 1)) (new OWN-Promise (=> (resolve) (resolve 9))) (new OWN-TypeError \"typed\") (new OWN-Error \"error\"))")
(bind roots "Symbol Object Number Array Promise TypeError Error")
(bind shadow "(const Symbol 0) (const Object 0) (const Number 0) (const Array 0) (const Promise 0) (const TypeError 0) (const Error 0)")
(bind scenarios #a(
  (obj :name "unshadowed" :source (+ "\"use strict\" (const observed " values-source ") (export (names observed))"))
  (obj :name "module-shadowed" :source (+ "\"use strict\" " shadow " (const observed " values-source ") (export (names observed))"))
  (obj :name "parameter-shadowed" :source (+ "\"use strict\" (function run (" roots ") (return " values-source ")) (const observed (run 0 0 0 0 0 0 0)) (export (names observed))"))))
(bind results #a())
(for-of scenario scenarios
  (bind parsed (read scenario:source))
  (bind forms (parsed:map replace-node))
  (bind generated (compile forms))
  (bind path (+ home "/" scenario:name ".js"))
  (Deno:write-text-file-sync path generated)
  (bind module (await (dynamic-import (+ "file://" path))))
  (bind values module:observed)
  (bind checks #a(
    (= (js:typeof (get values 0)) "symbol")
    (= (get values 1) (Symbol:for "lykn.s03.a.review"))
    (and (Object:is-frozen (get values 2)) (= (get (get values 2) "field") 7))
    (= (get (Object:get-own-property-descriptor (get values 3) "field") "value") 8)
    (= (get values 4) true) (= (get values 5) true)
    (and (instanceof (get values 6) Promise) (= (await (get values 6)) 9))
    (and (instanceof (get values 7) TypeError) (= (get (get values 7) "message") "typed"))
    (and (instanceof (get values 8) Error) (= (get (get values 8) "message") "error"))))
  (results:push (obj :name scenario:name :checks checks))
  (if (not (checks:every (fn (:any value) value)))
    (throw (new Error (+ "reference runtime mismatch: " scenario:name)))))
(bind fragments #a("OWN-Symbol" "(OWN-Symbol \"x\")" "(new OWN-TypeError \"failure\")"))
(for-of source fragments
  (bind node (replace-node (get (read source) 0)))
  (try
    (compile-expr node)
    (results:push (obj :fragment source :rejected false))
    (catch problem (results:push (obj :fragment source :rejected true :message problem:message)))))
(bind repeated (host-reference "SymbolFor"))
(try
  (bind generated (compile #a((obj :type "list" :values #a(repeated (obj :type "string" :value "a"))) (obj :type "list" :values #a(repeated (obj :type "string" :value "b"))))))
  (results:push (obj :shared-reference-node "compiled" :output generated))
  (catch problem (results:push (obj :shared-reference-node "rejected" :message problem:message))))
(Deno:write-text-file-sync (+ home "/reference-results.json") (JSON:stringify results null 2))
(console:log (JSON:stringify results null 2))
