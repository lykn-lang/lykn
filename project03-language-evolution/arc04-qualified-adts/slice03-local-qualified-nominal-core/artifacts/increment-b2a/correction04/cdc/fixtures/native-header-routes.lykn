(bind cli "/Users/oubiwann/lab/lykn/lang/.worktrees/contract-predicate-lowering/target/release/lykn")
(bind decoder (new TextDecoder))
(func reject-routes :args (:string stem :string expected) :body
  (bind source (+ (Deno:cwd) "/fixtures/" stem ".lykn"))
  (for-of mode (array "checked" "stripped" "check")
    (bind label (+ stem "-native-" mode))
    (bind path (+ (Deno:cwd) "/runtime/" label ".mjs"))
    (bind args (if (=== mode "check") (array "check" source) (array "compile" source "-o" path)))
    (if (=== mode "stripped") (args:push "--strip-assertions"))
    (Deno:writeTextFileSync (+ "receipts/" label ".command.json") (JSON:stringify (obj :program cli :args args :cwd (Deno:cwd)) null 2))
    (bind command (new Deno:Command cli (obj :args args :stdout "piped" :stderr "piped")))
    (bind result (command:outputSync))
    (Deno:writeFileSync (+ "receipts/" label ".stdout.txt") result:stdout)
    (Deno:writeFileSync (+ "receipts/" label ".stderr.txt") result:stderr)
    (Deno:writeTextFileSync (+ "receipts/" label ".status.txt") (String result:code))
    (bind message (decoder:decode result:stderr))
    (if (!== result:code 1) (throw (new Error (+ "unexpected status " label))))
    (if (not (message:includes expected)) (throw (new Error (+ label message))))
    (if (message:includes "was-expanded") (throw (new Error (+ "probe executed " label))))
    (if (!== result:stdout:length 0) (throw (new Error (+ "unexpected stdout " label)))))
  (console:log stem "three diagnostic routes pass"))
(reject-routes "header-order" "parameter name must be an atom")
(reject-routes "header-registration-control" "parameter name must be an atom")
(reject-routes "header-default-order" "(default) expected :type name value")
(reject-routes "header-fn-order" "parameter name must be an atom")
(reject-routes "header-genfn-order" "parameter name must be an atom")
(reject-routes "header-lambda-order" "parameter name must be an atom")
(reject-routes "header-later-clause-valid-overloads" "parameter name must be an atom")
(reject-routes "genfn-missing-yields-body" "genfn: :yields requires a type keyword and body")
