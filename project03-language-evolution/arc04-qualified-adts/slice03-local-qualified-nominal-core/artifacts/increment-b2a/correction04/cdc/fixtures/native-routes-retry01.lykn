(bind cli "/Users/oubiwann/lab/lykn/lang/.worktrees/contract-predicate-lowering/target/release/lykn")
(bind decoder (new TextDecoder))
(func capture :args (:string label :string program :any args) :body
  (bind stem (+ "receipts/" label))
  (Deno:writeTextFileSync (+ stem ".command.json") (JSON:stringify (obj :program program :args args :cwd (Deno:cwd) :environment (obj :DENO_DIR (Deno:env:get "DENO_DIR") :XDG_CACHE_HOME (Deno:env:get "XDG_CACHE_HOME") :NPM_CONFIG_CACHE (Deno:env:get "NPM_CONFIG_CACHE") :TMPDIR (Deno:env:get "TMPDIR"))) null 2))
  (bind command (new Deno:Command program (obj :args args :stdout "piped" :stderr "piped")))
  (bind result (command:outputSync))
  (Deno:writeFileSync (+ stem ".stdout.txt") result:stdout)
  (Deno:writeFileSync (+ stem ".stderr.txt") result:stderr)
  (Deno:writeTextFileSync (+ stem ".status.txt") (String result:code))
  (if (!== result:code 0) (throw (new Error (+ label " " (decoder:decode result:stderr)))))
  result)
(func runtime-routes :args (:string stem :string expected) :body
  (bind source (+ (Deno:cwd) "/fixtures/" stem ".lykn"))
  (for-of mode (array "checked" "stripped")
    (bind label (+ stem "-" mode))
    (bind output (+ (Deno:cwd) "/runtime/" label ".mjs"))
    (bind args (array "compile" source "-o" output))
    (if (=== mode "stripped") (args:push "--strip-assertions"))
    (capture (+ label "-compile") cli args)
    (bind result (capture (+ label "-run") (Deno:execPath) (array "run" "--no-config" "--no-prompt" "--cached-only" output)))
    (bind text (decoder:decode result:stdout))
    (if (!== text expected) (throw (new Error (+ label " unexpected stdout " text))))
    (if (!== result:stderr:length 0) (throw (new Error (+ label " unexpected runtime stderr")))))
  (capture (+ stem "-check") cli (array "check" source))
  (console:log stem "checked/stripped/runtime/check pass"))
(runtime-routes "native-member-wrappers-retry01" "40\n7\n42\n42\n41\n43\n[1,2]\n")
(runtime-routes "genfn-protected-string-metadata" "41\n")
(runtime-routes "genfunc-protected-post" "[ 41 ]\n")
