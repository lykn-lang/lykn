(import "browser/compiler.js" (compile-lykn))
(bind decoder (new TextDecoder))
(func run-browser :args (:string stem :string expected) :body
  (bind generated (compile-lykn (Deno:readTextFileSync (+ "fixtures/" stem ".lykn"))))
  (bind path (+ (Deno:cwd) "/runtime/browser-materialized-" stem ".mjs"))
  (Deno:writeTextFileSync path generated)
  (bind args (array "run" "--no-config" "--no-prompt" "--cached-only" path))
  (Deno:writeTextFileSync (+ "receipts/browser-" stem ".command.json") (JSON:stringify (obj :program (Deno:execPath) :args args :cwd (Deno:cwd)) null 2))
  (bind command (new Deno:Command (Deno:execPath) (obj :args args :stdout "piped" :stderr "piped")))
  (bind result (command:outputSync))
  (Deno:writeFileSync (+ "receipts/browser-" stem ".stdout.txt") result:stdout)
  (Deno:writeFileSync (+ "receipts/browser-" stem ".stderr.txt") result:stderr)
  (Deno:writeTextFileSync (+ "receipts/browser-" stem ".status.txt") (String result:code))
  (if (not (and (= result:code 0) (= result:stderr:length 0) (= (decoder:decode result:stdout) expected))) (throw (new Error (+ "browser mismatch " stem))))
  (console:log stem "browser-compile/ESM pass"))
(run-browser "browser-owned" "[[\"TypeError\",\"checkNumber: arg 'value' expected number, got string\"],[\"TypeError\",\"checkArray: arg 'value' expected array, got number\"],[\"Error\",\"match: no matching pattern\"]]\n")
(run-browser "genfn-protected-string-metadata" "41\n")
(run-browser "genfunc-protected-post" "[ 41 ]\n")
