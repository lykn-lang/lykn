(class Base ())
(class Members (Base)
  (constructor ((default initial 40)) (super) (assign this:initial initial))
  (shadow (bind) (return (bind 7)))
  (get answer () (bind total (+ 20 22)) (return total))
  (set supplied (value) (assign this:initial value))
  (async (later ((default amount 41)) (return amount)))
  (static (static-value ((default amount 43)) (return amount)))
  (field values (array 1 2)))
(bind item (new Members))
(console:log item:initial)
(console:log (item:shadow (fn (:number value) value)))
(console:log item:answer)
(set! item:supplied 42)
(console:log item:initial)
(console:log (await (item:later)))
(console:log (Members:static-value))
(console:log (JSON:stringify item:values))
