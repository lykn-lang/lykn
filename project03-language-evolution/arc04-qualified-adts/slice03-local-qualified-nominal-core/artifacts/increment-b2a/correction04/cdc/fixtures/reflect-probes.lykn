(import "lang/reader.js" (read))
(import "lang/compiler.js" (compile compile-expr))
(import "lang/host-invocation.js" (compile-with-host-invocations host-invocation-request new-host-invocation-id))
(bind home (get Deno:args 0))
(bind decoder (new TextDecoder))
(func anchor-in :args (:any node) :body
  (if (!= node:type "list") (return null))
  (if (and (= node:values:length 3) (= (get (get node:values 0) :value) "saved")) (return node))
  (for-of child node:values
    (bind found (anchor-in child))
    (if found (return found)))
  null)
(func expect-error :args (:string label :any action :string expected) :body
  (try
    (action)
    (throw (new Error (+ "unexpected success " label)))
    (catch failure
      (Deno:writeTextFileSync (+ home "/" label ".diagnostic.txt") failure:message)
      (if (not (failure:message:includes expected)) (throw failure))
      true)))
(for-of scenario (array "global" "shadowed")
  (bind prefix (if (= scenario "shadowed") "(const Reflect 0) " ""))
  (bind forms (read (+ prefix "(function saved (value) (return (+ this:base value))) (const receiver (object (base 40))) (const argv (array 1)) (console:log (saved receiver argv))")))
  (bind anchor (forms:map anchor-in))
  (bind selected (anchor:find (fn (:any value) value)))
  (bind request (host-invocation-request (new-host-invocation-id) selected))
  (bind generated (compile-with-host-invocations forms compile (array request)))
  (bind path (+ home "/reflect-" scenario ".mjs"))
  (Deno:writeTextFileSync path generated)
  (bind args (array "run" "--no-config" "--no-prompt" "--cached-only" path))
  (Deno:writeTextFileSync (+ home "/reflect-" scenario ".command.json") (JSON:stringify (obj :program (Deno:execPath) :args args :cwd (Deno:cwd)) null 2))
  (bind command (new Deno:Command (Deno:execPath) (obj :args args :stdout "piped" :stderr "piped")))
  (bind result (command:outputSync))
  (Deno:writeFileSync (+ home "/reflect-" scenario ".stdout.txt") result:stdout)
  (Deno:writeFileSync (+ home "/reflect-" scenario ".stderr.txt") result:stderr)
  (Deno:writeTextFileSync (+ home "/reflect-" scenario ".status.txt") (String result:code))
  (if (not (and (= result:code 0) (= (decoder:decode result:stdout) "41\n") (= result:stderr:length 0))) (throw (new Error (+ "Reflect runtime mismatch " scenario)))))
(bind forms (read "(saved receiver argv)"))
(bind request (host-invocation-request (new-host-invocation-id) (get forms 0)))
(expect-error "fragment" (fn () (compile-with-host-invocations forms (fn (:any items) (compile-expr (get items 0))) (array request))) "complete finalization")
(if (!= (compile forms) "saved(receiver, argv);\n") (throw (new Error "Reflect recovery mismatch")))
(bind other (get (read "(other receiver argv)") 0))
(bind orphan (host-invocation-request (new-host-invocation-id) other))
(expect-error "orphan" (fn () (compile-with-host-invocations forms compile (array orphan))) "orphaned")
(console:log "Reflect2 runtime/fragment/orphan/recovery pass")
