   write: false,
 };
 
@@ -50,6 +62,26 @@ const rawBytes = rawResult.outputFiles[0].contents;
 const minResult = await esbuild.build({ ...shared, minify: true });
 const minBytes = minResult.outputFiles[0].contents;
 
+if (Deno.env.get("VERIFY_CLI_BUNDLE") === "1") {
+  const cliBytes = await Deno.readFile("dist/lykn-browser.js");
+  const identical = cliBytes.length === minBytes.length &&
