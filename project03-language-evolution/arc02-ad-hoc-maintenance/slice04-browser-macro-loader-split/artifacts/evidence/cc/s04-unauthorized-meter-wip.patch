@@ -26,6 +26,17 @@ const lyknImportPlugin = {
   name: "lykn-import-map",
   setup(build) {
     build.onResolve({ filter: /^lang\// }, (args) => {
+      if (args.path === "lang/expander.js" &&
+          args.importer === Deno.cwd() + "/packages/browser/compiler.js") {
