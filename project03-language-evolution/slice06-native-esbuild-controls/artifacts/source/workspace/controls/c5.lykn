(import "@probe/json" ((alias parse-value jsonRoot)))
(import "@probe/json/value" ((alias parse-value jsonValue)))
(import "@probe/json/file" ((alias read-text fileRoot)))
(import "@probe/json/file" ((alias read-text fileValue)))
(import "@probe/json/document" ((alias document-label documentRoot)))
(import "@probe/json/document" ((alias document-label documentValue)))
(import "@probe/yaml" ((alias parse-yaml-fixture yamlRoot)))
(import "@probe/yaml/value" ((alias parse-yaml-fixture yamlValue)))
(import "@probe/effects" ((alias used usedRoot) (alias unused-pure deadRoot)))
(import "@probe/effects/used" ((alias used usedValue)))
(import "@probe/effects/dead" ((alias unused-pure deadValue)))

(bind raw (fileRoot (get Deno:args 0)))
(bind object (obj
  :jsonRoot (jsonRoot raw)
  :jsonValue (jsonValue raw)
  :fileRoot raw
  :fileValue (fileValue (get Deno:args 0))
  :documentRoot (documentRoot raw)
  :documentValue (documentValue raw)
  :yamlRoot (yamlRoot "answer: 42")
  :yamlValue (yamlValue "answer: 42")
  :usedRoot (usedRoot 41)
  :usedValue (usedValue 41)
  :deadRoot (deadRoot 41)
  :deadValue (deadValue 41)))
(console:log (JSON:stringify object))
