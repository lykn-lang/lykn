(set! globalThis:_ 99)
(bind metrics (obj :steps 0 :values 0 :closes 0 :field 0 :extra 0))
(class Step ()
  (constructor (current) (assign this:done false) (assign this:current current))
  (get value ()
    (set! metrics:values (+ metrics:values 1))
    (return this:current)))
(class Cursor ()
  (next ()
    (set! metrics:steps (+ metrics:steps 1))
    (return (new Step metrics:steps)))
  (return ()
    (set! metrics:closes (+ metrics:closes 1))
    (return (obj :done true))))
(bind iterable (obj))
(set-symbol! iterable Symbol:iterator (kernel:=> () (new Cursor)))
(kernel:for-of (array _ second) (array iterable)
  (console:log "hole" _ second metrics:steps metrics:values metrics:closes))
(set! metrics:steps 0)
(set! metrics:values 0)
(set! metrics:closes 0)
(kernel:for-of (array first second) (array iterable)
  (console:log "named" first second metrics:steps metrics:values metrics:closes))
(set! metrics:steps 0)
(set! metrics:values 0)
(set! metrics:closes 0)
(try (throw iterable)
  (catch (array _ other)
    (console:log "catch" _ other metrics:steps metrics:values metrics:closes)))
(bind record (obj))
(Object:defineProperty record "value"
  (obj :enumerable true :get (kernel:=> () (block
    (set! metrics:field (+ metrics:field 1)) (return 3)))))
(Object:defineProperty record "extra"
  (obj :enumerable true :get (kernel:=> () (block
    (set! metrics:extra (+ metrics:extra 1)) (return 4)))))
(bind (object (alias :value _) (spread _)) record (array) (array))
(console:log "spread" _ metrics:field metrics:extra)
(set! globalThis:completionValue__gensym0 (obj :probe 41))
(bind events (array))
(kernel:function bump (value) (events:push value) (return value))
(kernel:function pick (_ _value)
  (return (array _ _value completionValue__gensym0:probe)))
(bind picked (pick (bump 1) (bump 7)))
(console:log "call" (get picked 0) (get picked 1) (get picked 2) pick:length (events:join ","))
(kernel:function* later (_) (bump "advance") (yield _))
(bind cursor (later (bump "argument")))
(console:log "before" (events:join ","))
(bind step (cursor:next))
(console:log "after" step:value (events:join ","))
