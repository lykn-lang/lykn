(import {load-parser verify-parser} from "./parser-core.js")

(bind argv Deno.args)

(if
  (!= argv:length 3)
  (do
    (console:log
      (JSON:stringify
        (obj :status "probe_usage_error" :expectedArgs 3 :actualArgs argv:length)))
    (Deno.exit 2)))

(bind control-id (get argv 0))
(bind expected-hash (get argv 1))
(bind input-path (get argv 2))

(bind parser-check (await (load-parser expected-hash)))

(if
  (!= parser-check:status "ready")
  (do
    (console:log (JSON:stringify parser-check))
    (Deno.exit 2)))

(bind input-text (await (Deno:readTextFile input-path)))

(bind parsed
  (try
    (obj
      :status "parse_success"
      :controlId control-id
      :actualHash parser-check:actualHash
      :actualVersion parser-check:actualVersion
      :program
      (parser-check:parser:parse
        input-text
        (obj
          :ecmaVersion "latest"
          :sourceType "module"
          :locations true
          :ranges true)))
    (catch
      error
      (obj
        :status "parse_error"
        :controlId control-id
        :actualHash parser-check:actualHash
        :actualVersion parser-check:actualVersion
          :errorName error:name
        :message error:message
        :pos error:pos
        :line error:loc:line
        :column error:loc:column))))

(bind after-hash (await (verify-parser parser-check:actualHash)))

(if
  (!= after-hash parser-check:actualHash)
  (do
    (console:log
      (JSON:stringify
        (obj
          :status "parser_artifact_changed_after_use"
          :beforeHash parser-check:actualHash
          :afterHash after-hash)))
    (Deno.exit 2)))

(console:log
  (JSON:stringify
    (assoc parsed :afterHash after-hash)))

(if (= parsed:status "parse_error") (Deno.exit 2))
